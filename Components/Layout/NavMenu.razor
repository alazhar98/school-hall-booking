@using SchoolHallBooking.Services
@using SchoolHallBooking.Models
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> حجز القاعة
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> الإدارة
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="teachers-leave">
                <span class="bi bi-file-earmark-text" aria-hidden="true"></span> استمارة استئذان (عام)
            </NavLink>
        </div>

        <!-- School Management Section -->
        <div class="nav-item px-3">
            @if (isAuthenticated)
            {
                <div class="nav-item">
                    <button class="nav-link btn btn-link text-start w-100 p-0" @onclick="ToggleSchoolMenu">
                        <span class="bi bi-building-fill-nav-menu" aria-hidden="true"></span> 
                        إدارة المدرسة
                        <span class="bi @(schoolMenuExpanded ? "bi-chevron-up" : "bi-chevron-down") float-end"></span>
                    </button>
                    @if (schoolMenuExpanded)
                    {
                        <div class="nav-submenu ps-4">
                            <NavLink class="nav-link" href="school">
                                <span class="bi bi-house" aria-hidden="true"></span> لوحة التحكم
                            </NavLink>
                            
                            <!-- All School Management Pages -->
                            <NavLink class="nav-link" href="stats">
                                <span class="bi bi-graph-up" aria-hidden="true"></span> الإحصائية العامة
                            </NavLink>
                            <NavLink class="nav-link" href="duty-schedule">
                                <span class="bi bi-calendar-week" aria-hidden="true"></span> جدول المناوبة
                            </NavLink>
                            <NavLink class="nav-link" href="activity-supervisors">
                                <span class="bi bi-people-fill" aria-hidden="true"></span> مشرفو الأنشطة
                            </NavLink>
                            <NavLink class="nav-link" href="class-leaders">
                                <span class="bi bi-person-badge" aria-hidden="true"></span> رواد الفصول
                            </NavLink>
                            <NavLink class="nav-link" href="daily-plan">
                                <span class="bi bi-calendar-day" aria-hidden="true"></span> الخطة اليومية
                            </NavLink>
                            <NavLink class="nav-link" href="school-plan-followup">
                                <span class="bi bi-clipboard-check" aria-hidden="true"></span> متابعة الخطة المدرسية
                            </NavLink>
                            <NavLink class="nav-link" href="supervisory-visits">
                                <span class="bi bi-eye" aria-hidden="true"></span> الزيارات الإشرافية
                            </NavLink>
                            <NavLink class="nav-link" href="professional-development">
                                <span class="bi bi-mortarboard" aria-hidden="true"></span> برامج الإنماء المهني
                            </NavLink>
                            <NavLink class="nav-link" href="academic-achievement">
                                <span class="bi bi-trophy" aria-hidden="true"></span> برامج التحصيل الدراسي
                            </NavLink>
                            <NavLink class="nav-link" href="school-performance-development">
                                <span class="bi bi-graph-up-arrow" aria-hidden="true"></span> نظام تطوير الأداء المدرسي
                            </NavLink>
                            <NavLink class="nav-link" href="behavior-discipline">
                                <span class="bi bi-shield-check" aria-hidden="true"></span> الانضباط السلوكي
                            </NavLink>
                            <NavLink class="nav-link" href="final-exams">
                                <span class="bi bi-journal-text" aria-hidden="true"></span> الامتحانات النهائية
                            </NavLink>
                            <NavLink class="nav-link" href="teachers-attendance">
                                <span class="bi bi-clock-history" aria-hidden="true"></span> حضور وانصراف الهيئة التعليمية
                            </NavLink>
                            <NavLink class="nav-link" href="followup-records">
                                <span class="bi bi-journal-bookmark" aria-hidden="true"></span> سجلات المتابعة
                            </NavLink>
                        </div>
                    }
                </div>
            }
            else
            {
                <NavLink class="nav-link" href="school/login">
                    <span class="bi bi-building-fill-nav-menu" aria-hidden="true"></span> إدارة المدرسة
                </NavLink>
            }
        </div>
    </nav>
</div>

@code {
    private bool isAuthenticated = false;
    private bool schoolMenuExpanded = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking authentication: {ex.Message}");
        }
    }

    private void ToggleSchoolMenu()
    {
        schoolMenuExpanded = !schoolMenuExpanded;
    }
}

<style>
    .nav-submenu {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 0.375rem;
        margin: 0.25rem 0;
    }
    
    .nav-submenu .nav-link {
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
    }
    
    .nav-submenu .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.2);
    }
    
    .nav-divider {
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        margin: 0.5rem 0;
    }
    
    .nav-submenu-header {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>
