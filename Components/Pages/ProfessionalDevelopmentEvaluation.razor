@page "/professional-development/evaluation"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@inject IProfessionalDevelopmentService ProfessionalDevelopmentService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>استمارة تقييم ختامي لبرنامج تدريبي</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">استمارة تقييم ختامي لبرنامج تدريبي</h2>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="@(() => OpenAddModal())">
                <i class="bi bi-plus"></i> إضافة تقييم جديد
            </button>
            <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/professional-development"))">
                <i class="bi bi-arrow-right"></i> الرجوع
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
        </div>
    }

    <!-- Evaluations Table -->
    <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">استمارات التقييم الختامي</h5>
            <div>
                <button class="btn btn-light btn-sm me-2" @onclick="@(() => ExportToExcel())">
                    <i class="bi bi-file-excel"></i> Excel
                </button>
                <button class="btn btn-light btn-sm" @onclick="@(() => ExportToPDF())">
                    <i class="bi bi-file-pdf"></i> PDF
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (evaluations.Any())
            {
                <div class="table-responsive">
                    <table id="evaluations-table" class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>عنوان البرنامج</th>
                                <th>المادة</th>
                                <th>تاريخ الإنشاء</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evaluation in evaluations)
                            {
                                <tr>
                                    <td>@evaluation.ProgramTitle</td>
                                    <td>@evaluation.Subject</td>
                                    <td>@evaluation.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <button class="btn btn-warning btn-sm" @onclick="@(() => OpenEditModal(evaluation))" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm" @onclick="@(() => DeleteEvaluation(evaluation.Id))" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <button class="btn btn-info btn-sm" @onclick="@(() => PrintEvaluation(evaluation))" title="طباعة">
                                            <i class="bi bi-printer"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted">لا توجد استمارات تقييم مسجلة</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade @(showModal ? "show d-block" : "")" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">@(currentEvaluation.Id == 0 ? "إضافة تقييم جديد" : "تعديل التقييم")</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="@(() => CloseModal())"></button>
            </div>
            <EditForm Model="@currentEvaluation" OnValidSubmit="SaveEvaluation" FormName="evaluationForm">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="programTitle" class="form-label">عنوان البرنامج *</label>
                            <InputText id="programTitle" class="form-control" @bind-Value="currentEvaluation.ProgramTitle" />
                            <ValidationMessage For="@(() => currentEvaluation.ProgramTitle)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="subject" class="form-label">المادة *</label>
                            <InputText id="subject" class="form-control" @bind-Value="currentEvaluation.Subject" />
                            <ValidationMessage For="@(() => currentEvaluation.Subject)" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="@(() => CloseModal())">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private List<FinalEvaluation> evaluations = new();
    private FinalEvaluation currentEvaluation = new();
    private bool showModal = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEvaluations();
    }

    private async Task LoadEvaluations()
    {
        try
        {
            evaluations = await ProfessionalDevelopmentService.GetAllEvaluationsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تحميل التقييمات: {ex.Message}";
        }
    }

    private void OpenAddModal()
    {
        currentEvaluation = new FinalEvaluation();
        showModal = true;
        StateHasChanged();
    }

    private void OpenEditModal(FinalEvaluation evaluation)
    {
        currentEvaluation = new FinalEvaluation
        {
            Id = evaluation.Id,
            ProgramTitle = evaluation.ProgramTitle,
            Subject = evaluation.Subject
        };
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        currentEvaluation = new FinalEvaluation();
        StateHasChanged();
    }

    private async Task SaveEvaluation()
    {
        try
        {
            if (currentEvaluation.Id == 0)
            {
                await ProfessionalDevelopmentService.AddEvaluationAsync(currentEvaluation);
                successMessage = "تم إضافة التقييم بنجاح";
            }
            else
            {
                await ProfessionalDevelopmentService.UpdateEvaluationAsync(currentEvaluation);
                successMessage = "تم تحديث التقييم بنجاح";
            }

            await LoadEvaluations();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في حفظ التقييم: {ex.Message}";
        }
    }

    private async Task DeleteEvaluation(int id)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { "هل أنت متأكد من حذف هذا التقييم؟" });
            if (confirmed)
            {
                await ProfessionalDevelopmentService.DeleteEvaluationAsync(id);
                successMessage = "تم حذف التقييم بنجاح";
                await LoadEvaluations();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في حذف التقييم: {ex.Message}";
        }
    }

    private async Task PrintEvaluation(FinalEvaluation evaluation)
    {
        try
        {
            var htmlContent = GenerateEvaluationPDFContent(evaluation);
            await JSRuntime.InvokeVoidAsync("printHTML", new object[] { htmlContent, $"استمارة تقييم ختامي - {evaluation.ProgramTitle}" });
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في طباعة التقييم: {ex.Message}";
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToExcel", new object[] { "evaluations-table", "استمارات_التقييم_الختامي" });
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تصدير Excel: {ex.Message}";
        }
    }

    private async Task ExportToPDF()
    {
        try
        {
            var htmlContent = GeneratePDFContent();
            await JSRuntime.InvokeVoidAsync("printHTML", new object[] { htmlContent, "استمارات التقييم الختامي" });
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تصدير PDF: {ex.Message}";
        }
    }


    private string GeneratePDFContent()
    {
        var html = $@"
        <!DOCTYPE html>
        <html dir='rtl' lang='ar'>
        <head>
            <meta charset='utf-8'>
            <title>استمارات التقييم الختامي</title>
            <style>
                body {{ font-family: Arial, sans-serif; margin: 20px; direction: rtl; }}
                .header {{ text-align: center; margin-bottom: 30px; }}
                .header h1 {{ color: #007bff; margin-bottom: 10px; }}
                .header p {{ color: #666; }}
                table {{ width: 100%; border-collapse: collapse; margin-top: 20px; }}
                th, td {{ border: 1px solid #ddd; padding: 8px; text-align: right; }}
                th {{ background-color: #f8f9fa; font-weight: bold; }}
                .text-center {{ text-align: center; }}
                .mt-3 {{ margin-top: 15px; }}
            </style>
        </head>
        <body>
            <div class='header'>
                <h1>استمارات التقييم الختامي</h1>
                <p>تاريخ التقرير: {DateTime.Now:yyyy/MM/dd}</p>
            </div>
            
            <table>
                <thead>
                    <tr>
                        <th>عنوان البرنامج</th>
                        <th>المادة</th>
                        <th>تاريخ الإنشاء</th>
                    </tr>
                </thead>
                <tbody>";

        foreach (var evaluation in evaluations)
        {
            html += $@"
                    <tr>
                        <td>{evaluation.ProgramTitle}</td>
                        <td>{evaluation.Subject}</td>
                        <td>{evaluation.CreatedAt:yyyy/MM/dd}</td>
                    </tr>";
        }

        html += @"
                </tbody>
            </table>
        </body>
        </html>";

        return html;
    }

    private string GenerateEvaluationPDFContent(FinalEvaluation evaluation)
    {
        var html = $@"
        <!DOCTYPE html>
        <html dir='rtl' lang='ar'>
        <head>
            <meta charset='utf-8'>
            <title>استمارة تقييم ختامي لبرنامج تدريبي</title>
            <style>
                body {{ font-family: Arial, sans-serif; margin: 20px; direction: rtl; }}
                .header {{ text-align: center; margin-bottom: 30px; }}
                .header h1 {{ color: #007bff; margin-bottom: 10px; }}
                .header p {{ color: #666; }}
                .form-section {{ margin-bottom: 30px; }}
                .form-section h3 {{ color: #333; margin-bottom: 15px; }}
                .form-field {{ margin-bottom: 15px; }}
                .form-field label {{ font-weight: bold; display: block; margin-bottom: 5px; }}
                .form-field input, .form-field textarea {{ width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; }}
                .form-field textarea {{ height: 100px; resize: vertical; }}
                .checkbox-group {{ margin: 10px 0; }}
                .checkbox-group input[type='checkbox'] {{ margin-left: 10px; }}
                .signature-section {{ margin-top: 40px; }}
                .signature-line {{ border-bottom: 1px solid #333; width: 200px; display: inline-block; margin: 0 10px; }}
            </style>
        </head>
        <body>
            <div class='header'>
                <h1>استمارة تقييم ختامي لبرنامج تدريبي</h1>
                <p>عنوان البرنامج: {evaluation.ProgramTitle}</p>
                <p>المادة: {evaluation.Subject}</p>
            </div>
            
            <div class='form-section'>
                <h3>معلومات البرنامج</h3>
                <div class='form-field'>
                    <label>عنوان البرنامج:</label>
                    <input type='text' value='{evaluation.ProgramTitle}' readonly />
                </div>
                <div class='form-field'>
                    <label>المادة:</label>
                    <input type='text' value='{evaluation.Subject}' readonly />
                </div>
            </div>
            
            <div class='form-section'>
                <h3>تقييم البرنامج</h3>
                <div class='form-field'>
                    <label>تقييم المحتوى:</label>
                    <div class='checkbox-group'>
                        <input type='checkbox' id='content1' /> <label for='content1'>ممتاز</label>
                        <input type='checkbox' id='content2' /> <label for='content2'>جيد جداً</label>
                        <input type='checkbox' id='content3' /> <label for='content3'>جيد</label>
                        <input type='checkbox' id='content4' /> <label for='content4'>مقبول</label>
                        <input type='checkbox' id='content5' /> <label for='content5'>ضعيف</label>
                    </div>
                </div>
                
                <div class='form-field'>
                    <label>تقييم المدرب:</label>
                    <div class='checkbox-group'>
                        <input type='checkbox' id='trainer1' /> <label for='trainer1'>ممتاز</label>
                        <input type='checkbox' id='trainer2' /> <label for='trainer2'>جيد جداً</label>
                        <input type='checkbox' id='trainer3' /> <label for='trainer3'>جيد</label>
                        <input type='checkbox' id='trainer4' /> <label for='trainer4'>مقبول</label>
                        <input type='checkbox' id='trainer5' /> <label for='trainer5'>ضعيف</label>
                    </div>
                </div>
                
                <div class='form-field'>
                    <label>تقييم البيئة التدريبية:</label>
                    <div class='checkbox-group'>
                        <input type='checkbox' id='environment1' /> <label for='environment1'>ممتاز</label>
                        <input type='checkbox' id='environment2' /> <label for='environment2'>جيد جداً</label>
                        <input type='checkbox' id='environment3' /> <label for='environment3'>جيد</label>
                        <input type='checkbox' id='environment4' /> <label for='environment4'>مقبول</label>
                        <input type='checkbox' id='environment5' /> <label for='environment5'>ضعيف</label>
                    </div>
                </div>
            </div>
            
            <div class='form-section'>
                <h3>ملاحظات وتوصيات</h3>
                <div class='form-field'>
                    <label>الملاحظات:</label>
                    <textarea placeholder='اكتب ملاحظاتك هنا...'></textarea>
                </div>
                <div class='form-field'>
                    <label>التوصيات:</label>
                    <textarea placeholder='اكتب توصياتك هنا...'></textarea>
                </div>
            </div>
            
            <div class='signature-section'>
                <p>اسم المقيم: <span class='signature-line'></span></p>
                <p>التوقيع: <span class='signature-line'></span></p>
                <p>التاريخ: <span class='signature-line'></span></p>
            </div>
        </body>
        </html>";

        return html;
    }
}
