@page "/duty-schedule"
@using SchoolHallBooking.Services
@using SchoolHallBooking.Models
@using ClosedXML.Excel
@using System.IO
@inject IDutyScheduleService DutyScheduleService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
    </div>
}
else if (!isAuthenticated)
{
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>غير مصرح لك بالوصول</strong>
                    <br>
                    <small>يجب تسجيل الدخول أولاً للوصول إلى هذه الصفحة</small>
                    <br>
                    <a href="/school/login" class="btn btn-primary btn-sm mt-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        تسجيل الدخول
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h1 class="mb-4">جدول المناوبة الأسبوعية</h1>

    <div class="container-fluid duty-schedule-container">
    <!-- Controls -->
    <div class="row g-3 align-items-end mb-3">
        <div class="col-12 col-md-auto">
            <button class="btn btn-success w-100 w-md-auto" @onclick="SaveSchedule">
                <i class="bi bi-save me-1"></i>
                حفظ البيانات
            </button>
        </div>
        <div class="col-12 col-md-auto ms-md-auto">
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-warning flex-fill flex-md-grow-0" @onclick="ToggleEditMode">
                    <i class="bi @(isEditMode ? "bi-eye-slash" : "bi-pencil-square") me-1"></i>
                    @(isEditMode ? "إنهاء التعديل" : "تعديل الجدول العام")
                </button>
                <button class="btn btn-outline-success flex-fill flex-md-grow-0" @onclick="ExportToExcel">
                    <i class="bi bi-file-earmark-excel me-1"></i>
                    تصدير إلى Excel
                </button>
                <button class="btn btn-outline-danger flex-fill flex-md-grow-0" @onclick="ExportToPDF">
                    <i class="bi bi-file-earmark-pdf me-1"></i>
                    تصدير إلى PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Quick day switcher -->
    <div class="row mb-3">
        <div class="col">
            <div class="btn-group day-buttons" role="group" aria-label="day-switch">
                @foreach (var d in days)
                {
                    <button type="button"
                            class="btn btn-sm @(selectedDay == d ? "btn-primary" : "btn-outline-primary")"
                            @onclick="(() => { selectedDay = d; OnDayChanged(); })">
                        @d
                    </button>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(saveMessage))
    {
        <div class="alert @(saveMessage.Contains("خطأ") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @saveMessage
            <button type="button" class="btn-close" @onclick="() => saveMessage = string.Empty"></button>
        </div>
    }

    <!-- Per-day table (editable) -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <div class="d-flex align-items-center">
                <i class="bi bi-calendar3 me-2"></i>
                <h5 class="mb-0">@selectedDay</h5>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle table-sticky">
                    <thead class="table-light">
                        <tr>
                            @foreach (var c in columns)
                            {
                                <th class="text-center">@c</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var editRow in Enumerable.Range(0, 2))
                        {
                            <tr>
                                @foreach (var c in columns)
                                {
                                    <td class="align-top" style="min-width: 200px;">
                                        <textarea
                                               class="form-control"
                                               rows="2"
                                               placeholder="أدخل الأسماء مفصولة بفواصل"
                                               data-day="@selectedDay"
                                               data-column="@c"
                                               data-row="@editRow"
                                               value="@GetCell(selectedDay, c, editRow)"
                                               @oninput="@((ChangeEventArgs e) => HandleCellInputWithData(e, selectedDay, c, editRow))"
                                               @key="@($"{selectedDay}-{c}-{editRow}")"></textarea>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Weekly Overview Table -->
    <div class="card shadow-sm" id="weekly-schedule">
        <div class="card-header bg-success text-white"> 
            <div class="d-flex align-items-center">
                <i class="bi bi-calendar-week me-2"></i>
                <h5 class="mb-0">الجدول العام للأسبوع</h5>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle table-sticky">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">اليوم</th>
                            @foreach (var c in columns)
                            {
                                <th class="text-center">@c</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in days)
                        {
                            @for (int displayRow = 0; displayRow < 2; displayRow++)
                            {
                                <tr>
                                    @if (displayRow == 0)
                                    {
                                        <td class="text-center fw-bold" rowspan="2">@day</td>
                                    }
                                    @foreach (var c in columns)
                                    {
                                        <td class="align-top" style="min-width: 150px;">
                                            @if (isEditMode)
                                            {
                                                <textarea
                                                       class="form-control form-control-sm"
                                                       rows="2"
                                                       placeholder="أدخل الأسماء مفصولة بفواصل"
                                                       data-day="@day"
                                                       data-column="@c"
                                                       data-row="@displayRow"
                                                       value="@GetCell(day, c, displayRow)"
                                                       @oninput="@((ChangeEventArgs e) => HandleCellInputWithData(e, day, c, displayRow))"
                                                       @key="@($"{day}-{c}-{displayRow}")"></textarea>
                                            }
                                            else
                                            {
                                                @if (schedule.ContainsKey(day) && schedule[day].ContainsKey(c) && schedule[day][c].Count > displayRow)
                                                {
                                                    var cell = schedule[day][c][displayRow] ?? string.Empty;
                                                    if (!string.IsNullOrWhiteSpace(cell))
                                                    {
                                                        @cell
                                                    }
                                                }
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Help / Legend -->
    <div class="mt-3 text-muted small">
        <span class="me-3"><i class="bi bi-pencil-square"></i> استخدم "تعديل الجدول العام" للتحرير المباشر.</span>
        <span class="me-3"><i class="bi bi-save"></i> اضغط "حفظ البيانات" لحفظ جميع الأيام.</span>
        <span class="me-3"><i class="bi bi-file-earmark-excel"></i> استخدم "تصدير إلى Excel" لتنزيل الجدول.</span>
    </div>
</div>

@code {
    private readonly string[] days = new[] { "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس" };
    private readonly string[] columns = new[]
    {
        "الإشراف العام",
        "الصف الثامن",
        "الصف التاسع",
        "الصف العاشر",
        "الفسحة",
        "الجمعية"
    };

    private string selectedDay = "الأحد";
    private string saveMessage = string.Empty;
    private bool isEditMode = false;

    // Data model: Day -> Column -> List of teacher names (2 rows per day)
    private readonly Dictionary<string, Dictionary<string, List<string>>> schedule = new();

    // Editable text buffers: Day -> Column -> Row -> CSV text
    private readonly Dictionary<string, Dictionary<string, Dictionary<int, string>>> cellText = new();
    
    // Authentication variables
    private bool isLoading = true;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (isAuthenticated)
            {
                // Initialize structures
                foreach (var d in days)
                {
                    if (!schedule.ContainsKey(d)) schedule[d] = new();
                    if (!cellText.ContainsKey(d)) cellText[d] = new();
                    foreach (var c in columns)
                    {
                        if (!schedule[d].ContainsKey(c)) schedule[d][c] = new();
                        if (!cellText[d].ContainsKey(c)) cellText[d][c] = new();
                        for (int row = 0; row < 2; row++)
                        {
                            if (!cellText[d][c].ContainsKey(row)) cellText[d][c][row] = string.Empty;
                        }
                    }
                }

                // Load existing data from database
                await LoadScheduleFromDatabase();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking authentication: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            UpdateScheduleDisplay();
        }
    }

    private async Task LoadScheduleFromDatabase()
    {
        try
        {
            string NormalizeArabic(string input)
            {
                if (string.IsNullOrWhiteSpace(input)) return string.Empty;
                var s = input.Trim();
                // Common legacy fixes
                if (s == "الإشراف اليومي") s = "الإشراف العام";
                if (s == "الفسحه") s = "الفسحة";
                return s;
            }

            string MapToKnownColumn(string dbColumn)
            {
                var norm = NormalizeArabic(dbColumn);
                // Fuzzy normalization for Arabic variants
                string Canon(string x)
                {
                    if (string.IsNullOrWhiteSpace(x)) return string.Empty;
                    var y = x.Trim();
                    y = y.Replace('إ','ا').Replace('أ','ا').Replace('آ','ا');
                    y = y.Replace('ى','ي');
                    y = y.Replace("ـ", ""); // tatweel
                    y = y.Replace(" ", "");
                    y = y.Replace('ه','ة');
                    // strip definite article for comparison
                    if (y.StartsWith("ال")) y = y.Substring(2);
                    return y;
                }
                // Exact match first
                if (columns.Contains(norm)) return norm;
                var canon = Canon(norm);
                foreach (var c in columns)
                {
                    var cc = Canon(c);
                    if (cc == canon) return c;
                    if (cc.Contains(canon) || canon.Contains(cc)) return c;
                }
                return columns[0];
            }

            string MapToKnownDay(string dbDay)
            {
                if (string.IsNullOrWhiteSpace(dbDay)) return days[0];
                string NormalizeDay(string s)
                {
                    s = s.Trim();
                    s = s.Replace('إ','ا').Replace('أ','ا').Replace('آ','ا');
                    s = s.Replace('ى','ي');
                    s = s.Replace(" ", "");
                    return s;
                }
                var target = NormalizeDay(dbDay);
                foreach (var d in days)
                {
                    if (NormalizeDay(d) == target) return d;
                }
                return days[0];
            }

            var scheduleData = await DutyScheduleService.GetScheduleAsync();
            int applied = 0;
            foreach (var item in scheduleData)
            {
                var mappedDay = MapToKnownDay(item.Day);
                var mappedColumn = MapToKnownColumn(item.Column);
                if (cellText.ContainsKey(mappedDay) && 
                    cellText[mappedDay].ContainsKey(mappedColumn) &&
                    cellText[mappedDay][mappedColumn].ContainsKey(item.Row))
                {
                    cellText[mappedDay][mappedColumn][item.Row] = item.TeacherNames;
                    applied++;
                }
            }
            await JSRuntime.InvokeVoidAsync("console.log", $"[DutySchedule] Loaded items: {scheduleData.Count}, applied to UI: {applied}");
            UpdateScheduleDisplay();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            saveMessage = $"خطأ في تحميل البيانات: {ex.Message}";
            // Log to browser console
            await JSRuntime.InvokeVoidAsync("console.error", $"DutySchedule LoadScheduleFromDatabase error: {ex}");
        }
    }

    private async Task SaveSchedule()
    {
        try
        {
            var scheduleItems = new List<DutyScheduleItem>();
            
            // Save all days, not just selected day
            int totalNonEmpty = 0;
            foreach (var d in days)
            {
                foreach (var c in columns)
                {
                    for (int row = 0; row < 2; row++)
                    {
                        var text = GetCell(d, c, row);
                        if (!string.IsNullOrWhiteSpace(text)) totalNonEmpty++;
                        scheduleItems.Add(new DutyScheduleItem
                        {
                            Day = d,
                            Column = c,
                            Row = row,
                            TeacherNames = text
                        });
                    }
                }
            }

            await JSRuntime.InvokeVoidAsync("console.log", $"[DutySchedule] Will save all days with total non-empty cells: {totalNonEmpty}");
            
            // Debug: Print all cellText values
            foreach (var d in days)
            {
                foreach (var c in columns)
                {
                    for (int row = 0; row < 2; row++)
                    {
                        var text = GetCell(d, c, row);
                        if (!string.IsNullOrWhiteSpace(text))
                        {
                            await JSRuntime.InvokeVoidAsync("console.log", $"[DutySchedule] Found text: day={d}, col={c}, row={row}, text='{text}'");
                        }
                    }
                }
            }

            await DutyScheduleService.SaveScheduleAsync(scheduleItems);

            // Reload from DB to ensure UI matches persisted data and weekly table
            await LoadScheduleFromDatabase();

            saveMessage = "تم حفظ بيانات الجدول بنجاح!";
            // Log success to browser console
            await JSRuntime.InvokeVoidAsync("console.log", $"DutySchedule SaveSchedule success for all days");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            saveMessage = $"خطأ في حفظ البيانات: {ex.Message}";
            // Log to browser console
            await JSRuntime.InvokeVoidAsync("console.error", $"DutySchedule SaveSchedule error: {ex}");
            
        }
    }

    private void UpdateScheduleDisplay()
    {
        // Sync text -> list for all days
        foreach (var d in days)
        {
            foreach (var c in columns)
            {
                schedule[d][c].Clear();
                for (int row = 0; row < 2; row++)
                {
                    var text = cellText[d][c][row] ?? string.Empty;
                    // keep fixed positions: add value for each row (may be empty)
                    schedule[d][c].Add(text);
                }
            }
        }
        StateHasChanged();
    }

    private void OnDayChanged()
    {
        StateHasChanged();
    }

    private async Task UpdateCellText(string day, string column, int row, string value)
    {
        // Ensure dictionaries are initialized to avoid guard failing
        if (!cellText.ContainsKey(day)) cellText[day] = new();
        if (!cellText[day].ContainsKey(column)) cellText[day][column] = new();
        if (!cellText[day][column].ContainsKey(row)) cellText[day][column][row] = string.Empty;

        cellText[day][column][row] = value ?? string.Empty;

        await JSRuntime.InvokeVoidAsync("console.log", $"[DutySchedule] oninput captured: day={day}, col={column}, row={row}, len={(value ?? string.Empty).Length}");
        await JSRuntime.InvokeVoidAsync("console.log", $"[DutySchedule] cellText updated: '{cellText[day][column][row]}'");

        // Sync the schedule list for this day/column so the weekly table updates immediately
        if (!schedule.ContainsKey(day)) schedule[day] = new();
        if (!schedule[day].ContainsKey(column)) schedule[day][column] = new();
        schedule[day][column].Clear();
        for (int r = 0; r < 2; r++)
        {
            if (!cellText[day][column].ContainsKey(r)) cellText[day][column][r] = string.Empty;
            var t = cellText[day][column][r] ?? string.Empty;
            schedule[day][column].Add(t);
        }
    }

    private string GetCell(string day, string column, int row)
    {
        // Ensure dictionaries are initialized
        if (!cellText.ContainsKey(day)) cellText[day] = new();
        if (!cellText[day].ContainsKey(column)) cellText[day][column] = new();
        if (!cellText[day][column].ContainsKey(row)) cellText[day][column][row] = string.Empty;
        
        return cellText[day][column][row] ?? string.Empty;
    }

    private async Task SetCell(string day, string column, int row, string value)
    {
        await UpdateCellText(day, column, row, value ?? string.Empty);
        await SyncWeekly(day, column);
        StateHasChanged();
    }

    private async Task SyncWeekly(string day, string column)
    {
        if (schedule.ContainsKey(day) && schedule[day].ContainsKey(column))
        {
            schedule[day][column].Clear();
            for (int r = 0; r < 2; r++)
            {
                var t = cellText[day][column][r] ?? string.Empty;
                schedule[day][column].Add(t);
            }
            await JSRuntime.InvokeVoidAsync("console.log", $"[DutySchedule] SyncWeekly applied: day={day}, col={column}");
        }
    }

    // Removed custom get/set helpers; using direct oninput + UpdateCellText

    private async Task HandleCellInputWithData(ChangeEventArgs e, string day, string column, int row)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        await JSRuntime.InvokeVoidAsync("console.log", $"[DutySchedule] HandleCellInputWithData: day={day}, col={column}, row={row}, value='{value}'");
        await SetCell(day, column, row, value);
    }

    private void ToggleEditMode()
    {
        isEditMode = !isEditMode;
        StateHasChanged();
    }

    private async Task ExportToExcel()
    {
        try
        {
            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("جدول المناوبة الأسبوعية");
            worksheet.RightToLeft = true;

            // إضافة العنوان الرئيسي
            worksheet.Cell(1, 1).Value = "جدول المناوبة الأسبوعية";
            worksheet.Cell(1, 1).Style.Font.FontSize = 16;
            worksheet.Cell(1, 1).Style.Font.Bold = true;
            worksheet.Cell(1, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            worksheet.Range(1, 1, 1, columns.Length + 1).Merge();

            // إضافة رؤوس الأعمدة
            worksheet.Cell(3, 1).Value = "اليوم";
            worksheet.Cell(3, 1).Style.Font.Bold = true;
            worksheet.Cell(3, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            
            for (int i = 0; i < columns.Length; i++)
            {
                worksheet.Cell(3, i + 2).Value = columns[i];
                worksheet.Cell(3, i + 2).Style.Font.Bold = true;
                worksheet.Cell(3, i + 2).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            }

            // إضافة البيانات
            int row = 4;
            foreach (var day in days)
            {
                // الصف الأول للخلايا
                worksheet.Cell(row, 1).Value = day;
                worksheet.Cell(row, 1).Style.Font.Bold = true;
                worksheet.Cell(row, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                
                for (int col = 0; col < columns.Length; col++)
                {
                    var cellValue = GetCell(day, columns[col], 0);
                    worksheet.Cell(row, col + 2).Value = cellValue;
                    worksheet.Cell(row, col + 2).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                }
                row++;

                // الصف الثاني للخلايا
                for (int col = 0; col < columns.Length; col++)
                {
                    var cellValue = GetCell(day, columns[col], 1);
                    worksheet.Cell(row, col + 2).Value = cellValue;
                    worksheet.Cell(row, col + 2).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                }
                row++;
            }

            // تنسيق الجدول
            var tableRange = worksheet.Range(3, 1, row - 1, columns.Length + 1);
            tableRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            tableRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;

            // ضبط عرض الأعمدة
            worksheet.Column(1).Width = 15; // عمود الأيام
            for (int i = 2; i <= columns.Length + 1; i++)
            {
                worksheet.Column(i).Width = 20;
            }

            // تحويل إلى مصفوفة بايت
            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            var fileBytes = stream.ToArray();

            // تحميل الملف
            var fileName = $"جدول_المناوبة_الأسبوعية_{DateTime.Now:yyyy-MM-dd}.xlsx";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(fileBytes));

            saveMessage = "تم تصدير الجدول إلى ملف Excel بنجاح!";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            saveMessage = $"خطأ في تصدير الملف: {ex.Message}";
            await JSRuntime.InvokeVoidAsync("console.error", $"Excel export error: {ex}");
            StateHasChanged();
        }
    }

    private async Task ExportToPDF()
    {
        try
        {
            // إنشاء ملف HTML قابل للطباعة بدلاً من PDF
            var html = $@"
<!DOCTYPE html>
<html dir='rtl' lang='ar'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>جدول المناوبة الأسبوعية</title>
    <style>
        body {{
            font-family: 'Arial', sans-serif;
            margin: 20px;
            direction: rtl;
            text-align: right;
        }}
        .header {{
            text-align: center;
            margin-bottom: 30px;
        }}
        .title {{
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }}
        .date {{
            font-size: 14px;
            color: #666;
        }}
        table {{
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }}
        th, td {{
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
        }}
        th {{
            background-color: #34495e;
            color: white;
            font-weight: bold;
        }}
        tr:nth-child(even) {{
            background-color: #f8f9fa;
        }}
        .day-cell {{
            background-color: #e9ecef;
            font-weight: bold;
        }}
        .note {{
            text-align: center;
            margin-top: 30px;
            font-size: 12px;
            color: #666;
        }}
        @media print {{
            body {{ margin: 0; }}
            .no-print {{ display: none; }}
        }}
    </style>
</head>
<body>
    <div class='header'>
        <div class='title'>جدول المناوبة الأسبوعية</div>
        <div class='date'>تاريخ التقرير: {DateTime.Now:yyyy/MM/dd}</div>
    </div>
    
    <table>
        <thead>
            <tr>
                <th>اليوم</th>";

            // إضافة رؤوس الأعمدة
            foreach (var column in columns)
            {
                html += $@"
                <th>{column}</th>";
            }

            html += @"
            </tr>
        </thead>
        <tbody>";

            // إضافة البيانات
            foreach (var day in days)
            {
                html += $@"
            <tr>
                <td class='day-cell'>{day}</td>";

                // الصف الأول للخلايا
                foreach (var column in columns)
                {
                    var cellValue = GetCell(day, column, 0);
                    html += $@"
                <td>{cellValue}</td>";
                }

                html += @"
            </tr>
            <tr>
                <td class='day-cell'></td>";

                // الصف الثاني للخلايا
                foreach (var column in columns)
                {
                    var cellValue = GetCell(day, column, 1);
                    html += $@"
                <td>{cellValue}</td>";
                }

                html += @"
            </tr>";
            }

            html += @"
        </tbody>
    </table>
    
    <div class='note'>
        تم إنشاء هذا التقرير تلقائياً من نظام إدارة المدرسة
    </div>
</body>
</html>";

            // تحويل HTML إلى PDF باستخدام JavaScript
            var fileName = $"جدول_المناوبة_الأسبوعية_{DateTime.Now:yyyy-MM-dd}.html";
            await JSRuntime.InvokeVoidAsync("downloadHTMLFile", fileName, html);
            
            saveMessage = "تم تصدير جدول المناوبة إلى ملف HTML قابل للطباعة!";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            saveMessage = $"فشل تصدير جدول المناوبة: {ex.Message}";
            await JSRuntime.InvokeVoidAsync("console.error", $"PDF export error: {ex}");
            StateHasChanged();
        }
    }
}
}



