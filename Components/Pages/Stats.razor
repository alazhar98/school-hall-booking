                <td>{GetRegularOverallProjectedTotal() + GetHearingProjectedTotal()}</td>
            </tr>
        </tbody>
    </table>
</body>
</html>";

            // تحويل HTML إلى PDF باستخدام JavaScript
            var fileName = $"إحصائية_الطلبة_الشاملة_{DateTime.Now:yyyy-MM-dd}.html";
            await JS.InvokeVoidAsync("downloadHTMLFile", fileName, html);
            
            saveMessage = "تم تصدير إحصائية الطلبة الشاملة (النظاميين + الدمج السمعي) إلى ملف HTML قابل للطباعة!";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Stats] Error exporting both students to HTML: {ex.Message}");
            saveMessage = $"فشل تصدير إحصائية الطلبة الشاملة: {ex.Message}";
            StateHasChanged();
        }
    }
}
}



