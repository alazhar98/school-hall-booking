    private int GetRegularProjectedTotal()
    {
        var total = regular.Where(r => (r.Division ?? string.Empty).StartsWith(selectedGrade)).Sum(x => x.Count);
        if (regularForm is not null)
        {
            if (regularForm.Id == 0)
            {
                // Include the form count only if the form grade matches the selected grade
                var core = TrimGradePrefix(regularForm.Division);
                var formWithGrade = string.IsNullOrWhiteSpace(core) ? null : $"{selectedGrade} - {core}";
                if (!string.IsNullOrWhiteSpace(formWithGrade) && formWithGrade.StartsWith(selectedGrade))
                {
                    total += regularForm.Count;
                }
            }
            else
            {
                var existing = regular.FirstOrDefault(x => x.Id == regularForm.Id);
                if (existing != null && (existing.Division ?? string.Empty).StartsWith(selectedGrade))
                {
                    total += (regularForm.Count - existing.Count);
                }
            }
        }
        return total;
    }

    private int GetRegularOverallProjectedTotal()
    {
        var total = regular.Sum(x => x.Count);
        if (regularForm is not null)
        {
            if (regularForm.Id == 0)
            {
                if (!string.IsNullOrWhiteSpace(regularForm.Division))
                {
                    total += Math.Max(0, regularForm.Count);
                }
            }
            else
            {
                var existing = regular.FirstOrDefault(x => x.Id == regularForm.Id);
                if (existing != null)
                {
                    total += (Math.Max(0, regularForm.Count) - existing.Count);
                }
            }
        }
        return total;
    }

    private static string TrimGradePrefix(string? division)
    {
        if (string.IsNullOrWhiteSpace(division)) return string.Empty;
        var idx = division.IndexOf('–'); // en dash
        if (idx < 0) idx = division.IndexOf('-');
        return idx > 0 && idx + 1 < division.Length ? division[(idx + 1)..].Trim() : division.Trim();
    }

    private static string? ExtractGrade(string? division)
    {
        if (string.IsNullOrWhiteSpace(division)) return null;
        var idx = division.IndexOf('–');
        if (idx < 0) idx = division.IndexOf('-');
        return idx > 0 ? division[..idx].Trim() : null;
    }

    private int GetHearingProjectedTotal()
    {
        var total = hearing.Sum(x => x.Count);
        if (hearingForm is not null)
        {
            if (hearingForm.Id == 0)
            {
                total += hearingForm.Count;
            }
            else
            {
                var existing = hearing.FirstOrDefault(x => x.Id == hearingForm.Id);
                if (existing != null)
                {
                    total += (hearingForm.Count - existing.Count);
                }
                else
                {
                    total += hearingForm.Count;
                }
            }
        }
        return total;
    }

