@page "/professional-development/attendance"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@inject IProfessionalDevelopmentService ProfessionalDevelopmentService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>استمارة حضور برنامج تدريبي</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">استمارة حضور برنامج تدريبي</h2>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="@(() => OpenAddModal())">
                <i class="bi bi-plus"></i> إضافة استمارة حضور جديدة
            </button>
            <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/professional-development"))">
                <i class="bi bi-arrow-right"></i> الرجوع
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
        </div>
    }

    <!-- Attendance Forms Table -->
    <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">استمارات الحضور</h5>
            <div>
                <button class="btn btn-light btn-sm me-2" @onclick="@(() => ExportToExcel())">
                    <i class="bi bi-file-excel"></i> Excel
                </button>
                <button class="btn btn-light btn-sm" @onclick="@(() => ExportToPDF())">
                    <i class="bi bi-file-pdf"></i> PDF
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (attendanceForms.Any())
            {
                <div class="table-responsive">
                    <table id="attendance-table" class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>المادة</th>
                                <th>عنوان البرنامج</th>
                                <th>التاريخ</th>
                                <th>المنفذ</th>
                                <th>تاريخ الإنشاء</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attendance in attendanceForms)
                            {
                                <tr>
                                    <td>@attendance.Subject</td>
                                    <td>@attendance.ProgramTitle</td>
                                    <td>@attendance.Date.ToString("yyyy/MM/dd")</td>
                                    <td>@attendance.Executor</td>
                                    <td>@attendance.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <button class="btn btn-warning btn-sm" @onclick="@(() => OpenEditModal(attendance))" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm" @onclick="@(() => DeleteAttendance(attendance.Id))" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <button class="btn btn-info btn-sm" @onclick="@(() => PrintAttendance(attendance))" title="طباعة">
                                            <i class="bi bi-printer"></i>
                                        </button>
                                        <button class="btn btn-success btn-sm" @onclick="@(() => OpenManageAttendanceModal(attendance))" title="إدارة الحضور">
                                            <i class="bi bi-people"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted">لا توجد استمارات حضور مسجلة</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade @(showModal ? "show d-block" : "")" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">@(currentAttendance.Id == 0 ? "إضافة استمارة حضور جديدة" : "تعديل استمارة الحضور")</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="@(() => CloseModal())"></button>
            </div>
            <EditForm Model="@currentAttendance" OnValidSubmit="SaveAttendance" FormName="attendanceForm">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="subject" class="form-label">المادة *</label>
                            <InputText id="subject" class="form-control" @bind-Value="currentAttendance.Subject" />
                            <ValidationMessage For="@(() => currentAttendance.Subject)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="programTitle" class="form-label">عنوان البرنامج *</label>
                            <InputText id="programTitle" class="form-control" @bind-Value="currentAttendance.ProgramTitle" />
                            <ValidationMessage For="@(() => currentAttendance.ProgramTitle)" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="date" class="form-label">التاريخ *</label>
                            <InputDate id="date" class="form-control" @bind-Value="currentAttendance.Date" TValue="DateTime" />
                            <ValidationMessage For="@(() => currentAttendance.Date)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="executor" class="form-label">المنفذ *</label>
                            <InputText id="executor" class="form-control" @bind-Value="currentAttendance.Executor" />
                            <ValidationMessage For="@(() => currentAttendance.Executor)" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="@(() => CloseModal())">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<!-- Manage Attendance Modal -->
<div class="modal fade @(showManageAttendanceModal ? "show d-block" : "")" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">إدارة الحضور - @(currentAttendanceForManagement?.ProgramTitle)</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="@(() => CloseManageAttendanceModal())"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>المادة:</strong> @(currentAttendanceForManagement?.Subject)
                    </div>
                    <div class="col-md-6">
                        <strong>التاريخ:</strong> @(currentAttendanceForManagement?.Date.ToString("yyyy/MM/dd"))
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6>قائمة الحضور (@attendanceRecords.Count صف)</h6>
                    <div>
                        <button class="btn btn-primary btn-sm me-2" @onclick="@(() => AddNewAttendanceRecord())">
                            <i class="bi bi-plus"></i> إضافة مشارك
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="@(() => AddEmptyRows())">
                            <i class="bi bi-plus-square"></i> إضافة 5 صفوف فارغة
                        </button>
                    </div>
                </div>
                
                <div class="alert alert-info alert-sm mb-3">
                    <small><i class="bi bi-info-circle"></i> يمكنك إضافة أي عدد من المشاركين. الصفوف الفارغة لن تُحفظ في قاعدة البيانات.</small>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 8%;">م</th>
                                <th style="width: 30%;">الاسم</th>
                                <th style="width: 25%;">الوظيفة</th>
                                <th style="width: 25%;">التوقيع</th>
                                <th style="width: 12%;">ملاحظات</th>
                                <th style="width: 10%;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < attendanceRecords.Count; i++)
                            {
                                var record = attendanceRecords[i];
                                var index = i + 1;
                                <tr>
                                    <td>@index</td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" @bind="record.Name" placeholder="اسم المشارك" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" @bind="record.JobTitle" placeholder="الوظيفة" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" placeholder="التوقيع" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" @bind="record.Notes" placeholder="ملاحظات" />
                                    </td>
                                    <td>
                                        <button class="btn btn-danger btn-sm" @onclick="@(() => RemoveAttendanceRecord(i))" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="@(() => CloseManageAttendanceModal())">إلغاء</button>
                <button type="button" class="btn btn-success" @onclick="@(() => SaveAttendanceRecords())">حفظ البيانات</button>
                <button type="button" class="btn btn-info" @onclick="@(() => PrintAttendanceWithRecords())">طباعة الاستمارة</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Attendance> attendanceForms = new();
    private Attendance currentAttendance = new();
    private bool showModal = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    // Manage Attendance Modal
    private bool showManageAttendanceModal = false;
    private Attendance? currentAttendanceForManagement;
    private List<AttendanceRecord> attendanceRecords = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAttendanceForms();
    }

    private async Task LoadAttendanceForms()
    {
        try
        {
            attendanceForms = await ProfessionalDevelopmentService.GetAllAttendancesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تحميل استمارات الحضور: {ex.Message}";
        }
    }

    private void OpenAddModal()
    {
        currentAttendance = new Attendance();
        showModal = true;
        StateHasChanged();
    }

    private void OpenEditModal(Attendance attendance)
    {
        currentAttendance = new Attendance
        {
            Id = attendance.Id,
            Subject = attendance.Subject,
            ProgramTitle = attendance.ProgramTitle,
            Date = attendance.Date,
            Executor = attendance.Executor
        };
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        currentAttendance = new Attendance();
        StateHasChanged();
    }

    private async Task SaveAttendance()
    {
        try
        {
            if (currentAttendance.Id == 0)
            {
                await ProfessionalDevelopmentService.AddAttendanceAsync(currentAttendance);
                successMessage = "تم إضافة استمارة الحضور بنجاح";
            }
            else
            {
                await ProfessionalDevelopmentService.UpdateAttendanceAsync(currentAttendance);
                successMessage = "تم تحديث استمارة الحضور بنجاح";
            }

            await LoadAttendanceForms();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في حفظ استمارة الحضور: {ex.Message}";
        }
    }

    private async Task DeleteAttendance(int id)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذه استمارة الحضور؟");
            if (confirmed)
            {
                await ProfessionalDevelopmentService.DeleteAttendanceAsync(id);
                successMessage = "تم حذف استمارة الحضور بنجاح";
                await LoadAttendanceForms();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في حذف استمارة الحضور: {ex.Message}";
        }
    }

    private async Task PrintAttendance(Attendance attendance)
    {
        try
        {
            // اطبع باستخدام السجلات الفعلية فقط بدون تعبئة صفوف إضافية
            var records = await ProfessionalDevelopmentService.GetAttendanceRecordsByAttendanceIdAsync(attendance.Id);
            var htmlContent = GenerateAttendanceWithRecordsPDFContent(attendance, records);
            await JSRuntime.InvokeVoidAsync("printHTML", htmlContent, $"استمارة_حضور_{attendance.ProgramTitle}");
            successMessage = "تم إرسال استمارة الحضور للطباعة";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في طباعة استمارة الحضور: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToExcel", "attendance-table", $"استمارات_الحضور_{DateTime.Now:yyyyMMdd_HHmmss}");
            successMessage = "تم تصدير البيانات إلى Excel";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تصدير Excel: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ExportToPDF()
    {
        try
        {
            var htmlContent = GeneratePDFContent();
            await JSRuntime.InvokeVoidAsync("printHTML", htmlContent, "استمارات_الحضور");
            successMessage = "تم إرسال البيانات للطباعة";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تصدير PDF: {ex.Message}";
            StateHasChanged();
        }
    }

    private string GenerateCSV()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("\uFEFF"); // BOM for UTF-8
        csv.AppendLine("المادة,عنوان البرنامج,التاريخ,المنفذ,تاريخ الإنشاء");
        
        foreach (var attendance in attendanceForms)
        {
            csv.AppendLine($"{attendance.Subject},{attendance.ProgramTitle},{attendance.Date:yyyy/MM/dd},{attendance.Executor},{attendance.CreatedAt:yyyy/MM/dd}");
        }
        
        return csv.ToString();
    }

    private string GeneratePDFContent()
    {
        var html = $@"
        <!DOCTYPE html>
        <html dir='rtl' lang='ar'>
        <head>
            <meta charset='utf-8'>
            <title>استمارات الحضور</title>
            <style>
                body {{ font-family: Arial, sans-serif; margin: 20px; direction: rtl; }}
                .header {{ text-align: center; margin-bottom: 30px; }}
                .header h1 {{ color: #007bff; margin-bottom: 10px; }}
                .header p {{ color: #666; }}
                table {{ width: 100%; border-collapse: collapse; margin-top: 20px; }}
                th, td {{ border: 1px solid #ddd; padding: 8px; text-align: right; }}
                th {{ background-color: #f8f9fa; font-weight: bold; }}
                .text-center {{ text-align: center; }}
                .mt-3 {{ margin-top: 15px; }}
            </style>
        </head>
        <body>
            <div class='header'>
                <h1>استمارات الحضور</h1>
                <p>تاريخ التقرير: {DateTime.Now:yyyy/MM/dd}</p>
            </div>
            
            <table>
                <thead>
                    <tr>
                        <th>المادة</th>
                        <th>عنوان البرنامج</th>
                        <th>التاريخ</th>
                        <th>المنفذ</th>
                        <th>تاريخ الإنشاء</th>
                    </tr>
                </thead>
                <tbody>";

        foreach (var attendance in attendanceForms)
        {
            html += $@"
                    <tr>
                        <td>{attendance.Subject}</td>
                        <td>{attendance.ProgramTitle}</td>
                        <td>{attendance.Date:yyyy/MM/dd}</td>
                        <td>{attendance.Executor}</td>
                        <td>{attendance.CreatedAt:yyyy/MM/dd}</td>
                    </tr>";
        }

        html += @"
                </tbody>
            </table>
        </body>
        </html>";

        return html;
    }

    private string GenerateAttendancePDFContent(Attendance attendance)
    {
        var html = $@"
        <!DOCTYPE html>
        <html dir='rtl' lang='ar'>
        <head>
            <meta charset='utf-8'>
            <title>استمارة حضور برنامج تدريبي</title>
            <style>
                body {{ font-family: Arial, sans-serif; margin: 20px; direction: rtl; }}
                
                /* Header Styles */
                .header {{ text-align: center; margin-bottom: 30px; }}
                .header h1 {{ color: #198754; font-size: 24px; margin: 20px 0 10px 0; }}
                .header p {{ color: #666; font-size: 14px; margin: 2px 0; }}
                
                /* General Information Section */
                .general-info {{ margin-bottom: 30px; }}
                .general-info h3 {{ color: #198754; font-size: 18px; margin-bottom: 15px; text-align: center; }}
                .info-table {{ width: 100%; border-collapse: collapse; }}
                .info-table td {{ border: 1px solid #333; padding: 12px; }}
                .info-table td:first-child {{ width: 25%; text-align: right; font-weight: bold; background-color: #f8f9fa; }}
                .info-table td:last-child {{ width: 75%; text-align: right; }}
                
                /* Attendance Table */
                .attendance-table {{ width: 100%; border-collapse: collapse; margin-top: 20px; }}
                .attendance-table th {{ background-color: #6c757d; color: white; padding: 12px 8px; text-align: center; font-weight: bold; border: 1px solid #333; }}
                .attendance-table td {{ border: 1px solid #333; padding: 12px 8px; text-align: center; }}
                .attendance-table td:first-child {{ width: 8%; }}
                .attendance-table td:nth-child(2) {{ width: 30%; }}
                .attendance-table td:nth-child(3) {{ width: 25%; }}
                .attendance-table td:nth-child(4) {{ width: 25%; }}
                .attendance-table td:last-child {{ width: 12%; }}
                
                /* Signature Section */
                .signature-section {{ margin-top: 40px; text-align: right; }}
                .signature-section p {{ margin: 10px 0; font-weight: bold; }}
            </style>
        </head>
        <body>
            <!-- Header Section -->
            <div class='header'>
                <h1>استمارة حضور برنامج تدريبي</h1>
                <p>المديرية العامة للتربية والتعليم المحافظة جنوب الباطنة</p>
                <p>مدرسة الفضل بن العباس للتعليم الأساسي (8 - 10)</p>
            </div>
            
            <!-- General Information Section -->
            <div class='general-info'>
                <h3>البيانات العامة .</h3>
                <table class='info-table'>
                    <tr>
                        <td>المادة</td>
                        <td>{attendance.Subject}</td>
                    </tr>
                    <tr>
                        <td>عنوان البرنامج</td>
                        <td>{attendance.ProgramTitle}</td>
                    </tr>
                    <tr>
                        <td>التاريخ</td>
                        <td>{attendance.Date:yyyy/MM/dd}</td>
                    </tr>
                    <tr>
                        <td>المنفذ</td>
                        <td>{attendance.Executor}</td>
                    </tr>
                </table>
            </div>
            
            <!-- Attendance Table -->
            <table class='attendance-table'>
                <thead>
                    <tr>
                        <th>م</th>
                        <th>الاسم</th>
                        <th>الوظيفة</th>
                        <th>التوقيع</th>
                        <th>ملاحظات</th>
                    </tr>
                </thead>
                <tbody>";

        // لا تقم بتوليد صفوف ثابتة هنا؛ سيتم استخدام الدالة مع السجلات الفعلية بدلاً منها

        html += @"
                </tbody>
            </table>
            
            <!-- Signature Section -->
            <div class='signature-section'>
                <p>يعتمد ؛؛؛ مدير المدرسة</p>
            </div>
        </body>
        </html>";

        return html;
    }

    // Manage Attendance Modal Functions
    private async Task OpenManageAttendanceModal(Attendance attendance)
    {
        currentAttendanceForManagement = attendance;
        attendanceRecords = await ProfessionalDevelopmentService.GetAttendanceRecordsByAttendanceIdAsync(attendance.Id);
        
        // If no records exist, add one empty row to start with
        if (!attendanceRecords.Any())
        {
            attendanceRecords.Add(new AttendanceRecord
            {
                AttendanceId = attendance.Id,
                Name = string.Empty,
                JobTitle = string.Empty,
                Notes = string.Empty
            });
        }
        
        showManageAttendanceModal = true;
        StateHasChanged();
    }

    private void CloseManageAttendanceModal()
    {
        showManageAttendanceModal = false;
        currentAttendanceForManagement = null;
        attendanceRecords.Clear();
        StateHasChanged();
    }

    private void AddNewAttendanceRecord()
    {
        attendanceRecords.Add(new AttendanceRecord
        {
            AttendanceId = currentAttendanceForManagement?.Id ?? 0,
            Name = string.Empty,
            JobTitle = string.Empty,
            Notes = string.Empty
        });
        StateHasChanged();
    }

    private void AddEmptyRows()
    {
        // Add 5 empty rows at once
        for (int i = 0; i < 5; i++)
        {
            attendanceRecords.Add(new AttendanceRecord
            {
                AttendanceId = currentAttendanceForManagement?.Id ?? 0,
                Name = string.Empty,
                JobTitle = string.Empty,
                Notes = string.Empty
            });
        }
        StateHasChanged();
    }

    private void RemoveAttendanceRecord(int index)
    {
        if (index >= 0 && index < attendanceRecords.Count)
        {
            attendanceRecords.RemoveAt(index);
            StateHasChanged();
        }
    }

    private async Task SaveAttendanceRecords()
    {
        try
        {
            // Delete existing records for this attendance
            var existingRecords = await ProfessionalDevelopmentService.GetAttendanceRecordsByAttendanceIdAsync(currentAttendanceForManagement!.Id);
            foreach (var record in existingRecords)
            {
                await ProfessionalDevelopmentService.DeleteAttendanceRecordAsync(record.Id);
            }

            // Add new records (only those with names)
            foreach (var record in attendanceRecords.Where(r => !string.IsNullOrWhiteSpace(r.Name)))
            {
                record.AttendanceId = currentAttendanceForManagement.Id;
                await ProfessionalDevelopmentService.AddAttendanceRecordAsync(record);
            }

            successMessage = "تم حفظ بيانات الحضور بنجاح";
            CloseManageAttendanceModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في حفظ بيانات الحضور: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task PrintAttendanceWithRecords()
    {
        try
        {
            var htmlContent = GenerateAttendanceWithRecordsPDFContent(currentAttendanceForManagement!, attendanceRecords);
            await JSRuntime.InvokeVoidAsync("printHTML", htmlContent, $"استمارة_حضور_{currentAttendanceForManagement!.ProgramTitle}");
            successMessage = "تم إرسال استمارة الحضور للطباعة";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في طباعة استمارة الحضور: {ex.Message}";
            StateHasChanged();
        }
    }

    private string GenerateAttendanceWithRecordsPDFContent(Attendance attendance, List<AttendanceRecord> records)
    {
        var html = $@"
        <!DOCTYPE html>
        <html dir='rtl' lang='ar'>
        <head>
            <meta charset='utf-8'>
            <title>استمارة حضور برنامج تدريبي</title>
            <style>
                body {{ font-family: Arial, sans-serif; margin: 20px; direction: rtl; }}
                
                /* Header Styles */
                .header {{ text-align: center; margin-bottom: 30px; }}
                .header h1 {{ color: #198754; font-size: 24px; margin: 20px 0 10px 0; }}
                .header p {{ color: #666; font-size: 14px; margin: 2px 0; }}
                
                /* General Information Section */
                .general-info {{ margin-bottom: 30px; }}
                .general-info h3 {{ color: #198754; font-size: 18px; margin-bottom: 15px; text-align: center; }}
                .info-table {{ width: 100%; border-collapse: collapse; }}
                .info-table td {{ border: 1px solid #333; padding: 12px; }}
                .info-table td:first-child {{ width: 25%; text-align: right; font-weight: bold; background-color: #f8f9fa; }}
                .info-table td:last-child {{ width: 75%; text-align: right; }}
                
                /* Attendance Table */
                .attendance-table {{ width: 100%; border-collapse: collapse; margin-top: 20px; }}
                .attendance-table th {{ background-color: #6c757d; color: white; padding: 12px 8px; text-align: center; font-weight: bold; border: 1px solid #333; }}
                .attendance-table td {{ border: 1px solid #333; padding: 12px 8px; text-align: center; }}
                .attendance-table td:first-child {{ width: 8%; }}
                .attendance-table td:nth-child(2) {{ width: 30%; }}
                .attendance-table td:nth-child(3) {{ width: 25%; }}
                .attendance-table td:nth-child(4) {{ width: 25%; }}
                .attendance-table td:last-child {{ width: 12%; }}
                
                /* Signature Section */
                .signature-section {{ margin-top: 40px; text-align: right; }}
                .signature-section p {{ margin: 10px 0; font-weight: bold; }}
            </style>
        </head>
        <body>
            <!-- Header Section -->
            <div class='header'>
                <h1>استمارة حضور برنامج تدريبي</h1>
                <p>المديرية العامة للتربية والتعليم المحافظة جنوب الباطنة</p>
                <p>مدرسة الفضل بن العباس للتعليم الأساسي (8 - 10)</p>
            </div>
            
            <!-- General Information Section -->
            <div class='general-info'>
                <h3>البيانات العامة .</h3>
                <table class='info-table'>
                    <tr>
                        <td>المادة</td>
                        <td>{attendance.Subject}</td>
                    </tr>
                    <tr>
                        <td>عنوان البرنامج</td>
                        <td>{attendance.ProgramTitle}</td>
                    </tr>
                    <tr>
                        <td>التاريخ</td>
                        <td>{attendance.Date:yyyy/MM/dd}</td>
                    </tr>
                    <tr>
                        <td>المنفذ</td>
                        <td>{attendance.Executor}</td>
                    </tr>
                </table>
            </div>
            
            <!-- Attendance Table -->
            <table class='attendance-table'>
                <thead>
                    <tr>
                        <th>م</th>
                        <th>الاسم</th>
                        <th>الوظيفة</th>
                        <th>التوقيع</th>
                        <th>ملاحظات</th>
                    </tr>
                </thead>
                <tbody>";

        // Fill the table with actual data (only existing rows)
        if (records.Count > 0)
        {
            for (int i = 0; i < records.Count; i++)
            {
                var record = records[i];
                var index = i + 1;
                html += $@"
                        <tr>
                            <td>{index}</td>
                            <td>{record.Name}</td>
                            <td>{record.JobTitle}</td>
                            <td></td>
                            <td>{record.Notes}</td>
                        </tr>";
            }
        }
        else
        {
            // If no records, show a single empty row
            html += @"
                        <tr>
                            <td>1</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>";
        }

        html += @"
                </tbody>
            </table>
            
            <!-- Signature Section -->
            <div class='signature-section'>
                <p>يعتمد ؛؛؛ مدير المدرسة</p>
            </div>
        </body>
        </html>";

        return html;
    }
}
