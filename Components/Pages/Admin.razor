@page "/admin"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@using SchoolHallBooking.Data
@using Microsoft.EntityFrameworkCore
@inject IBookingService BookingService
@inject IAdminAuthService AdminAuthService
@inject IExportService ExportService
@inject ITimeZoneService TimeZoneService
@inject BookingDbContext Context
@inject ILogger<Admin> Logger
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>الإدارة - إدارة حجوزات القاعات</PageTitle>

<div class="container mt-3">
    <hr />
    </div>

<script>
    window.downloadFile = function (dataUrl, fileName) {
        const link = document.createElement('a');
        link.href = dataUrl;
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };
</script>

@if (!isAdminLoggedIn)
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card mt-5">
                    <div class="card-header">
                        <h3 class="text-center">الوصول مرفوض</h3>
                    </div>
                    <div class="card-body text-center">
                        <p>تحتاج إلى تسجيل الدخول كمدير للوصول إلى هذه الصفحة.</p>
                        <a href="/login" class="btn btn-primary">اذهب إلى تسجيل الدخول</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col-12 text-end">
                <span class="text-muted">مرحباً، المدير</span>
                <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="Logout">تسجيل الخروج</button>
            </div>
        </div>
    <div class="row">
        <div class="col-12">
            <h1 class="display-4 text-center mb-4">لوحة الإدارة</h1>
            <p class="lead text-center mb-5">إدارة حجوزات القاعات وعرض جميع الحجوزات</p>
        </div>
    </div>

    <!-- Employee Management Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3><i class="bi bi-people-fill me-2"></i>إدارة تسجيل الدخول</h3>
                    <button class="btn btn-success" @onclick="ShowAddEmployeeModal">
                        <i class="bi bi-person-plus me-1"></i>إضافة موظف جديد
                    </button>
                </div>
                <div class="card-body">
                    @if (employees.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>رقم الموظف</th>
                                        <th>الاسم</th>
                                        <th>الحالة</th>
                                        <th>تاريخ الإنشاء</th>
                                        <th>الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var employee in employees)
                                    {
                                        <tr>
                                            <td>@employee.EmployeeId</td>
                                            <td>@employee.Name</td>
                                            <td>
                                                <span class="badge @(employee.IsActive ? "bg-success" : "bg-danger")">
                                                    @(employee.IsActive ? "نشط" : "غير نشط")
                                                </span>
                                            </td>
                                            <td>@employee.CreatedAt.ToShortDateString()</td>
                                            <td>
                                                <button class="btn btn-warning btn-sm me-2" @onclick="() => EditEmployee(employee)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteEmployee(employee)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            لا توجد بيانات موظفين لعرضها.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Filtering Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>فلترة الحجوزات</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <label for="filterHall" class="form-label">فلترة حسب القاعة:</label>
                            <InputSelect class="form-select" id="filterHall" @bind-Value="filterHallId" TValue="int?">
                                <option value="">جميع القاعات</option>
                                @foreach (var hall in availableHalls)
                                {
                                    <option value="@hall.Id">@hall.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label for="filterFromDate" class="form-label">من تاريخ:</label>
                            <InputDate class="form-control" id="filterFromDate" @bind-Value="filterFromDate" TValue="DateTime?" />
                        </div>
                        <div class="col-md-3">
                            <label for="filterToDate" class="form-label">إلى تاريخ:</label>
                            <InputDate class="form-control" id="filterToDate" @bind-Value="filterToDate" TValue="DateTime?" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button class="btn btn-primary me-2" @onclick="ApplyFilters">تطبيق الفلترة</button>
                            <button class="btn btn-outline-secondary" @onclick="ClearFilters">مسح الفلترة</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3>إحصائيات الحجوزات</h3>
                    <button class="btn btn-outline-primary btn-sm" @onclick="LoadStatistics">
                        <i class="bi bi-arrow-clockwise"></i> تحديث الإحصائيات
                    </button>
                </div>
                <div class="card-body">
                    @if (bookingStatistics.Any() || sectionStatistics.Any())
                    {
                        <div class="row">
                            <div class="col-md-4">
                                <h5>عدد الحجوزات لكل قاعة:</h5>
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>اسم القاعة</th>
                                                <th>عدد الحجوزات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var stat in bookingStatistics.OrderByDescending(x => x.Value))
                                            {
                                                <tr>
                                                    <td>@stat.Key</td>
                                                    <td>
                                                        <span class="badge bg-primary">@stat.Value</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <h5>عدد الحجوزات لكل قسم:</h5>
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>اسم القسم</th>
                                                <th>عدد الحجوزات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var stat in sectionStatistics.OrderByDescending(x => x.Value))
                                            {
                                                <tr>
                                                    <td>@stat.Key</td>
                                                    <td>
                                                        <span class="badge bg-success">@stat.Value</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <h5>ملخص الإحصائيات:</h5>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="card bg-success text-white">
                                            <div class="card-body text-center">
                                                <h4>@mostBookedHall</h4>
                                                <small>الأكثر حجزاً</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card bg-warning text-dark">
                                            <div class="card-body text-center">
                                                <h4>@leastBookedHall</h4>
                                                <small>الأقل حجزاً</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="card bg-info text-white">
                                                <div class="card-body text-center">
                                                    <h4>@mostActiveSection</h4>
                                                    <small>الأكثر نشاطاً</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="card bg-secondary text-white">
                                                <div class="card-body text-center">
                                                    <h4>@leastActiveSection</h4>
                                                    <small>الأقل نشاطاً</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <div class="card bg-primary text-white">
                                        <div class="card-body text-center">
                                            <h4>@totalBookings</h4>
                                            <small>إجمالي الحجوزات</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <p>لا توجد إحصائيات متاحة حالياً.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3>جميع الحجوزات</h3>
                    <div class="btn-group" role="group">
                        <button class="btn btn-success" @onclick="ExportToExcel" disabled="@isExporting">
                            @if (isExporting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-file-earmark-excel"></i> تحميل كملف Excel
                        </button>
                        <button class="btn btn-primary" @onclick="LoadAllBookings">تحديث جميع الحجوزات</button>
                    </div>
                </div>
                <div class="card-body">

                    @if (isLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">جاري التحميل...</span>
                            </div>
                        </div>
                    }
                    else if (allBookings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="bookingsTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>اسم القاعة</th>
                                        <th>المدرس</th>
                                        <th>القسم</th>
                                        <th>الحصة</th>
                                        <th>تاريخ الحجز</th>
                                        <th>تاريخ الإنشاء</th>
                                        <th class="no-print">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in allBookings)
                                    {
                                        <tr>
                                            <td>@booking.Hall.Name</td>
                                            <td>@booking.TeacherName</td>
                                            <td>@booking.Section</td>
                                            <td>الحصة @booking.Period</td>
                                            <td>@booking.BookingDate.ToString("yyyy/MM/dd")</td>
                                            <td>@booking.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                            <td class="no-print">
                                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteBooking(booking.Id)">
                                                    حذف
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <h5>لا توجد حجوزات</h5>
                            <p>لم يتم العثور على حجوزات للتاريخ المحدد.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (showDeleteModal)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">تأكيد الحذف</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>هل أنت متأكد من حذف هذا الحجز؟</p>
                    <p><strong>القاعة:</strong> @selectedBookingHallName</p>
                    <p><strong>الحصة:</strong> @selectedBookingPeriod</p>
                    <p><strong>التاريخ:</strong> @selectedBookingDate.ToString("yyyy/MM/dd")</p>
                    <p><strong>المدرس:</strong> @selectedBookingTeacher</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">إلغاء</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">حذف الحجز</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
    </div>
}

     <!-- Add Employee Modal -->
     @if (showAddEmployeeModal)
     {
         <div class="modal show d-block" tabindex="-1">
             <div class="modal-dialog">
                 <div class="modal-content">
                     <div class="modal-header">
                         <h5 class="modal-title">إضافة موظف جديد</h5>
                         <button type="button" class="btn-close" @onclick="CloseAddEmployeeModal"></button>
                     </div>
                     <div class="modal-body">
                         @if (!string.IsNullOrEmpty(errorMessage))
                         {
                             <div class="alert alert-danger" role="alert">
                                 @errorMessage
                             </div>
                         }
                         
                         @if (!string.IsNullOrEmpty(successMessage))
                         {
                             <div class="alert alert-success" role="alert">
                                 @successMessage
                             </div>
                         }
                         
                         <EditForm Model="@newEmployee" OnValidSubmit="AddEmployee">
                             <DataAnnotationsValidator />
                             <ValidationSummary class="text-danger mb-3" />

                             <div class="mb-3">
                                 <label for="employeeId" class="form-label">رقم الموظف</label>
                                 <InputText id="employeeId" class="form-control" @bind-Value="newEmployee.EmployeeId" placeholder="أدخل رقم الموظف" />
                                 <ValidationMessage For="@(() => newEmployee.EmployeeId)" class="text-danger small" />
                             </div>

                             <div class="mb-3">
                                 <label for="employeeName" class="form-label">اسم الموظف</label>
                                 <InputText id="employeeName" class="form-control" @bind-Value="newEmployee.Name" placeholder="أدخل اسم الموظف" />
                                 <ValidationMessage For="@(() => newEmployee.Name)" class="text-danger small" />
                             </div>

                             <div class="mb-3">
                                 <label for="employeePassword" class="form-label">كلمة المرور</label>
                                 <InputText id="employeePassword" type="password" class="form-control" @bind-Value="newEmployee.Password" placeholder="أدخل كلمة المرور" />
                                 <ValidationMessage For="@(() => newEmployee.Password)" class="text-danger small" />
                             </div>

                             <div class="mb-3 form-check">
                                 <InputCheckbox id="isActive" class="form-check-input" @bind-Value="newEmployee.IsActive" />
                                 <label class="form-check-label" for="isActive">نشط</label>
                             </div>

                             <div class="d-flex justify-content-end gap-2">
                                 <button type="button" class="btn btn-secondary" @onclick="CloseAddEmployeeModal">إلغاء</button>
                                 <button type="submit" class="btn btn-success" disabled="@isAddingEmployee">
                                     @if (isAddingEmployee)
                                     {
                                         <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                     }
                                     إضافة الموظف
                                 </button>
                             </div>
                         </EditForm>
                     </div>
                 </div>
             </div>
         </div>
         <div class="modal-backdrop show"></div>
     }

     <!-- Edit Employee Modal -->
     @if (showEditEmployeeModal)
     {
         <div class="modal show d-block" tabindex="-1">
             <div class="modal-dialog">
                 <div class="modal-content">
                     <div class="modal-header">
                         <h5 class="modal-title">تعديل بيانات الموظف</h5>
                         <button type="button" class="btn-close" @onclick="CloseEditEmployeeModal"></button>
                     </div>
                     <div class="modal-body">
                         <EditForm Model="@editEmployee" OnValidSubmit="UpdateEmployee">
                             <DataAnnotationsValidator />
                             <ValidationSummary class="text-danger mb-3" />

                             <div class="mb-3">
                                 <label for="editEmployeeId" class="form-label">رقم الموظف</label>
                                 <InputText id="editEmployeeId" class="form-control" @bind-Value="editEmployee.EmployeeId" placeholder="أدخل رقم الموظف" />
                                 <ValidationMessage For="@(() => editEmployee.EmployeeId)" class="text-danger small" />
                             </div>

                             <div class="mb-3">
                                 <label for="editEmployeeName" class="form-label">اسم الموظف</label>
                                 <InputText id="editEmployeeName" class="form-control" @bind-Value="editEmployee.Name" placeholder="أدخل اسم الموظف" />
                                 <ValidationMessage For="@(() => editEmployee.Name)" class="text-danger small" />
                             </div>

                             <div class="mb-3">
                                 <label for="editEmployeePassword" class="form-label">كلمة المرور</label>
                                 <InputText id="editEmployeePassword" type="password" class="form-control" @bind-Value="editEmployee.Password" placeholder="أدخل كلمة المرور الجديدة" />
                                 <ValidationMessage For="@(() => editEmployee.Password)" class="text-danger small" />
                                 <div class="form-text">اتركها فارغة إذا كنت لا تريد تغيير كلمة المرور</div>
                             </div>

                             <div class="mb-3 form-check">
                                 <InputCheckbox id="editIsActive" class="form-check-input" @bind-Value="editEmployee.IsActive" />
                                 <label class="form-check-label" for="editIsActive">نشط</label>
                             </div>

                             <div class="d-flex justify-content-end gap-2">
                                 <button type="button" class="btn btn-secondary" @onclick="CloseEditEmployeeModal">إلغاء</button>
                                 <button type="submit" class="btn btn-primary" disabled="@isEditingEmployee">
                                     @if (isEditingEmployee)
                                     {
                                         <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                     }
                                     حفظ التغييرات
                                 </button>
                             </div>
                         </EditForm>
                     </div>
                 </div>
             </div>
         </div>
         <div class="modal-backdrop show"></div>
     }

@code {
    private List<Booking> allBookings = new();
    private List<Hall> availableHalls = new();
    private List<Employee> employees = new();
    private bool isLoading = false;
    private bool showDeleteModal = false;
    private int selectedBookingId;
    private string selectedBookingHallName = string.Empty;
    private string selectedBookingTeacher = string.Empty;
    private int selectedBookingPeriod;
    private DateTime selectedBookingDate;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isAdminLoggedIn = false;
    private bool isAuthenticated = false;
    private Dictionary<string, int> bookingStatistics = new();
    private Dictionary<string, int> sectionStatistics = new();
    private string mostBookedHall = string.Empty;
    private string leastBookedHall = string.Empty;
    private string mostActiveSection = string.Empty;
    private string leastActiveSection = string.Empty;
    private int totalBookings = 0;
    
    // Filter variables
    private int? filterHallId = null;
    private DateTime? filterFromDate = null;
    private DateTime? filterToDate = null;
    
    // Export/Print variables
    private bool isExporting = false;
    
    // Employee management variables
    private bool showAddEmployeeModal = false;
    private bool isAddingEmployee = false;
    private Employee newEmployee = new();
    
    // Edit employee variables
    private bool showEditEmployeeModal = false;
    private bool isEditingEmployee = false;
    private Employee editEmployee = new();

    protected override async Task OnInitializedAsync()
    {
        // Check if admin is logged in using the admin auth service
        isAdminLoggedIn = await AdminAuthService.IsAdminLoggedInAsync();
        if (isAdminLoggedIn)
        {
            await LoadHalls();
            await LoadAllBookings();
            await LoadStatistics();
            await LoadEmployees();
        }
        StateHasChanged(); // Force re-render after async check
    }

    private async Task LoadAllBookings()
    {
        try
        {
            isLoading = true;
            allBookings = await BookingService.GetAllBookingsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading all bookings");
            errorMessage = "خطأ في تحميل الحجوزات. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void DeleteBooking(int bookingId)
    {
        var booking = allBookings.FirstOrDefault(b => b.Id == bookingId);
        if (booking != null)
        {
            selectedBookingId = bookingId;
            selectedBookingHallName = booking.Hall.Name;
            selectedBookingTeacher = booking.TeacherName;
            selectedBookingPeriod = booking.Period;
            selectedBookingDate = booking.BookingDate;
            showDeleteModal = true;
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await BookingService.DeleteBookingAsync(selectedBookingId);
            successMessage = "تم حذف الحجز بنجاح.";
            
            showDeleteModal = false;
            await LoadAllBookings();
            await LoadStatistics();
            StateHasChanged();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            showDeleteModal = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting booking");
            errorMessage = "خطأ في حذف الحجز. يرجى المحاولة مرة أخرى.";
            showDeleteModal = false;
        }
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        selectedBookingId = 0;
        selectedBookingHallName = string.Empty;
        selectedBookingTeacher = string.Empty;
    }

    private async Task LoadStatistics()
    {
        try
        {
            bookingStatistics = await BookingService.GetHallBookingStatisticsAsync();
            sectionStatistics = await BookingService.GetSectionBookingStatisticsAsync();
            
            if (bookingStatistics.Any())
            {
                totalBookings = bookingStatistics.Values.Sum();
                mostBookedHall = bookingStatistics.OrderByDescending(x => x.Value).First().Key;
                leastBookedHall = bookingStatistics.OrderBy(x => x.Value).First().Key;
            }
            else
            {
                totalBookings = 0;
                mostBookedHall = "لا توجد حجوزات";
                leastBookedHall = "لا توجد حجوزات";
            }

            if (sectionStatistics.Any())
            {
                mostActiveSection = sectionStatistics.OrderByDescending(x => x.Value).First().Key;
                leastActiveSection = sectionStatistics.OrderBy(x => x.Value).First().Key;
            }
            else
            {
                mostActiveSection = "لا توجد حجوزات";
                leastActiveSection = "لا توجد حجوزات";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading booking statistics");
            errorMessage = "خطأ في تحميل الإحصائيات. يرجى المحاولة مرة أخرى.";
        }
    }

    private async Task LoadHalls()
    {
        try
        {
            availableHalls = await BookingService.GetAvailableHallsAsync(TimeZoneService.GetCurrentDate());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading halls");
            errorMessage = "خطأ في تحميل القاعات. يرجى المحاولة مرة أخرى.";
        }
    }

    private async Task ApplyFilters()
    {
        try
        {
            isLoading = true;
            allBookings = await BookingService.GetFilteredBookingsAsync(filterHallId, filterFromDate, filterToDate);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error applying filters");
            errorMessage = "خطأ في تطبيق الفلترة. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearFilters()
    {
        filterHallId = null;
        filterFromDate = null;
        filterToDate = null;
        await LoadAllBookings();
    }

    private async Task Logout()
    {
        await AdminAuthService.LogoutAdminAsync();
        Navigation.NavigateTo("/");
    }

    private async Task ExportToExcel()
    {
        try
        {
            isExporting = true;
            StateHasChanged();

            // Get the current filtered bookings
            var bookingsToExport = allBookings;
            
            // If no bookings to export, show message
            if (!bookingsToExport.Any())
            {
                errorMessage = "لا توجد حجوزات للتصدير.";
                return;
            }

            // Generate Excel file
            var excelData = await ExportService.ExportToExcelAsync(bookingsToExport);
            var fileName = ExportService.GenerateFileName();

            // Convert to base64 for download
            var base64 = Convert.ToBase64String(excelData);
            var dataUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}";

            // Trigger download using JavaScript
            await JSRuntime.InvokeVoidAsync("downloadFile", dataUrl, fileName);
            
            successMessage = "تم تصدير البيانات بنجاح.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting to Excel");
            errorMessage = "خطأ في تصدير البيانات. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    // Employee management methods
    private async Task LoadEmployees()
    {
        try
        {
            employees = await Context.Employees.OrderBy(e => e.Name).ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading employees");
            errorMessage = "خطأ في تحميل بيانات الموظفين.";
        }
    }

    private void ShowAddEmployeeModal()
    {
        newEmployee = new Employee();
        showAddEmployeeModal = true;
    }

    private void CloseAddEmployeeModal()
    {
        showAddEmployeeModal = false;
        newEmployee = new Employee();
        errorMessage = "";
        successMessage = "";
    }

    private async Task AddEmployee()
    {
        try
        {
            isAddingEmployee = true;
            errorMessage = "";
            successMessage = "";
            
            // Validate required fields
            if (string.IsNullOrWhiteSpace(newEmployee.EmployeeId))
            {
                errorMessage = "رقم الموظف مطلوب.";
                return;
            }
            
            if (string.IsNullOrWhiteSpace(newEmployee.Name))
            {
                errorMessage = "اسم الموظف مطلوب.";
                return;
            }
            
            if (string.IsNullOrWhiteSpace(newEmployee.Password))
            {
                errorMessage = "كلمة المرور مطلوبة.";
                return;
            }
            
            // Check if employee ID already exists
            var existingEmployee = await Context.Employees
                .FirstOrDefaultAsync(e => e.EmployeeId == newEmployee.EmployeeId);
            
            if (existingEmployee != null)
            {
                errorMessage = "رقم الموظف موجود بالفعل. يرجى اختيار رقم آخر.";
                return;
            }

            // Set creation date
            newEmployee.CreatedAt = DateTime.Now;
            
            // Add new employee
            Context.Employees.Add(newEmployee);
            await Context.SaveChangesAsync();
            
            successMessage = "تم إضافة الموظف بنجاح.";
            await LoadEmployees();
            StateHasChanged();
            CloseAddEmployeeModal();
            
            // Clear the form
            newEmployee = new Employee();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding employee");
            errorMessage = "خطأ في إضافة الموظف. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            isAddingEmployee = false;
        }
    }

    private void EditEmployee(Employee employee)
    {
        editEmployee = new Employee
        {
            Id = employee.Id,
            EmployeeId = employee.EmployeeId,
            Name = employee.Name,
            Password = employee.Password,
            IsActive = employee.IsActive,
            CreatedAt = employee.CreatedAt
        };
        showEditEmployeeModal = true;
    }

    private async Task UpdateEmployee()
    {
        try
        {
            isEditingEmployee = true;
            
            // Check if employee ID already exists (excluding current employee)
            var existingEmployee = await Context.Employees
                .FirstOrDefaultAsync(e => e.EmployeeId == editEmployee.EmployeeId && e.Id != editEmployee.Id);
            
            if (existingEmployee != null)
            {
                errorMessage = "رقم الموظف موجود بالفعل. يرجى اختيار رقم آخر.";
                return;
            }

            // Update employee
            var employeeToUpdate = await Context.Employees.FindAsync(editEmployee.Id);
            if (employeeToUpdate != null)
            {
                employeeToUpdate.EmployeeId = editEmployee.EmployeeId;
                employeeToUpdate.Name = editEmployee.Name;
                
                // Only update password if it's not empty
                if (!string.IsNullOrEmpty(editEmployee.Password))
                {
                    employeeToUpdate.Password = editEmployee.Password;
                }
                
                employeeToUpdate.IsActive = editEmployee.IsActive;
                
                await Context.SaveChangesAsync();
                
                successMessage = "تم تحديث بيانات الموظف بنجاح.";
                await LoadEmployees();
                StateHasChanged();
                CloseEditEmployeeModal();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating employee");
            errorMessage = "خطأ في تحديث بيانات الموظف. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            isEditingEmployee = false;
        }
    }

    private void CloseEditEmployeeModal()
    {
        showEditEmployeeModal = false;
        editEmployee = new Employee();
    }

    private async Task DeleteEmployee(Employee employee)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"هل أنت متأكد من حذف الموظف {employee.Name}؟");
        if (confirmed)
        {
            try
            {
                Context.Employees.Remove(employee);
                await Context.SaveChangesAsync();
                successMessage = "تم حذف الموظف بنجاح.";
                await LoadEmployees();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting employee");
                errorMessage = "خطأ في حذف الموظف. يرجى المحاولة مرة أخرى.";
            }
        }
    }

