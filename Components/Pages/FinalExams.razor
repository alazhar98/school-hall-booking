        sb.Append($"<tr><td style='border:1px solid #000;padding:6px;font-weight:bold'>إجمالي المتغيبين</td><td style='border:1px solid #000;padding:6px;text-align:center;font-weight:bold'>{g8Regular + g8Daris}</td><td style='border:1px solid #000;padding:6px;text-align:center;font-weight:bold'>{g9Regular + g9Daris}</td><td style='border:1px solid #000;padding:6px;text-align:center;font-weight:bold'>{g10Regular + g10Daris}</td><td style='border:1px solid #000;padding:6px;text-align:center;font-weight:bold'>{totalAllAbsent}</td></tr>");
        sb.Append("</tbody></table>");
        sb.Append("</div>");

        // Part 2 - absentees
        sb.Append("<h4 style='margin:10px 0 6px 0'>ثانياً : أسماء المتغيبين:</h4>");
        sb.Append("<table style='width:100%;border-collapse:collapse;font-size:13px;margin-bottom:10px'>");
        sb.Append("<thead><tr><th style='border:1px solid #000;padding:6px;width:50px'>م</th><th style='border:1px solid #000;padding:6px'>الاسم</th><th style='border:1px solid #000;padding:6px;width:120px'>الصف</th><th style='border:1px solid #000;padding:6px;width:160px'>المادة</th><th style='border:1px solid #000;padding:6px;width:140px'>نظامي/دارس</th></tr></thead><tbody>");
        for (int i = 0; i < dailyAbsent.Count; i++)
        {
            var a = dailyAbsent[i];
            sb.Append($"<tr><td style='border:1px solid #000;padding:6px;text-align:center'>{i + 1}</td><td style='border:1px solid #000;padding:6px'>{System.Net.WebUtility.HtmlEncode(a.Name)}</td><td style='border:1px solid #000;padding:6px;text-align:center'>{System.Net.WebUtility.HtmlEncode(a.Class)}</td><td style='border:1px solid #000;padding:6px'>{System.Net.WebUtility.HtmlEncode(a.Subject)}</td><td style='border:1px solid #000;padding:6px;text-align:center'>{System.Net.WebUtility.HtmlEncode(a.Type)}</td></tr>");
        }
        // Footer totals for the absentees table (by grade and overall)
        sb.Append("</tbody>");
        sb.Append("<tfoot>");
        sb.Append($"<tr><td colspan='2' style='border:1px solid #000;padding:6px;font-weight:bold;text-align:right'>الإجمالي (الثامن)</td><td style='border:1px solid #000;padding:6px;text-align:center'>الثامن</td><td style='border:1px solid #000;padding:6px' colspan='2'>{g8Regular + g8Daris}</td></tr>");
        sb.Append($"<tr><td colspan='2' style='border:1px solid #000;padding:6px;font-weight:bold;text-align:right'>الإجمالي (التاسع)</td><td style='border:1px solid #000;padding:6px;text-align:center'>التاسع</td><td style='border:1px solid #000;padding:6px' colspan='2'>{g9Regular + g9Daris}</td></tr>");
        sb.Append($"<tr><td colspan='2' style='border:1px solid #000;padding:6px;font-weight:bold;text-align:right'>الإجمالي (العاشر)</td><td style='border:1px solid #000;padding:6px;text-align:center'>العاشر</td><td style='border:1px solid #000;padding:6px' colspan='2'>{g10Regular + g10Daris}</td></tr>");
