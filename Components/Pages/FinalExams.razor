        // المتغيبين (نظامي)
        var regAbsG8 = ToInt(regularAbsentG8);
        var regAbsG9 = ToInt(regularAbsentG9);
        var regAbsG10 = ToInt(regularAbsentG10);
        sb.Append($"<tr><td style='border:1px solid #000;padding:6px;font-weight:bold'>المتغيبين (نظامي)</td><td style='border:1px solid #000;padding:6px;text-align:center'>{regAbsG8}</td><td style='border:1px solid #000;padding:6px;text-align:center'>{regAbsG9}</td><td style='border:1px solid #000;padding:6px;text-align:center'>{regAbsG10}</td><td style='border:1px solid #000;padding:6px;text-align:center'>{regAbsG8 + regAbsG9 + regAbsG10}</td></tr>");
        // المتغيبين (دارس)
        var darAbsG8 = ToInt(darisAbsentG8);
        var darAbsG9 = ToInt(darisAbsentG9);
        var darAbsG10 = ToInt(darisAbsentG10);
        sb.Append($"<tr><td style='border:1px solid #000;padding:6px;font-weight:bold'>المتغيبين (دارس)</td><td style='border:1px solid #000;padding:6px;text-align:center'>{darAbsG8}</td><td style='border:1px solid #000;padding:6px;text-align:center'>{darAbsG9}</td><td style='border:1px solid #000;padding:6px;text-align:center'>{darAbsG10}</td><td style='border:1px solid #000;padding:6px;text-align:center'>{darAbsG8 + darAbsG9 + darAbsG10}</td></tr>");
        sb.Append("</tbody></table>");

