    private async Task LoadForm()
    {
        var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "finalExamsCommitteeForm");
        if (string.IsNullOrWhiteSpace(json)) return;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            academicYear = root.GetProperty("academicYear").GetString() ?? string.Empty;
            semester = root.GetProperty("semester").GetString() ?? "الأول";
            principalName = root.GetProperty("principalName").GetString() ?? principalName;

            committeeMembers = new();
            foreach (var el in root.GetProperty("committee").EnumerateArray())
            {
                committeeMembers.Add(new CommitteeMember
                {
                    Name = el.GetProperty("Name").GetString() ?? string.Empty,
                    Role = el.GetProperty("Role").GetString() ?? "عضو"
                });
            }

            portalSubcommittee = root.GetProperty("portal").EnumerateArray().Select(e => e.GetString() ?? string.Empty).ToList();
            busesSubcommittee = root.GetProperty("buses").EnumerateArray().Select(e => e.GetString() ?? string.Empty).ToList();
            regularitySubcommittee = root.GetProperty("regularity").EnumerateArray().Select(e => e.GetString() ?? string.Empty).ToList();
            hearingStudents = root.GetProperty("hearing").EnumerateArray().Select(e => e.GetString() ?? string.Empty).ToList();
        }
        catch { }
    }

