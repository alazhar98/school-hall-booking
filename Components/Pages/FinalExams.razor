        sb.Append("<div>6- اعتماد النتائج النهائية وإصدارها.</div>");
        sb.Append("<div>7- ما يستجد من أعمال.</div>");
        sb.Append("</div>");

        // Subcommittees
        sb.Append("<div style='margin-top:16px;margin-bottom:6px;font-weight:bold'>لجان فرعية:</div>");
        string RenderSimpleTable(string title, List<string> names)
        {
            var t = new System.Text.StringBuilder();
            t.Append($"<div style='margin-top:18px;'><div style='font-weight:bold;margin-bottom:6px'># {System.Net.WebUtility.HtmlEncode(title)}:</div>");
            t.Append("<table style='width:100%;border-collapse:collapse;font-size:13px;'><thead><tr><th style='border:1px solid #000;padding:6px;width:40px;'>م</th><th style='border:1px solid #000;padding:6px;'>الاسم</th><th style='border:1px solid #000;padding:6px;width:120px;'>التوقيع</th></tr></thead><tbody>");
            for (int i = 0; i < names.Count; i++)
            {
                var name = names[i];
                t.Append($"<tr><td style='border:1px solid #000;padding:6px;text-align:center'>{i + 1}</td><td style='border:1px solid #000;padding:6px'>{System.Net.WebUtility.HtmlEncode(name)}</td><td style='border:1px solid #000;padding:6px'></td></tr>");
            }
            t.Append("</tbody></table></div>");
            return t.ToString();
        }

        sb.Append(RenderSimpleTable("متابعة البوابة التعليمية", portalSubcommittee));
        sb.Append(RenderSimpleTable("متابعة حافلات الطلبة", busesSubcommittee));
