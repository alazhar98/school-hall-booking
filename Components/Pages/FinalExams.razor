    private string CreateSingleStudentHTML(int studentIndex)
    {
        if (studentIndex < 0 || studentIndex >= gradeStudents.Count) return string.Empty;
        
        var student = gradeStudents[studentIndex];
        var sb = new System.Text.StringBuilder();
        
        sb.Append("<div class='print-container' style='font-family:Tahoma,Arial;direction:rtl;color:#000;'>");
        sb.Append("<div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px;'><div style='text-align:center;line-height:1.5'><div>سلطنة عمان</div><div>وزارة التربية والتعليم</div><div style='margin-bottom:6px'>مدرسة الفضل بن العباس للتعليم الأساسي (٨-١٠)</div></div><img src='/images/logo.png' style='height:110px' onerror=\"this.style.display='none'\"/></div>");
        sb.Append("<h3 style='text-align:center;margin:10px 0;'>كشف درجات الدارسين</h3>");
        
        sb.Append($"<div style='margin:8px 0 4px 0;font-weight:bold'>اسم الدارس: {System.Net.WebUtility.HtmlEncode(student.Name)} &nbsp;&nbsp; الصف: {System.Net.WebUtility.HtmlEncode(student.Class)}</div>");
