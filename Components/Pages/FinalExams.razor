        sb.Append("</tfoot></table>");

        // Part 3 - notes
        sb.Append("<h4 style='margin:10px 0 6px 0'>ثالثاً: الملاحظات على الامتحان:</h4>");
        sb.Append($"<div>اكتمال الأوراق: {System.Net.WebUtility.HtmlEncode(dailyNotes.Papers)}</div>");
        sb.Append($"<div>وضوح التصوير: {System.Net.WebUtility.HtmlEncode(dailyNotes.Printing)}</div>");
        sb.Append($"<div>ملاحظات على أسئلة الامتحان:</div><div style='min-height:48px;border:1px dotted #999;margin:4px 0;padding:6px'>{System.Net.WebUtility.HtmlEncode(dailyNotes.Questions)}</div>");

        // Part 4 - visitors
        sb.Append("<h4 style='margin:10px 0 6px 0'>رابعاً: الزوار:</h4>");
        sb.Append("<table style='width:100%;border-collapse:collapse;font-size:13px;margin-bottom:10px'>");
        sb.Append("<thead><tr><th style='border:1px solid #000;padding:6px;width:50px'>م</th><th style='border:1px solid #000;padding:6px'>اسم الزائر</th><th style='border:1px solid #000;padding:6px;width:200px'>الوظيفة</th><th style='border:1px solid #000;padding:6px'>الملاحظات</th></tr></thead><tbody>");
