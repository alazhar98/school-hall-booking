    private async Task LoadEnvelopes()
    {
        var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "finalExamsOpenEnvelopesForm");
        if (string.IsNullOrWhiteSpace(json)) return;
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var model = System.Text.Json.JsonSerializer.Deserialize<OpenEnvelopesStorage>(json, opts);
            if (model is null) return;
            envelopesAcademicYear = model.envelopesAcademicYear ?? string.Empty;
            envelopesSemester = model.envelopesSemester ?? "الأول";
            envelopesRound = model.envelopesRound ?? string.Empty;
            envelopesDay = model.envelopesDay ?? string.Empty;
            envelopesDate = model.envelopesDate == default ? DateTime.Today : model.envelopesDate;
            envelopesTime = model.envelopesTime ?? string.Empty;
            envelopesLocation = model.envelopesLocation ?? string.Empty;
            envelopeRows = model.envelopeRows ?? new List<EnvelopeRow> { new EnvelopeRow() };
            envelopeAttendees = model.envelopeAttendees ?? new List<string>();
        }
        catch { }
    }

