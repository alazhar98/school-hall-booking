@page "/final-exams"
@page "/finalexams"
@using SchoolHallBooking.Services
@using SchoolHallBooking.Models
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
    </div>
}
else if (!isAuthenticated)
{
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>غير مصرح لك بالوصول</strong>
                    <br>
                    <small>يجب تسجيل الدخول أولاً للوصول إلى هذه الصفحة</small>
                    <br>
                    <a href="/school/login" class="btn btn-primary btn-sm mt-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        تسجيل الدخول
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-3">الامتحانات النهائية</h2>
            </div>
        </div>

        @if (activeSlide == 0)
        {
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card">
                        <div class="card-header text-center">
                            <h4 class="mb-0">اختر الفصل الدراسي</h4>
                        </div>
                        <div class="card-body text-center">
                            <p class="mb-4">يرجى اختيار الفصل الدراسي الذي تريد العمل عليه:</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <button class="btn btn-primary btn-lg w-100 py-4" @onclick="@(() => SelectSemester("الأول"))">
                                        <i class="bi bi-1-circle me-2"></i>
                                        الفصل الأول
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <button class="btn btn-success btn-lg w-100 py-4" @onclick="@(() => SelectSemester("الثاني"))">
                                        <i class="bi bi-2-circle me-2"></i>
                                        الفصل الثاني
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (activeSlide == 1)
        {
            <div class="row mb-3">
                <div class="col-12">
                    <div class="alert alert-info d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-calendar-check me-2"></i>
                            <strong>الفصل الدراسي المختار: @selectedSemester</strong>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenSlide(0)">
                            <i class="bi bi-arrow-left me-1"></i>
                            تغيير الفصل
                        </button>
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-4 col-lg-3">
                    <button class="btn btn-info w-100 py-3" @onclick="() => OpenSlide(2)">قرار تشكيل اللجنة</button>
                </div>
                <div class="col-md-4 col-lg-3">
                    <button class="btn btn-primary w-100 py-3" @onclick="() => OpenSlide(4)">التقرير اليومي</button>
                </div>
                <div class="col-md-4 col-lg-3">
                    <button class="btn btn-warning w-100 py-3" @onclick="() => OpenSlide(3)">فتح مغلفات</button>
                </div>
                <div class="col-md-4 col-lg-3">
                    <button class="btn btn-outline-primary w-100 py-3" @onclick="() => OpenSlide(7)">كشف متابعة الغياب</button>
                </div>
                <div class="col-md-4 col-lg-3">
                    <button class="btn btn-outline-info w-100 py-3" @onclick="() => OpenSlide(6)">كشف درجات</button>
                </div>
                <div class="col-md-4 col-lg-3">
                    <button class="btn btn-outline-secondary w-100 py-3" @onclick="() => OpenSlide(5)">كشف استلام أوراق</button>
                </div>
            </div>
        }
        else if (activeSlide == 2)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">قرار تشكيل لجنة الامتحانات</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveForm">حفظ البيانات</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintCommitteeDecision">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">العام الدراسي</label>
                            <InputText class="form-control" @bind-Value="academicYear" placeholder="مثال: 2024/2025" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">الفصل الدراسي</label>
                            <InputText class="form-control" @bind-Value="semester" placeholder="الأول / الثاني" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">مدير المدرسة</label>
                            <InputText class="form-control" @bind-Value="principalName" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">أعضاء اللجنة</label>
                        <div class="table-responsive">
                            <table class="table table-bordered text-center align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:90px;">م</th>
                                        <th>الاسم</th>
                                        <th style="width:180px;">الصفة</th>
                                        <th style="width:120px;">التوقيع</th>
                                        <th style="width:120px;">إجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < committeeMembers.Count; i++)
                                    {
                                        var idx = i;
                                        <tr>
                                            <td>@(idx + 1)</td>
                                            <td>
                                                <input class="form-control form-control-sm" value="@committeeMembers[idx].Name" @oninput="(e => committeeMembers[idx].Name = e.Value?.ToString() ?? string.Empty)" />
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm" @onchange="(e => committeeMembers[idx].Role = e.Value?.ToString() ?? string.Empty)" value="@committeeMembers[idx].Role">
                                                    <option>رئيس اللجنة</option>
                                                    <option>نائب الرئيس</option>
                                                    <option>عضو</option>
                                                    <option>الأشراف</option>
                                                    <option>الأمور الادارية</option>
                                                    <option>الصف التاسع</option>
                                                    <option>الصف الثامن</option>
                                                    <option>الصف العاشر</option>
                                                </select>
                                            </td>
                                            <td><input class="form-control form-control-sm" disabled /></td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveMember(idx))">حذف</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" @onclick="AddMember">+ إضافة عضو</button>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">لجنة فرعية: متابعة البوابة التعليمية</label>
                            <div class="table-responsive">
                                <table class="table table-bordered text-center align-middle">
                                    <thead class="table-light">
                                        <tr>
                                        <th style="width:70px;">م</th>
                                        <th>الاسم</th>
                                        <th style="width:120px;">التوقيع</th>
                                        <th style="width:120px;">إجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < portalSubcommittee.Count; i++)
                                        {
                                            var idx = i;
                                            <tr>
                                                <td>@(idx + 1)</td>
                                                <td><input class="form-control form-control-sm" value="@portalSubcommittee[idx]" @oninput="(e => portalSubcommittee[idx] = e.Value?.ToString() ?? string.Empty)" /></td>
                                                <td><input class="form-control form-control-sm" disabled /></td>
                                                <td><button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveFromList(portalSubcommittee, idx))">حذف</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => portalSubcommittee.Add(string.Empty)">+ إضافة</button>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">لجنة فرعية: متابعة حافلات الطلبة</label>
                            <div class="table-responsive">
                                <table class="table table-bordered text-center align-middle">
                                    <thead class="table-light">
                                        <tr>
                                        <th style="width:70px;">م</th>
                                        <th>الاسم</th>
                                        <th style="width:120px;">التوقيع</th>
                                        <th style="width:120px;">إجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < busesSubcommittee.Count; i++)
                                        {
                                            var idx = i;
                                            <tr>
                                                <td>@(idx + 1)</td>
                                                <td><input class="form-control form-control-sm" value="@busesSubcommittee[idx]" @oninput="(e => busesSubcommittee[idx] = e.Value?.ToString() ?? string.Empty)" /></td>
                                                <td><input class="form-control form-control-sm" disabled /></td>
                                                <td><button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveFromList(busesSubcommittee, idx))">حذف</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => busesSubcommittee.Add(string.Empty)">+ إضافة</button>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label">لجنة فرعية: متابعة انتظام الطلبة</label>
                            <div class="table-responsive">
                                <table class="table table-bordered text-center align-middle">
                                    <thead class="table-light">
                                    <tr>
                                        <th style="width:70px;">م</th>
                                        <th>الاسم</th>
                                        <th style="width:120px;">التوقيع</th>
                                        <th style="width:120px;">إجراءات</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < regularitySubcommittee.Count; i++)
                                        {
                                            var idx = i;
                                            <tr>
                                                <td>@(idx + 1)</td>
                                                <td><input class="form-control form-control-sm" value="@regularitySubcommittee[idx]" @oninput="(e => regularitySubcommittee[idx] = e.Value?.ToString() ?? string.Empty)" /></td>
                                                <td><input class="form-control form-control-sm" disabled /></td>
                                                <td><button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveFromList(regularitySubcommittee, idx))">حذف</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => regularitySubcommittee.Add(string.Empty)">+ إضافة</button>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">جدول طلبة الدمج السمعي</label>
                            <div class="table-responsive">
                                <table class="table table-bordered text-center align-middle">
                                    <thead class="table-light">
                                    <tr>
                                        <th style="width:70px;">م</th>
                                        <th>الاسم</th>
                                        <th style="width:120px;">إجراءات</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < hearingStudents.Count; i++)
                                        {
                                            var idx = i;
                                            <tr>
                                                <td>@(idx + 1)</td>
                                                <td><input class="form-control form-control-sm" value="@hearingStudents[idx]" @oninput="(e => hearingStudents[idx] = e.Value?.ToString() ?? string.Empty)" /></td>
                                                <td><button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveFromList(hearingStudents, idx))">حذف</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => hearingStudents.Add(string.Empty)">+ إضافة</button>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        }
        else if (activeSlide == 3)
        {
            <div class="card mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">فتح مغلفات الامتحانات</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveEnvelopes">حفظ البيانات</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintOpenEnvelopes">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">العام الدراسي</label>
                            <InputText class="form-control" @bind-Value="envelopesAcademicYear" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">الفصل الدراسي</label>
                            <InputText class="form-control" @bind-Value="envelopesSemester" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">الدور</label>
                            <InputText class="form-control" @bind-Value="envelopesRound" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">اليوم</label>
                            <InputText class="form-control" @bind-Value="envelopesDay" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">التاريخ</label>
                            <InputDate TValue="DateTime" class="form-control" @bind-Value="envelopesDate" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">الساعة</label>
                            <InputText class="form-control" @bind-Value="envelopesTime" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">الموقع</label>
                            <InputText class="form-control" @bind-Value="envelopesLocation" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">مواد وجداول الامتحان</label>
                        <div class="table-responsive">
                            <table class="table table-bordered text-center align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:140px;">الصف</th>
                                        <th>المادة</th>
                                        <th style="width:160px;">زمن الامتحان</th>
                                        <th style="width:120px;">إجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < envelopeRows.Count; i++)
                                    {
                                        var idx = i;
                                        <tr>
                                            <td>
                                                <select class="form-select form-select-sm" @onchange="(e => envelopeRows[idx].Grade = e.Value?.ToString() ?? string.Empty)" value="@envelopeRows[idx].Grade">
                                                    <option>الثامن</option>
                                                    <option>التاسع</option>
                                                    <option>العاشر</option>
                                                </select>
                                            </td>
                                            <td><input class="form-control form-control-sm" value="@envelopeRows[idx].Subject" @oninput="(e => envelopeRows[idx].Subject = e.Value?.ToString() ?? string.Empty)" /></td>
                                            <td><input class="form-control form-control-sm" value="@envelopeRows[idx].Duration" @oninput="(e => envelopeRows[idx].Duration = e.Value?.ToString() ?? string.Empty)" /></td>
                                            <td><button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveEnvelopeRow(idx))">حذف</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" @onclick="AddEnvelopeRow">+ إضافة صف</button>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">أسماء الحضور</label>
                        <div class="table-responsive">
                            <table class="table table-bordered text-center align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:70px;">م</th>
                                        <th>الاسم</th>
                                        <th style="width:140px;">التوقيع</th>
                                        <th style="width:120px;">إجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < envelopeAttendees.Count; i++)
                                    {
                                        var idx = i;
                                        <tr>
                                            <td>@(idx + 1)</td>
                                            <td><input class="form-control form-control-sm" value="@envelopeAttendees[idx]" @oninput="(e => envelopeAttendees[idx] = e.Value?.ToString() ?? string.Empty)" /></td>
                                            <td><input class="form-control form-control-sm" disabled /></td>
                                            <td><button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveFromList(envelopeAttendees, idx))">حذف</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => envelopeAttendees.Add(string.Empty)">+ إضافة</button>
                    </div>
                </div>
            </div>
        }
        else if (activeSlide == 4)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">التقرير اليومي عن سير أعمال امتحانات نهاية الفصل الدراسي</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveDaily">حفظ البيانات</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintDaily">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4"><label class="form-label">العام الدراسي</label><InputText class="form-control" @bind-Value="dailyAcademicYear" /></div>
                        <div class="col-md-4"><label class="form-label">الفصل</label><InputText class="form-control" @bind-Value="dailySemester" /></div>
                        <div class="col-md-4"><label class="form-label">الدور</label><InputText class="form-control" @bind-Value="dailyRound" /></div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4"><label class="form-label">اليوم</label><InputText class="form-control" @bind-Value="dailyDay" /></div>
                        <div class="col-md-4"><label class="form-label">التاريخ</label><InputDate TValue="DateTime" class="form-control" @bind-Value="dailyDate" /></div>
                    </div>

                    <h6 class="mt-2">أولاً: إعداد المتقدمين والناجحين</h6>
                    <div class="table-responsive mb-3">
                        <table class="table table-bordered text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>الصفوف</th>
                                    <th>الثامن</th>
                                    <th>التاسع</th>
                                    <th>العاشر</th>
                                    <th style="width:140px;">الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>إجمالي المتقدمين (نظامي)</strong></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@regularApplicantsG8" @oninput="@((ChangeEventArgs e) => { regularApplicantsG8 = e.Value?.ToString() ?? "0"; OnTotalChanged("RegularApplicantsG8", regularApplicantsG8); })" /></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@regularApplicantsG9" @oninput="@((ChangeEventArgs e) => { regularApplicantsG9 = e.Value?.ToString() ?? "0"; OnTotalChanged("RegularApplicantsG9", regularApplicantsG9); })" /></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@regularApplicantsG10" @oninput="@((ChangeEventArgs e) => { regularApplicantsG10 = e.Value?.ToString() ?? "0"; OnTotalChanged("RegularApplicantsG10", regularApplicantsG10); })" /></td>
                                    <td><input class="form-control form-control-sm" value="@ComputeRegularApplicants()" disabled /></td>
                                </tr>
                                <tr>
                                    <td><strong>إجمالي المتقدمين (دارس)</strong></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@darisApplicantsG8" @oninput="@((ChangeEventArgs e) => { darisApplicantsG8 = e.Value?.ToString() ?? "0"; OnTotalChanged("DarisApplicantsG8", darisApplicantsG8); })" /></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@darisApplicantsG9" @oninput="@((ChangeEventArgs e) => { darisApplicantsG9 = e.Value?.ToString() ?? "0"; OnTotalChanged("DarisApplicantsG9", darisApplicantsG9); })" /></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@darisApplicantsG10" @oninput="@((ChangeEventArgs e) => { darisApplicantsG10 = e.Value?.ToString() ?? "0"; OnTotalChanged("DarisApplicantsG10", darisApplicantsG10); })" /></td>
                                    <td><input class="form-control form-control-sm" value="@ComputeDarisApplicants()" disabled /></td>
                                </tr>
                                <tr>
                                    <td><strong>المتغيبين (نظامي)</strong></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@regularAbsentG8" @oninput="@((ChangeEventArgs e) => { regularAbsentG8 = e.Value?.ToString() ?? "0"; OnTotalChanged("RegularAbsentG8", regularAbsentG8); })" /></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@regularAbsentG9" @oninput="@((ChangeEventArgs e) => { regularAbsentG9 = e.Value?.ToString() ?? "0"; OnTotalChanged("RegularAbsentG9", regularAbsentG9); })" /></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@regularAbsentG10" @oninput="@((ChangeEventArgs e) => { regularAbsentG10 = e.Value?.ToString() ?? "0"; OnTotalChanged("RegularAbsentG10", regularAbsentG10); })" /></td>
                                    <td><input class="form-control form-control-sm" value="@ComputeRegularAbsent()" disabled /></td>
                                </tr>
                                <tr>
                                    <td><strong>المتغيبين (دارس)</strong></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@darisAbsentG8" @oninput="@((ChangeEventArgs e) => { darisAbsentG8 = e.Value?.ToString() ?? "0"; OnTotalChanged("DarisAbsentG8", darisAbsentG8); })" /></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@darisAbsentG9" @oninput="@((ChangeEventArgs e) => { darisAbsentG9 = e.Value?.ToString() ?? "0"; OnTotalChanged("DarisAbsentG9", darisAbsentG9); })" /></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@darisAbsentG10" @oninput="@((ChangeEventArgs e) => { darisAbsentG10 = e.Value?.ToString() ?? "0"; OnTotalChanged("DarisAbsentG10", darisAbsentG10); })" /></td>
                                    <td><input class="form-control form-control-sm" value="@ComputeDarisAbsent()" disabled /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h6>التعليم المدمج</h6>
                    <div class="table-responsive mb-2">
                        <table class="table table-bordered text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:160px;">الصف</th>
                                    <th>إجمالي المتقدمين (نظامي)</th>
                                    <th>المتغيبين (نظامي)</th>
                                    <th style="width:120px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < blendedEntries.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td><input class="form-control form-control-sm" value="@blendedEntries[idx].Grade" @oninput="@((ChangeEventArgs e) => { blendedEntries[idx].Grade = e.Value?.ToString() ?? string.Empty; })" /></td>
                                        <td><input type="number" class="form-control form-control-sm" value="@blendedEntries[idx].Applicants" @oninput="@((ChangeEventArgs e) => { blendedEntries[idx].Applicants = e.Value?.ToString() ?? "0"; })" /></td>
                                        <td><input type="number" class="form-control form-control-sm" value="@blendedEntries[idx].Absent" @oninput="@((ChangeEventArgs e) => { blendedEntries[idx].Absent = e.Value?.ToString() ?? "0"; })" /></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveBlendedEntry(idx))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>الإجمالي</th>
                                    <th><input class="form-control form-control-sm" value="@ComputeBlendedApplicants()" disabled /></th>
                                    <th><input class="form-control form-control-sm" value="@ComputeBlendedAbsentTotal()" disabled /></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="mb-3">
                        <button class="btn btn-sm btn-outline-primary" @onclick="AddBlendedEntry">+ إضافة صف</button>
                    </div>

                    <h6>ثانياً: أسماء المتغيبين</h6>
                    <div class="table-responsive mb-3">
                        <table class="table table-bordered text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">م</th>
                                    <th>الاسم</th>
                                    <th style="width:120px;">الصف</th>
                                    <th style="width:160px;">المادة</th>
                                    <th style="width:140px;">نظامي/دارس</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < dailyAbsent.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td>@(idx + 1)</td>
                                        <td><input class="form-control form-control-sm" value="@dailyAbsent[idx].Name" @oninput="(e => dailyAbsent[idx].Name = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@dailyAbsent[idx].Class" @oninput="(e => dailyAbsent[idx].Class = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@dailyAbsent[idx].Subject" @oninput="(e => dailyAbsent[idx].Subject = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td>
                                            <InputRadioGroup TValue="string" @bind-Value="dailyAbsent[idx].Type">
                                                <div class="d-flex gap-3 justify-content-center">
                                                    <div class="form-check d-flex align-items-center gap-1">
                                                        <InputRadio TValue="string" class="form-check-input" Value="@ValueTypeRegular" />
                                                        <span class="form-check-label">نظامي</span>
                                                    </div>
                                                    <div class="form-check d-flex align-items-center gap-1">
                                                        <InputRadio TValue="string" class="form-check-input" Value="@ValueTypeDaris" />
                                                        <span class="form-check-label">دارس</span>
                                                    </div>
                                                </div>
                                            </InputRadioGroup>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="d-flex gap-2 mb-3">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => dailyAbsent.Add(new DailyAbsent())">+ إضافة</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => { if (dailyAbsent.Count>0) dailyAbsent.RemoveAt(dailyAbsent.Count-1);} ">- حذف</button>
                        </div>
                    </div>

                    <h6>ثالثاً: الملاحظات على الامتحان</h6>
                    <div class="mb-3">
                        <div class="form-text mb-2">اكتمال الأوراق</div>
                        <InputRadioGroup TValue="string" @bind-Value="dailyNotes.Papers">
                            <div class="d-flex gap-3">
                                <div class="form-check d-flex align-items-center gap-1">
                                    <InputRadio TValue="string" class="form-check-input" Value="@ValuePapersComplete" />
                                    <span class="form-check-label">مكتملة</span>
                                </div>
                                <div class="form-check d-flex align-items-center gap-1">
                                    <InputRadio TValue="string" class="form-check-input" Value="@ValuePapersIncomplete" />
                                    <span class="form-check-label">غير مكتملة</span>
                                </div>
                            </div>
                        </InputRadioGroup>
                    </div>
                    <div class="mb-3">
                        <div class="form-text mb-2">وضوح التصوير</div>
                        <InputRadioGroup TValue="string" @bind-Value="dailyNotes.Printing">
                            <div class="d-flex gap-3">
                                <div class="form-check d-flex align-items-center gap-1">
                                    <InputRadio TValue="string" class="form-check-input" Value="@ValuePrintingClear" />
                                    <span class="form-check-label">واضحة</span>
                                </div>
                                <div class="form-check d-flex align-items-center gap-1">
                                    <InputRadio TValue="string" class="form-check-input" Value="@ValuePrintingNotClear" />
                                    <span class="form-check-label">غير واضحة</span>
                                </div>
                            </div>
                        </InputRadioGroup>
                    </div>
                    <div class="mb-3">
                        <div class="form-text">ملاحظات على أسئلة الامتحان</div>
                        <InputTextArea class="form-control" Rows="3" @bind-Value="dailyNotes.Questions" />
                    </div>

                    <h6>رابعاً: الزوار</h6>
                    <div class="table-responsive mb-3">
                        <table class="table table-bordered text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">م</th>
                                    <th>اسم الزائر</th>
                                    <th style="width:200px;">الوظيفة</th>
                                    <th>الملاحظات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < dailyVisitors.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td>@(idx + 1)</td>
                                        <td><input class="form-control form-control-sm" value="@dailyVisitors[idx].Name" @oninput="(e => dailyVisitors[idx].Name = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@dailyVisitors[idx].JobTitle" @oninput="(e => dailyVisitors[idx].JobTitle = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@dailyVisitors[idx].Notes" @oninput="(e => dailyVisitors[idx].Notes = e.Value?.ToString() ?? string.Empty)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => dailyVisitors.Add(new DailyVisitor())">+ إضافة</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => { if (dailyVisitors.Count>0) dailyVisitors.RemoveAt(dailyVisitors.Count-1);} ">- حذف</button>
                        </div>
                    </div>

                    <h6>خامساً: ملاحظات الزائر</h6>
                    <InputTextArea class="form-control mb-3" Rows="3" @bind-Value="dailyNotes.VisitorNotes" />

                    <h6>سادساً: ملاحظات أخرى</h6>
                    <InputTextArea class="form-control mb-3" Rows="3" @bind-Value="dailyNotes.Other" />

                    <div class="d-flex gap-2 mb-3">
                        <button class="btn btn-primary" @onclick="SaveDailyForm">حفظ البيانات</button>
                        <button class="btn btn-success" @onclick="PrintDailyReport">طباعة PDF</button>
                    </div>
                </div>
            </div>
        }
        else if (activeSlide == 5)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">كشف استلام أوراق الإجابات</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveReceive">حفظ البيانات</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="LoadReceive">استرجاع</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintReceive">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-3"><label class="form-label">العام الدراسي</label><InputText class="form-control" @bind-Value="receiveAcademicYear" /></div>
                        <div class="col-md-3"><label class="form-label">الفصل</label><InputText class="form-control" @bind-Value="receiveSemester" /></div>
                        <div class="col-md-3"><label class="form-label">الدور</label><InputText class="form-control" @bind-Value="receiveRound" /></div>
                        <div class="col-md-3"><label class="form-label">اليوم</label><InputText class="form-control" @bind-Value="receiveDay" /></div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-3"><label class="form-label">التاريخ</label><InputDate TValue="DateTime" class="form-control" @bind-Value="receiveDate" /></div>
                        <div class="col-md-9"><label class="form-label">ملاحظة</label><InputText class="form-control" @bind-Value="receiveNote" /></div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:90px;">الصف</th>
                                    <th>المادة</th>
                                    <th colspan="2">عدد الممتحنين</th>
                                    <th colspan="2">عدد المتغيبين</th>
                                    <th style="width:200px;">اسم المعلم</th>
                                    <th style="width:140px;">التوقيع</th>
                                    <th style="width:110px;">إجراءات</th>
                                </tr>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th>نظامي</th>
                                    <th>دارس</th>
                                    <th>نظامي</th>
                                    <th>دارس</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < receiveRows.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td><input class="form-control form-control-sm" value="@receiveRows[idx].Grade" @oninput="(e => receiveRows[idx].Grade = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@receiveRows[idx].Subject" @oninput="(e => receiveRows[idx].Subject = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input type="number" class="form-control form-control-sm" @bind-Value="receiveRows[idx].ExamineesRegular" @bind-Value:event="oninput" /></td>
                                        <td><input type="number" class="form-control form-control-sm" @bind-Value="receiveRows[idx].ExamineesDaris" @bind-Value:event="oninput" /></td>
                                        <td><input type="number" class="form-control form-control-sm" @bind-Value="receiveRows[idx].AbsentsRegular" @bind-Value:event="oninput" /></td>
                                        <td><input type="number" class="form-control form-control-sm" @bind-Value="receiveRows[idx].AbsentsDaris" @bind-Value:event="oninput" /></td>
                                        <td><input class="form-control form-control-sm" value="@receiveRows[idx].TeacherName" @oninput="(e => receiveRows[idx].TeacherName = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" disabled /></td>
                                        <td><button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveReceiveRow(idx))">حذف</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary" @onclick="AddReceiveRow">+ إضافة صف</button>
                    </div>
                </div>
            </div>
        }
        else if (activeSlide == 6)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">كشف درجات الدارسين</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveGrades">حفظ البيانات</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintGrades">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    @for (int s = 0; s < gradeStudents.Count; s++)
                    {
                        var sidx = s;
                        <div class="border rounded p-2 mb-3">
                            <div class="row g-2 mb-2">
                                <div class="col-md-3"><label class="form-label">اسم الدارس</label><input class="form-control" value="@gradeStudents[sidx].Name" @oninput="(e => gradeStudents[sidx].Name = e.Value?.ToString() ?? string.Empty)" /></div>
                                <div class="col-md-2"><label class="form-label">الصف</label><input class="form-control" value="@gradeStudents[sidx].Class" @oninput="(e => gradeStudents[sidx].Class = e.Value?.ToString() ?? string.Empty)" /></div>
                                <div class="col-md-3 d-flex align-items-end"><button class="btn btn-outline-danger" @onclick="(() => RemoveStudent(sidx))">حذف الدارس</button></div>
                                <div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-success" @onclick="(() => PrintSingleStudent(sidx))">طباعة</button></div>
                            </div>

                            <div class="table-responsive mb-2">
                                <table class="table table-bordered text-center align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:70px;">م</th>
                                            <th>المادة</th>
                                            <th style="width:140px;">الدرجة</th>
                                            <th style="width:120px;">إجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < gradeStudents[sidx].Grades.Count; i++)
                                        {
                                            var idx = i;
                                            <tr>
                                                <td>@(idx + 1)</td>
                                                <td><input class="form-control form-control-sm" value="@gradeStudents[sidx].Grades[idx].Subject" @oninput="(e => gradeStudents[sidx].Grades[idx].Subject = e.Value?.ToString() ?? string.Empty)" /></td>
                                                <td><input type="number" class="form-control form-control-sm" @bind-Value="gradeStudents[sidx].Grades[idx].Mark" @bind-Value:event="oninput" /></td>
                                                <td><button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveGradeRow(sidx, idx))">حذف</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" @onclick="(() => AddGradeRow(sidx))">+ إضافة مادة</button>
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddStudent">+ إضافة دارس</button>
                </div>
            </div>
        }
        else if (activeSlide == 7)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">كشوف متابعة الغياب</div>
                    <div>
                        <button class="btn btn-sm btn-outline-success me-2" @onclick="AddNewAbsenceSheet">+ إضافة كشف جديد</button>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveAllAbsenceSheets">حفظ جميع الكشوف</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="LoadAllAbsenceSheets">استرجاع</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintAllAbsenceSheets">طباعة جميع الكشوف PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    @if (absenceSheets.Count == 0)
                    {
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle me-2"></i>
                            لا توجد كشوف غياب. اضغط على "إضافة كشف جديد" لإنشاء كشف.
                        </div>
                    }
                    else
                    {
                        @foreach (var sheet in absenceSheets)
                        {
                            var isEditing = currentAbsenceSheet != null && currentAbsenceSheet.Id == sheet.Id;
                            <div class="card mb-3 @(isEditing ? "border-primary" : "")">
                                <div class="card-header d-flex justify-content-between align-items-center @(isEditing ? "bg-primary text-white" : "bg-light")">
                                    <div>
                                        <strong>كشف @sheet.Id:</strong> @sheet.Subject - @sheet.Class (@sheet.Day)
                                    </div>
                                    <div>
                                        @if (!isEditing)
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditAbsenceSheet(sheet)">تعديل</button>
                                            <button class="btn btn-sm btn-outline-info me-2" @onclick="() => PrintSingleAbsenceSheet(sheet)">طباعة</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAbsenceSheet(sheet.Id)">حذف</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light me-2" @onclick="SaveCurrentSheet">حفظ التعديلات</button>
                                            <button class="btn btn-sm btn-secondary" @onclick="CancelEditSheet">إلغاء</button>
                                        }
                                    </div>
                                </div>
                                @if (isEditing)
                                {
                                    <div class="card-body">
                                        <div class="row g-2 mb-3">
                                            <div class="col-md-3">
                                                <label class="form-label">اليوم</label>
                                                <InputText class="form-control" @bind-Value="currentAbsenceSheet.Day" placeholder="مثال: الاثنين" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">التاريخ</label>
                                                <InputDate class="form-control" @bind-Value="currentAbsenceSheet.Date" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">الصف</label>
                                                <InputText class="form-control" @bind-Value="currentAbsenceSheet.Class" placeholder="مثال: ثامن 1" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">المادة</label>
                                                <InputText class="form-control" @bind-Value="currentAbsenceSheet.Subject" placeholder="مثال: الرياضيات" />
                                            </div>
                                        </div>
                                        <div class="row g-2 mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label">إجمالي عدد الطلبة في الصف</label>
                                                <InputNumber class="form-control" @bind-Value="currentAbsenceSheet.TotalStudents" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">الغياب (محسوب تلقائياً)</label>
                                                <input type="number" class="form-control" value="@currentAbsenceSheet.Students.Count" readonly />
                                            </div>
                                        </div>

                                        <div class="table-responsive mb-3">
                                            <table class="table table-bordered text-center align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width:70px;">م</th>
                                                        <th>اسم الطالب</th>
                                                        <th style="width:120px;">إجراءات</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (int i = 0; i < currentAbsenceSheet.Students.Count; i++)
                                                    {
                                                        var idx = i;
                                                        <tr>
                                                            <td>@(idx + 1)</td>
                                                            <td><input class="form-control form-control-sm" value="@currentAbsenceSheet.Students[idx]" @oninput="(e => currentAbsenceSheet.Students[idx] = e.Value?.ToString() ?? string.Empty)" /></td>
                                                            <td><button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveStudentFromSheet(idx))">حذف</button></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary mb-3" @onclick="AddStudentToSheet">+ إضافة طالب</button>

                                        <div class="row g-2 mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label">التوقيع</label>
                                                <InputText class="form-control" @bind-Value="currentAbsenceSheet.Signature" placeholder="توقيع المعلم" disabled />
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="card-body">
                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <strong>التاريخ:</strong> @sheet.Date?.ToString("yyyy-MM-dd")
                                            </div>
                                            <div class="col-md-3">
                                                <strong>إجمالي الطلبة:</strong> @sheet.TotalStudents
                                            </div>
                                            <div class="col-md-3">
                                                <strong>الغياب:</strong> @sheet.AbsentStudents
                                            </div>
                                            <div class="col-md-3">
                                                <strong>عدد الطلبة الغائبين:</strong> @sheet.Students.Count
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private const string ValueTypeRegular = "نظامي";
    private const string ValueTypeDaris = "دارس";
    private const string ValuePapersComplete = "مكتملة";
    private const string ValuePapersIncomplete = "غير مكتملة";
    private const string ValuePrintingClear = "واضحة";
    private const string ValuePrintingNotClear = "غير واضحة";
    private bool isLoading = true;
