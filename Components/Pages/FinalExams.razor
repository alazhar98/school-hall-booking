    private async Task LoadDailyForm()
    {
        var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "finalExamsDailyForm");
        if (string.IsNullOrWhiteSpace(json)) return;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            dailyAcademicYear = root.GetProperty("dailyAcademicYear").GetString() ?? string.Empty;
            dailySemester = root.GetProperty("dailySemester").GetString() ?? "الأول";
            dailyRound = root.GetProperty("dailyRound").GetString() ?? string.Empty;
            dailyDay = root.GetProperty("dailyDay").GetString() ?? string.Empty;
            if (root.TryGetProperty("dailyDate", out var dateEl) && DateTime.TryParse(dateEl.GetString(), out var date))
                dailyDate = date;

            regularApplicantsG8 = root.GetProperty("regularApplicantsG8").GetString() ?? "0";
            regularApplicantsG9 = root.GetProperty("regularApplicantsG9").GetString() ?? "0";
            regularApplicantsG10 = root.GetProperty("regularApplicantsG10").GetString() ?? "0";
            darisApplicantsG8 = root.GetProperty("darisApplicantsG8").GetString() ?? "0";
            darisApplicantsG9 = root.GetProperty("darisApplicantsG9").GetString() ?? "0";
            darisApplicantsG10 = root.GetProperty("darisApplicantsG10").GetString() ?? "0";
            regularAbsentG8 = root.GetProperty("regularAbsentG8").GetString() ?? "0";
            regularAbsentG9 = root.GetProperty("regularAbsentG9").GetString() ?? "0";
            regularAbsentG10 = root.GetProperty("regularAbsentG10").GetString() ?? "0";
            darisAbsentG8 = root.GetProperty("darisAbsentG8").GetString() ?? "0";
            darisAbsentG9 = root.GetProperty("darisAbsentG9").GetString() ?? "0";
            darisAbsentG10 = root.GetProperty("darisAbsentG10").GetString() ?? "0";
            blendedEntries = new();
            if (root.TryGetProperty("blendedEntries", out var blendEl))
            {
                foreach (var el in blendEl.EnumerateArray())
                {
                    blendedEntries.Add(new BlendedEntry
                    {
                        Grade = el.GetProperty("Grade").GetString() ?? string.Empty,
                        Applicants = el.GetProperty("Applicants").GetString() ?? "0",
                        Absent = el.GetProperty("Absent").GetString() ?? "0"
                    });
                }
            }

            dailyAbsent = new();
            foreach (var el in root.GetProperty("dailyAbsent").EnumerateArray())
            {
                dailyAbsent.Add(new DailyAbsent
                {
                    Name = el.GetProperty("Name").GetString() ?? string.Empty,
                    Class = el.GetProperty("Class").GetString() ?? string.Empty,
                    Subject = el.GetProperty("Subject").GetString() ?? string.Empty,
                    Type = el.GetProperty("Type").GetString() ?? string.Empty
                });
            }

            dailyVisitors = new();
            foreach (var el in root.GetProperty("dailyVisitors").EnumerateArray())
            {
                dailyVisitors.Add(new DailyVisitor
                {
                    Name = el.GetProperty("Name").GetString() ?? string.Empty,
                    JobTitle = el.GetProperty("JobTitle").GetString() ?? string.Empty,
                    Notes = el.GetProperty("Notes").GetString() ?? string.Empty
                });
            }

            var notesEl = root.GetProperty("dailyNotes");
            dailyNotes = new DailyNotes
            {
                Papers = notesEl.GetProperty("Papers").GetString() ?? string.Empty,
                Printing = notesEl.GetProperty("Printing").GetString() ?? string.Empty,
                Questions = notesEl.GetProperty("Questions").GetString() ?? string.Empty,
                VisitorNotes = notesEl.GetProperty("VisitorNotes").GetString() ?? string.Empty,
                Other = notesEl.GetProperty("Other").GetString() ?? string.Empty
            };
            StateHasChanged();
        }
        catch { }
    }

