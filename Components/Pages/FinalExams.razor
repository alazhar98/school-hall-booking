        // Summary below counts: absentees by type (نظامي/دارس) per grade with totals
        int g8Regular = 0, g9Regular = 0, g10Regular = 0;
        int g8Daris = 0, g9Daris = 0, g10Daris = 0;
        foreach (var a in dailyAbsent)
        {
            var type = (a.Type ?? string.Empty).Trim();
            var cls = (a.Class ?? string.Empty).Trim();
            bool isRegular = type.Contains("نظام", StringComparison.OrdinalIgnoreCase);
            bool isDaris = type.Contains("دار", StringComparison.OrdinalIgnoreCase);
            if (cls.Contains("الثامن")) { if (isRegular) g8Regular++; if (isDaris) g8Daris++; }
            else if (cls.Contains("التاسع")) { if (isRegular) g9Regular++; if (isDaris) g9Daris++; }
            else if (cls.Contains("العاشر")) { if (isRegular) g10Regular++; if (isDaris) g10Daris++; }
        }
        int totalRegular = g8Regular + g9Regular + g10Regular;
        int totalDaris = g8Daris + g9Daris + g10Daris;
        int totalAllAbsent = totalRegular + totalDaris;

        sb.Append("<div style='margin:6px 0 10px 0'>");
        sb.Append("<div style='font-weight:bold;margin-bottom:4px'>ملخص المتغيبين (نظامي/دارس):</div>");
