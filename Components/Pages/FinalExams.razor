    private void OnCountsChanged(int index, string field, string newValue)
    {
        if (index < 0 || index >= dailyCountsRows.Count) return;
        var row = dailyCountsRows[index];
        switch (field)
        {
            case nameof(DailyCountRow.G8): row.G8 = newValue; break;
            case nameof(DailyCountRow.G9): row.G9 = newValue; break;
            case nameof(DailyCountRow.G10): row.G10 = newValue; break;
        }
        // keep stored Total in sync for saving, though UI uses computed
        row.Total = ComputeRowTotalString(row);
        StateHasChanged();
    }

    private static int ToInt(string? s)
    {
        return int.TryParse(s, out var v) ? v : 0;
    }

    private static string ComputeRowTotalString(DailyCountRow r)
    {
        var sum = ToInt(r.G8) + ToInt(r.G9) + ToInt(r.G10);
        return sum.ToString();
    }

