        foreach (var role in roleOrder)
        {
            var list = roleToMembers[role];
            int groupCount = list.Count;
            // First row with role cell
            sb.Append("<tr>");
            sb.Append($"<td style='border:1px solid #000;padding:6px;text-align:center'>{rowNumber}</td>");
