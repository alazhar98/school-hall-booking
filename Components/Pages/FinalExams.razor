    private async void OpenSlide(int slide) 
    {
        // التأكد من اختيار الفصل قبل فتح أي نموذج
        if (slide > 1 && string.IsNullOrEmpty(selectedSemester))
        {
            activeSlide = 0;
            return;
        }
        
        activeSlide = slide;
        
        // Auto-load data only for grades slide (slide 6)
        if (slide == 6)
        {
            await LoadGrades();
        }
        else if (slide == 4)
        {
            if (!hasLoadedDailyOnce)
            {
                await LoadDaily();
                hasLoadedDailyOnce = true;
            }
        }
    }

