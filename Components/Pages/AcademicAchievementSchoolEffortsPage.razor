@page "/academic-achievement/{subject}/school-efforts"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@inject IAcademicAchievementService AcademicAchievementService
@inject IJSRuntime JSRuntime
@inject ILogger<AcademicAchievementSchoolEffortsPage> Logger
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>توثيق جهود المدرسة - @SubjectName</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">توثيق جهود المدرسة - @SubjectName</h2>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-success" @onclick="ExportToPDF">
                <i class="bi bi-file-pdf"></i> PDF
            </button>
            <button class="btn btn-warning" @onclick="ExportToExcel">
                <i class="bi bi-file-excel"></i> Excel
            </button>
            <button class="btn btn-primary" @onclick="@(() => OpenAddModal())">
                <i class="bi bi-plus"></i> إضافة جهد مدرسي جديد
            </button>
            <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/academic-achievement"))">
                <i class="bi bi-arrow-right"></i> الرجوع
            </button>
        </div>
    </div>

    <!-- School Efforts Table -->
    <div class="card">
        <div class="card-body">
            @if (schoolEfforts.Any())
            {
                <div class="table-responsive">
                    <table id="school-efforts-table" class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>المادة</th>
                                <th>البرنامج أو الفعالية</th>
                                <th>النوع</th>
                                <th>الفئة المستهدفة</th>
                                <th>المنفذون</th>
                                <th>التاريخ</th>
                                <th>الملاحظات</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var effort in schoolEfforts)
                            {
                                <tr>
                                    <td>@effort.Subject</td>
                                    <td>@effort.ProgramOrActivity</td>
                                    <td>
                                        <span class="badge @GetTypeBadgeClass(effort.Type)">
                                            @effort.Type
                                        </span>
                                    </td>
                                    <td>@effort.TargetGroup</td>
                                    <td>@effort.Implementers</td>
                                    <td>@effort.Date?.ToString("yyyy-MM-dd")</td>
                                    <td>@(effort.Notes?.Length > 50 ? effort.Notes.Substring(0, 50) + "..." : effort.Notes)</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="@(() => EditEffort(effort))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteEffort(effort.Id))">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-building text-muted" style="font-size: 3rem;"></i>
                    <h5 class="text-muted mt-3">لا توجد جهود مدرسية مسجلة</h5>
                    <p class="text-muted">اضغط على "إضافة جهد مدرسي جديد" لبدء توثيق جهود المدرسة</p>
                </div>
            }
        </div>
    </div>

    <!-- Add/Edit Modal -->
    @if (showModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEditing ? "تعديل الجهد المدرسي" : "إضافة جهد مدرسي جديد")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="currentEffort" OnValidSubmit="SaveEffort">
                            <DataAnnotationsValidator />
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="subject" class="form-label">المادة *</label>
                                    <InputText id="subject" class="form-control" @bind-Value="currentEffort.Subject" placeholder="أدخل المادة" />
                                    <ValidationMessage For="@(() => currentEffort.Subject)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="programOrActivity" class="form-label">البرنامج أو الفعالية *</label>
                                    <InputText id="programOrActivity" class="form-control" @bind-Value="currentEffort.ProgramOrActivity" placeholder="أدخل البرنامج أو الفعالية" />
                                    <ValidationMessage For="@(() => currentEffort.ProgramOrActivity)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="type" class="form-label">النوع *</label>
                                    <InputSelect id="type" class="form-control" @bind-Value="currentEffort.Type">
                                        <option value="">اختر النوع</option>
                                        <option value="إثرائي">إثرائي</option>
                                        <option value="علاجي">علاجي</option>
                                        <option value="تطويري">تطويري</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => currentEffort.Type)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="targetGroup" class="form-label">الفئة المستهدفة *</label>
                                    <InputText id="targetGroup" class="form-control" @bind-Value="currentEffort.TargetGroup" placeholder="أدخل الفئة المستهدفة" />
                                    <ValidationMessage For="@(() => currentEffort.TargetGroup)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="implementers" class="form-label">المنفذون *</label>
                                    <InputText id="implementers" class="form-control" @bind-Value="currentEffort.Implementers" placeholder="أدخل المنفذون" />
                                    <ValidationMessage For="@(() => currentEffort.Implementers)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="date" class="form-label">التاريخ *</label>
                                    <InputDate id="date" class="form-control" @bind-Value="currentEffort.Date" TValue="DateTime?" />
                                    <ValidationMessage For="@(() => currentEffort.Date)" />
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="notes" class="form-label">الملاحظات</label>
                                    <InputTextArea id="notes" class="form-control" @bind-Value="currentEffort.Notes" placeholder="أدخل أي ملاحظات إضافية" rows="3" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">إلغاء</button>
                                <button type="submit" class="btn btn-primary">@(isEditing ? "تحديث" : "حفظ")</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Subject { get; set; } = string.Empty;

    private string SubjectName => Subject switch
    {
        "islamic-education" => "التربية الإسلامية",
        "arabic-language" => "اللغة العربية",
        "english-language" => "اللغة الإنجليزية",
        "mathematics" => "الرياضيات",
        "sciences" => "العلوم",
        "social-studies" => "الدراسات الاجتماعية",
        "management" => "الإدارة",
        _ => "غير محدد"
    };

    private List<AcademicAchievementSchoolEffort> schoolEfforts = new();
    private bool showModal = false;
    private bool isEditing = false;
    private AcademicAchievementSchoolEffort currentEffort = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSchoolEfforts();
    }

    private async Task LoadSchoolEfforts()
    {
        try
        {
            schoolEfforts = await AcademicAchievementService.GetSchoolEffortsBySubjectAsync(SubjectName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تحميل جهود المدرسة");
        }
    }

    private void OpenAddModal()
    {
        currentEffort = new AcademicAchievementSchoolEffort { Subject = string.Empty };
        isEditing = false;
        showModal = true;
    }

    private void EditEffort(AcademicAchievementSchoolEffort effort)
    {
        currentEffort = new AcademicAchievementSchoolEffort
        {
            Id = effort.Id,
            Subject = effort.Subject,
            ProgramOrActivity = effort.ProgramOrActivity,
            Type = effort.Type,
            TargetGroup = effort.TargetGroup,
            Implementers = effort.Implementers,
            Date = effort.Date,
            Notes = effort.Notes
        };
        isEditing = true;
        showModal = true;
    }

    private async Task SaveEffort()
    {
        try
        {
            currentEffort.Subject = SubjectName; // Set the subject before saving
            
            if (isEditing)
            {
                await AcademicAchievementService.UpdateSchoolEffortAsync(currentEffort);
            }
            else
            {
                await AcademicAchievementService.AddSchoolEffortAsync(currentEffort);
            }

            await LoadSchoolEfforts();
            CloseModal();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في حفظ الجهد المدرسي");
        }
    }

    private async Task DeleteEffort(int id)
    {
        try
        {
            if (await JSRuntime.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذا الجهد المدرسي؟"))
            {
                await AcademicAchievementService.DeleteSchoolEffortAsync(id);
                await LoadSchoolEfforts();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في حذف الجهد المدرسي");
        }
    }

    private async Task PrintEffort(AcademicAchievementSchoolEffort effort)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("printElement", $"effort-{effort.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في طباعة الجهد المدرسي");
        }
    }


    private string GetTypeBadgeClass(string type)
    {
        return type switch
        {
            "إثرائي" => "bg-success",
            "علاجي" => "bg-warning",
            "تطويري" => "bg-info",
            _ => "bg-secondary"
        };
    }

    private async Task ExportToPDF()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToPDF", "school-efforts-table", $"توثيق_جهود_المدرسة_{SubjectName}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تصدير PDF");
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToExcel", "school-efforts-table", $"توثيق_جهود_المدرسة_{SubjectName}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تصدير Excel");
        }
    }

    private void CloseModal()
    {
        showModal = false;
        currentEffort = new AcademicAchievementSchoolEffort();
        isEditing = false;
    }
}
