@page "/school-performance-development"
@using SchoolHallBooking.Services
@using SchoolHallBooking.Models
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
    </div>
}
else if (!isAuthenticated)
{
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>غير مصرح لك بالوصول</strong>
                    <br>
                    <small>يجب تسجيل الدخول أولاً للوصول إلى هذه الصفحة</small>
                    <br>
                    <a href="/school/login" class="btn btn-primary btn-sm mt-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        تسجيل الدخول
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <h2 class="mb-4">نظام تطوير الأداء المدرسي</h2>

        <!-- الشرائح العامة - تظهر دائماً في الصفحة الرئيسية -->
        <div class="card mb-4">
            <div class="card-header bg-light">الشرائح العامة</div>
            <div class="card-body d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary" @onclick='@(() => currentView = "team")'>فريق التطوير الذاتي</button>
                <button class="btn btn-outline-secondary" @onclick='@(() => currentView = "meetings")'>اجتماعات فريق المتابعة</button>
                <button class="btn btn-outline-secondary" @onclick='@(() => currentView = "directives")'>التعاميم الخاصة بالنظام</button>
                <button class="btn btn-outline-secondary" @onclick='@(() => currentView = "spdvisits")'>الزيارات الخاصة بالنظام</button>
            </div>
        </div>

        @if (activeSlide == 0)
        {
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card">
                        <div class="card-header text-center">
                            <h4 class="mb-0">اختر الفصل الدراسي</h4>
                        </div>
                        <div class="card-body text-center">
                            <p class="mb-4">يرجى اختيار الفصل الدراسي الذي تريد العمل عليه:</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <button class="btn btn-primary btn-lg w-100 py-4" @onclick="@(() => SelectSemester("الأول"))">
                                        <i class="bi bi-1-circle me-2"></i>
                                        الفصل الأول
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <button class="btn btn-success btn-lg w-100 py-4" @onclick="@(() => SelectSemester("الثاني"))">
                                        <i class="bi bi-2-circle me-2"></i>
                                        الفصل الثاني
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (activeSlide == 1)
        {
            <div class="row mb-3">
                <div class="col-12">
                    <div class="alert alert-info d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-calendar-check me-2"></i>
                            <strong>الفصل الدراسي المختار: @selectedSemester</strong>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenSlide(0)">
                            <i class="bi bi-arrow-left me-1"></i>
                            تغيير الفصل
                        </button>
                    </div>
                </div>
            </div>

            <!-- اختيار البرنامج/المجال -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">اختر البرنامج/المجال</div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var s in subjects)
                        {
                            <div class="col-6 col-md-3 d-grid">
                                <button class="btn btn-outline-primary" @onclick="(() => SelectSubject(s))">@s</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (activeSlide == 1 && !string.IsNullOrEmpty(selectedSubject))
        {
            <div class="card mb-4">
                <div class="card-header bg-info">خاصة بالمادة الدراسية</div>
                <div class="card-body d-flex gap-3 flex-wrap">
                    @if (selectedSubject != "الادارة")
                    {
                        <button class="btn btn-primary" @onclick='@(() => SelectSlide2("visit"))'>تحليل الزيارات</button>
                        <button class="btn btn-primary" @onclick='@(() => SelectSlide2("work"))'>تحليل أعمال الطلبة</button>
                    }
                    else
                    {
                        <button class="btn btn-warning" @onclick='@(() => SelectSlide2("admin"))'>الإدارة</button>
                    }
                </div>
            </div>
        }

        @if (activeSlide == 1 && currentView == "visit")
        {
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        تحليل الزيارة الإشرافية - @selectedSubject
                    </div>
                    <div>
                        <button class="btn btn-success me-2" @onclick="ExportVisitPDF">PDF</button>
                        <button class="btn btn-info" @onclick="ExportVisitExcel">Excel</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <button class="btn btn-outline-success" @onclick="OpenAddVisit">+ إضافة سجل</button>
                    </div>
                    @if (currentVisit != null && currentVisit.Subject == selectedSubject && (currentVisit.Id == 0 || visitItems.Contains(currentVisit)))
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentVisit.Strengths" />
                                <small class="text-muted">جوانب القوة</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentVisit.Enhancements" />
                                <small class="text-muted">جوانب التعزيز</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentVisit.FollowUpActions" />
                                <small class="text-muted">إجراءات المتابعة</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentVisit.DevelopmentPriorities" />
                                <small class="text-muted">أولويات التطوير</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentVisit.DevelopmentActions" />
                                <small class="text-muted">إجراءات التطوير</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentVisit.DevelopmentFollowUp" />
                                <small class="text-muted">إجراءات المتابعة للتطوير</small>
                            </div>
                            <div class="col-12 d-flex gap-2">
                                <button class="btn btn-success" @onclick="SaveVisit">حفظ</button>
                                <button class="btn btn-secondary" @onclick="CancelVisit">إلغاء</button>
                            </div>
                        </div>
                    }
                    <!-- الجدول الأول: جوانب القوة والتعزيز والمتابعة -->
                    <div class="table-responsive mb-4">
                        <table id="visit-table-1" class="table table-bordered text-center align-middle">
                            <thead class="table-primary">
                                <tr>
                                    <th>جوانب القوة</th>
                                    <th>جوانب التعزيز</th>
                                    <th>إجراءات المتابعة</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in visitItems)
                                {
                                    <tr>
                                        <td>@item.Strengths</td>
                                        <td>@item.Enhancements</td>
                                        <td>@item.FollowUpActions</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="(() => EditVisit(item))">تعديل</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => DeleteVisit(item.Id))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- الجدول الثاني: أولويات وإجراءات التطوير -->
                    <div class="table-responsive">
                        <table id="visit-table-2" class="table table-bordered text-center align-middle">
                            <thead class="table-success">
                                <tr>
                                    <th>أولويات التطوير</th>
                                    <th>إجراءات التطوير</th>
                                    <th>إجراءات المتابعة للتطوير</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in visitItems)
                                {
                                    <tr>
                                        <td>@item.DevelopmentPriorities</td>
                                        <td>@item.DevelopmentActions</td>
                                        <td>@item.DevelopmentFollowUp</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="(() => EditVisit(item))">تعديل</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => DeleteVisit(item.Id))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (activeSlide == 1 && currentView == "work")
        {
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        الشريحة 4: تحليل أعمال الطلبة - @selectedSubject
                    </div>
                    <div>
                        <button class="btn btn-success me-2" @onclick="ExportWorkPDF">PDF</button>
                        <button class="btn btn-info" @onclick="ExportWorkExcel">Excel</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <button class="btn btn-outline-success" @onclick="OpenAddWork">+ إضافة سجل</button>
                    </div>
                    @if (currentWork != null && currentWork.Subject == selectedSubject && (currentWork.Id == 0 || workItems.Contains(currentWork)))
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentWork.Strengths" />
                                <small class="text-muted">جوانب القوة</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentWork.Enhancements" />
                                <small class="text-muted">جوانب التعزيز</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentWork.FollowUpActions" />
                                <small class="text-muted">إجراءات المتابعة</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentWork.DevelopmentPriorities" />
                                <small class="text-muted">أولويات التطوير</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentWork.DevelopmentActions" />
                                <small class="text-muted">إجراءات التطوير</small>
                            </div>
                            <div class="col-md-4">
                                <InputTextArea class="form-control" @bind-Value="currentWork.DevelopmentFollowUp" />
                                <small class="text-muted">إجراءات المتابعة للتطوير</small>
                            </div>
                            <div class="col-12 d-flex gap-2">
                                <button class="btn btn-success" @onclick="SaveWork">حفظ</button>
                                <button class="btn btn-secondary" @onclick="CancelWork">إلغاء</button>
                            </div>
                        </div>
                    }
                    <!-- الجدول الأول: جوانب القوة والتعزيز والمتابعة -->
                    <div class="table-responsive mb-4">
                        <table id="work-table-1" class="table table-bordered text-center align-middle">
                            <thead class="table-primary">
                                <tr>
                                    <th>جوانب القوة</th>
                                    <th>جوانب التعزيز</th>
                                    <th>إجراءات المتابعة</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in workItems)
                                {
                                    <tr>
                                        <td>@item.Strengths</td>
                                        <td>@item.Enhancements</td>
                                        <td>@item.FollowUpActions</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="(() => EditWork(item))">تعديل</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => DeleteWork(item.Id))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- الجدول الثاني: أولويات وإجراءات التطوير -->
                    <div class="table-responsive">
                        <table id="work-table-2" class="table table-bordered text-center align-middle">
                            <thead class="table-success">
                                <tr>
                                    <th>أولويات التطوير</th>
                                    <th>إجراءات التطوير</th>
                                    <th>إجراءات المتابعة للتطوير</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in workItems)
                                {
                                    <tr>
                                        <td>@item.DevelopmentPriorities</td>
                                        <td>@item.DevelopmentActions</td>
                                        <td>@item.DevelopmentFollowUp</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="(() => EditWork(item))">تعديل</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => DeleteWork(item.Id))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (activeSlide == 1 && currentView == "admin")
        {
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">الشريحة 5: خاصة بالإدارة</div>
                <div class="card-body d-flex gap-3 flex-wrap">
                    <button class="btn btn-outline-primary" @onclick='@(() => adminView = "jobs")'>الوظائف الإدارية</button>
                    <button class="btn btn-outline-primary" @onclick='@(() => adminView = "students")'>آراء الطلبة</button>
                    <button class="btn btn-outline-primary" @onclick='@(() => adminView = "staff")'>آراء الهيئة</button>
                    <button class="btn btn-outline-primary" @onclick='@(() => adminView = "parents")'>آراء أولياء الأمور</button>
                </div>
            </div>

            @if (adminView == "jobs")
            {
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>تحليل الزيارة (الوظائف الإدارية والمساندة)</div>
                        <div>
                            <button class="btn btn-success me-2" @onclick='@(() => JSRuntime.InvokeVoidAsync("exportToPDF", "adminjobs-table", "تحليل_زيارة_الوظائف"))'>PDF</button>
                            <button class="btn btn-info" @onclick='@(() => JSRuntime.InvokeVoidAsync("exportToExcel", "adminjobs-table", "تحليل_زيارة_الوظائف"))'>Excel</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-2"><button class="btn btn-outline-success" @onclick='@(() => { currentJob = new AdminJobVisitAnalysis(); adminJobs.Insert(0,currentJob); })'>+ إضافة سجل</button></div>
                        @if (currentJob != null && (currentJob.Id == 0 || adminJobs.Contains(currentJob)))
                        {
                            <div class="row g-2 mb-3">
                                <div class="col-md-3"><InputText class="form-control" @bind-Value="currentJob.JobTitle" /><small class="text-muted">الوظيفة</small></div>
                                <div class="col-md-3"><InputTextArea class="form-control" @bind-Value="currentJob.Strengths" /><small class="text-muted">جوانب القوة</small></div>
                                <div class="col-md-3"><InputTextArea class="form-control" @bind-Value="currentJob.Enhancements" /><small class="text-muted">جوانب التعزيز</small></div>
                                <div class="col-md-3"><InputTextArea class="form-control" @bind-Value="currentJob.FollowUpActions" /><small class="text-muted">إجراءات المتابعة</small></div>
                                <div class="col-md-4"><InputTextArea class="form-control" @bind-Value="currentJob.DevelopmentPriorities" /><small class="text-muted">أولويات التطوير</small></div>
                                <div class="col-md-4"><InputTextArea class="form-control" @bind-Value="currentJob.DevelopmentActions" /><small class="text-muted">إجراءات التطوير</small></div>
                                <div class="col-md-4"><InputTextArea class="form-control" @bind-Value="currentJob.DevelopmentFollowUp" /><small class="text-muted">إجراءات المتابعة للتطوير</small></div>
                                <div class="col-12 d-flex gap-2">
                                    <button class="btn btn-success" @onclick="SaveAdminJob">حفظ</button>
                                    <button class="btn btn-secondary" @onclick='@(() => { currentJob = new(); StateHasChanged(); })'>إلغاء</button>
                                </div>
                            </div>
                        }
                        <div class="table-responsive">
                            <table id="adminjobs-table" class="table table-bordered text-center align-middle">
                                <thead>
                                    <tr>
                                        <th>الوظيفة</th><th>جوانب القوة</th><th>جوانب التعزيز</th><th>إجراءات المتابعة</th><th>أولويات التطوير</th><th>إجراءات التطوير</th><th>إجراءات المتابعة للتطوير</th><th>إجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var j in adminJobs)
                                {
                                    <tr>
                                        <td>@j.JobTitle</td><td>@j.Strengths</td><td>@j.Enhancements</td><td>@j.FollowUpActions</td><td>@j.DevelopmentPriorities</td><td>@j.DevelopmentActions</td><td>@j.DevelopmentFollowUp</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-2" @onclick='@(() => { currentJob = j; StateHasChanged(); })'>تعديل</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick='@(() => DeleteAdminJob(j.Id))'>حذف</button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (adminView == "students")
            {
                @* Slide 7 *@
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>تحليل استمارة آراء الطلبة</div>
                        <div>
                            <button class="btn btn-success me-2" @onclick='@(() => JSRuntime.InvokeVoidAsync("exportToPDF", "stopinions-table", "اراء_الطلبة"))'>PDF</button>
                            <button class="btn btn-info" @onclick='@(() => JSRuntime.InvokeVoidAsync("exportToExcel", "stopinions-table", "اراء_الطلبة"))'>Excel</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-2"><button class="btn btn-outline-success" @onclick='@(() => { currentStud = new StudentOpinionAnalysis(); studentOpinions.Insert(0,currentStud); })'>+ إضافة سجل</button></div>
                        @if (currentStud != null && (currentStud.Id == 0 || studentOpinions.Contains(currentStud)))
                        {
                            <div class="row g-2 mb-3">
                                <div class="col-md-4"><InputTextArea class="form-control" @bind-Value="currentStud.Strengths" /><small class="text-muted">جوانب القوة</small></div>
                                <div class="col-md-4"><InputTextArea class="form-control" @bind-Value="currentStud.Enhancements" /><small class="text-muted">جوانب التعزيز</small></div>
                                <div class="col-md-4"><InputTextArea class="form-control" @bind-Value="currentStud.FollowUpActions" /><small class="text-muted">إجراءات المتابعة</small></div>
                                <div class="col-md-6"><InputTextArea class="form-control" @bind-Value="currentStud.SummarySuggestions" /><small class="text-muted">أهم المقترحات</small></div>
                                <div class="col-md-6"><InputTextArea class="form-control" @bind-Value="currentStud.SummaryFollowUp" /><small class="text-muted">جوانب المتابعة</small></div>
                                <div class="col-12 d-flex gap-2">
                                    <button class="btn btn-success" @onclick="SaveStudentOpinion">حفظ</button>
                                    <button class="btn btn-secondary" @onclick='@(() => { currentStud = new(); StateHasChanged(); })'>إلغاء</button>
                                </div>
                            </div>
                        }
                        <div class="table-responsive">
                            <table id="stopinions-table" class="table table-bordered text-center align-middle">
                                <thead><tr><th>جوانب القوة</th><th>جوانب التعزيز</th><th>إجراءات المتابعة</th><th>أهم المقترحات</th><th>جوانب المتابعة</th><th>إجراءات</th></tr></thead>
                                <tbody>
                                @foreach (var r in studentOpinions)
                                {
                                    <tr>
                                        <td>@r.Strengths</td><td>@r.Enhancements</td><td>@r.FollowUpActions</td><td>@r.SummarySuggestions</td><td>@r.SummaryFollowUp</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-2" @onclick='@(() => { currentStud = r; StateHasChanged(); })'>تعديل</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick='@(() => DeleteStudentOpinion(r.Id))'>حذف</button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (adminView == "staff")
            {
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>تحليل آراء الهيئة التعليمية</div>
                        <div>
                            <button class="btn btn-success me-2" @onclick='@(() => JSRuntime.InvokeVoidAsync("exportToPDF", "staffopinions-table", "اراء_الهيئة"))'>PDF</button>
                            <button class="btn btn-info" @onclick='@(() => JSRuntime.InvokeVoidAsync("exportToExcel", "staffopinions-table", "اراء_الهيئة"))'>Excel</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-2"><button class="btn btn-outline-success" @onclick='@(() => { currentStaff = new StaffOpinionAnalysis(); staffOpinions.Insert(0,currentStaff); })'>+ إضافة سجل</button></div>
                        @if (currentStaff != null && (currentStaff.Id == 0 || staffOpinions.Contains(currentStaff)))
                        {
                            <div class="row g-2 mb-3">
