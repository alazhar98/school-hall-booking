@code {
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private readonly string[] subjects = new[] { "التربية الاسلامية", "اللغة العربية", "اللغة الانجليزية", "الرياضيات", "العلوم", "الدراسات الاجتماعية", "تقنية المعلومات والمهارات القربية", "الادارة" };
    private string selectedSubject = string.Empty;
    private string currentView = string.Empty; // "visit" or "work"
    private string adminView = string.Empty;   // jobs/students/staff/parents
    
    // متغيرات اختيار الفصل الدراسي
    private int activeSlide = 0; // 0 = اختيار الفصل، 1 = المحتوى الرئيسي
    private string selectedSemester = string.Empty;

    private List<SupervisoryVisitAnalysis> visitItems = new();
    private SupervisoryVisitAnalysis currentVisit = new();
    private List<StudentWorkAnalysis> workItems = new();
    private StudentWorkAnalysis currentWork = new();
    private List<AdminJobVisitAnalysis> adminJobs = new();
    private AdminJobVisitAnalysis currentJob = new();
    private List<StudentOpinionAnalysis> studentOpinions = new();
    private StudentOpinionAnalysis currentStud = new();
    private List<StaffOpinionAnalysis> staffOpinions = new();
    private StaffOpinionAnalysis currentStaff = new();
    private List<ParentsOpinionAnalysis> parentsOpinions = new();
    private ParentsOpinionAnalysis currentParent = new();

    private List<SPDImprovementTeamMember> improvementTeam = new();
    private SPDImprovementTeamMember currentTeam = new();
    private List<SPDFollowupMeeting> followupMeetings = new();
    private SPDFollowupMeeting currentMeeting = new();
    private List<SPDDirectiveRecord> directives = new();
    private SPDDirectiveRecord currentDirective = new();
    private List<SPDVisitRecord> spdVisits = new();
    private SPDVisitRecord currentSPDVisit = new();

    private const string GlobalSubject = "عام";
    private bool isSubjectEmpty => string.IsNullOrWhiteSpace(selectedSubject);
    private string DisplaySubject => string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (isAuthenticated)
            {
                await LoadSlidesDataAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking authentication: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectSemester(string semester)
    {
        selectedSemester = semester;
        activeSlide = 1; // الانتقال للمحتوى الرئيسي
    }

    private void OpenSlide(int slide)
    {
        activeSlide = slide;
        if (slide == 0)
        {
            selectedSemester = string.Empty;
            selectedSubject = string.Empty;
            currentView = string.Empty;
        }
    }

    private async void SelectSubject(string subject)
    {
        selectedSubject = subject;
        currentView = string.Empty;
    }

    private void SelectSlide2(string view)
    {
        currentView = view;
        _ = LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (string.IsNullOrEmpty(selectedSubject)) return;
        if (currentView == "visit")
        {
            visitItems = await Service.GetVisitAnalysesBySubjectAsync(selectedSubject);
        }
        else if (currentView == "work")
        {
            workItems = await Service.GetStudentWorkAnalysesBySubjectAsync(selectedSubject);
        }
        else if (currentView == "admin")
        {
            if (adminView == "jobs") adminJobs = await Service.GetAdminJobVisitsAsync();
            if (adminView == "students") studentOpinions = await Service.GetStudentOpinionsAsync();
            if (adminView == "staff") staffOpinions = await Service.GetStaffOpinionsAsync();
            if (adminView == "parents") parentsOpinions = await Service.GetParentsOpinionsAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSlidesDataAsync()
    {
        // تحميل بيانات الشرائح 10-13 العامة دائماً
        improvementTeam = await Service.GetImprovementTeamAsync(GlobalSubject);
        followupMeetings = await Service.GetFollowupMeetingsAsync(GlobalSubject);
        directives = await Service.GetDirectiveRecordsAsync(GlobalSubject);
        spdVisits = await Service.GetSPDVisitRecordsAsync(GlobalSubject);
        
        await InvokeAsync(StateHasChanged);
    }

    [Inject]
    private ISchoolPerformanceDevelopmentService Service { get; set; } = default!;

    private void OpenAddVisit()
    {
        currentVisit = new SupervisoryVisitAnalysis { Subject = selectedSubject };
        visitItems.Insert(0, currentVisit);
    }
    private async Task SaveVisit()
    {
        if (currentVisit.Id == 0)
            await Service.AddVisitAnalysisAsync(currentVisit);
        else
            await Service.UpdateVisitAnalysisAsync(currentVisit);
        await LoadDataAsync();
        currentVisit = new SupervisoryVisitAnalysis();
    }
    private Task CancelVisit()
    {
        currentVisit = new SupervisoryVisitAnalysis();
        return InvokeAsync(StateHasChanged);
    }
    private async Task EditVisit(SupervisoryVisitAnalysis item)
    {
        currentVisit = item;
        await InvokeAsync(StateHasChanged);
    }
    private async Task DeleteVisit(int id)
    {
        await Service.DeleteVisitAnalysisAsync(id);
        await LoadDataAsync();
    }

    private void OpenAddWork()
    {
        currentWork = new StudentWorkAnalysis { Subject = selectedSubject };
        workItems.Insert(0, currentWork);
    }
    private async Task SaveWork()
    {
        if (currentWork.Id == 0)
            await Service.AddStudentWorkAnalysisAsync(currentWork);
        else
            await Service.UpdateStudentWorkAnalysisAsync(currentWork);
        await LoadDataAsync();
        currentWork = new StudentWorkAnalysis();
    }
    private Task CancelWork()
    {
        currentWork = new StudentWorkAnalysis();
        return InvokeAsync(StateHasChanged);
    }
    private async Task EditWork(StudentWorkAnalysis item)
    {
        currentWork = item;
        await InvokeAsync(StateHasChanged);
    }
    private async Task DeleteWork(int id)
    {
        await Service.DeleteStudentWorkAnalysisAsync(id);
        await LoadDataAsync();
    }

    private async Task ExportVisitPDF()
    {
        await JSRuntime.InvokeVoidAsync("printHTML", GenerateVisitAnalysisHTML(), "تحليل_الزيارات");
