    private string GenerateVisitAnalysisHTML()
    {
        var html = $@"
        <!DOCTYPE html>
        <html dir='rtl' lang='ar'>
        <head>
            <meta charset='utf-8'>
            <title>تحليل الزيارة الإشرافية - {selectedSubject}</title>
            <style>
                body {{ font-family: Arial, sans-serif; margin: 20px; direction: rtl; }}
                .header {{ text-align: center; margin-bottom: 30px; }}
                .header h1 {{ color: #198754; font-size: 24px; margin-bottom: 10px; }}
                .table-container {{ margin-bottom: 30px; }}
                .table-title {{ font-weight: bold; font-size: 16px; margin-bottom: 10px; text-align: center; }}
                .table-title.first {{ color: #0d6efd; }}
                .table-title.second {{ color: #198754; }}
                table {{ width: 100%; border-collapse: collapse; margin-bottom: 20px; }}
                th {{ background-color: #f8f9fa; border: 1px solid #333; padding: 12px 8px; text-align: center; font-weight: bold; }}
                .table-primary th {{ background-color: #cfe2ff; }}
                .table-success th {{ background-color: #d1e7dd; }}
                td {{ border: 1px solid #333; padding: 12px 8px; text-align: center; }}
                .page-break {{ page-break-before: always; }}
            </style>
        </head>
        <body>
            <div class='header'>
                <h1>تحليل الزيارة الإشرافية - {selectedSubject}</h1>
            </div>

            <div class='table-container'>
                <div class='table-title first'>أهم المقترحات</div>
                <table class='table-primary'>
                    <thead>
                        <tr>
                            <th>جوانب القوة</th>
                            <th>جوانب التعزيز</th>
                            <th>إجراءات المتابعة</th>
                        </tr>
                    </thead>
                    <tbody>";

        foreach (var item in visitItems)
        {
            html += $@"
                        <tr>
                            <td>{item.Strengths}</td>
                            <td>{item.Enhancements}</td>
                            <td>{item.FollowUpActions}</td>
                        </tr>";
        }

        html += @"
                    </tbody>
                </table>
            </div>

            <div class='table-container'>
                <div class='table-title second'>جوانب المتابعة</div>
                <table class='table-success'>
                    <thead>
                        <tr>
                            <th>أولويات التطوير</th>
                            <th>إجراءات التطوير</th>
                            <th>إجراءات المتابعة للتطوير</th>
                        </tr>
                    </thead>
                    <tbody>";

        foreach (var item in visitItems)
        {
            html += $@"
                        <tr>
                            <td>{item.DevelopmentPriorities}</td>
                            <td>{item.DevelopmentActions}</td>
                            <td>{item.DevelopmentFollowUp}</td>
                        </tr>";
        }

        html += @"
                    </tbody>
                </table>
            </div>
        </body>
        </html>";

        return html;
    }

