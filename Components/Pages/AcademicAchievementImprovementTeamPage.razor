@page "/academic-achievement/improvement-team"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@inject IAcademicAchievementService AcademicAchievementService
@inject IJSRuntime JSRuntime
@inject ILogger<AcademicAchievementImprovementTeamPage> Logger
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>فريق التطوير الذاتي</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">فريق التطوير الذاتي</h2>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-success" @onclick="ExportToPDF">
                <i class="bi bi-file-pdf"></i> PDF
            </button>
            <button class="btn btn-warning" @onclick="ExportToExcel">
                <i class="bi bi-file-excel"></i> Excel
            </button>
            <button class="btn btn-primary" @onclick="@(() => OpenAddModal())">
                <i class="bi bi-plus"></i> إضافة عضو جديد
            </button>
            <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/academic-achievement"))">
                <i class="bi bi-arrow-right"></i> الرجوع
            </button>
        </div>
    </div>

    <!-- Team Members Table -->
    <div class="card">
        <div class="card-body">
            @if (teamMembers.Any())
            {
                <div class="table-responsive">
                    <table id="improvement-teams-table" class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>الاسم</th>
                                <th>الوظيفة</th>
                                <th>المهمة/الدور</th>
                                <th>الملاحظات</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in teamMembers)
                            {
                                <tr>
                                    <td>@member.Name</td>
                                    <td>@member.JobTitle</td>
                                    <td>@member.TaskOrRole</td>
                                    <td>@(member.Notes?.Length > 50 ? member.Notes.Substring(0, 50) + "..." : member.Notes)</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="@(() => EditMember(member))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteMember(member.Id))">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                    <h5 class="text-muted mt-3">لا توجد أعضاء في الفريق</h5>
                    <p class="text-muted">اضغط على "إضافة عضو جديد" لبدء إضافة أعضاء فريق التطوير الذاتي</p>
                </div>
            }
        </div>
    </div>

    <!-- Add/Edit Modal -->
    @if (showModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEditing ? "تعديل العضو" : "إضافة عضو جديد")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="currentMember" OnValidSubmit="SaveMember">
                            <DataAnnotationsValidator />
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="name" class="form-label">الاسم *</label>
                                    <InputText id="name" class="form-control" @bind-Value="currentMember.Name" placeholder="أدخل اسم العضو" />
                                    <ValidationMessage For="@(() => currentMember.Name)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="jobTitle" class="form-label">الوظيفة *</label>
                                    <InputText id="jobTitle" class="form-control" @bind-Value="currentMember.JobTitle" placeholder="أدخل الوظيفة" />
                                    <ValidationMessage For="@(() => currentMember.JobTitle)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="taskOrRole" class="form-label">المهمة/الدور *</label>
                                    <InputText id="taskOrRole" class="form-control" @bind-Value="currentMember.TaskOrRole" placeholder="أدخل المهمة أو الدور" />
                                    <ValidationMessage For="@(() => currentMember.TaskOrRole)" />
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="notes" class="form-label">الملاحظات</label>
                                    <InputTextArea id="notes" class="form-control" @bind-Value="currentMember.Notes" placeholder="أدخل أي ملاحظات إضافية" rows="3" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">إلغاء</button>
                                <button type="submit" class="btn btn-primary">@(isEditing ? "تحديث" : "حفظ")</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<AcademicAchievementImprovementTeam> teamMembers = new();
    private bool showModal = false;
    private bool isEditing = false;
    private AcademicAchievementImprovementTeam currentMember = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamMembers();
    }

    private async Task LoadTeamMembers()
    {
        try
        {
            teamMembers = await AcademicAchievementService.GetImprovementTeamMembersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تحميل أعضاء فريق التطوير الذاتي");
        }
    }

    private void OpenAddModal()
    {
        currentMember = new AcademicAchievementImprovementTeam();
        isEditing = false;
        showModal = true;
    }

    private void EditMember(AcademicAchievementImprovementTeam member)
    {
        currentMember = new AcademicAchievementImprovementTeam
        {
            Id = member.Id,
            Name = member.Name,
            JobTitle = member.JobTitle,
            TaskOrRole = member.TaskOrRole,
            Notes = member.Notes
        };
        isEditing = true;
        showModal = true;
    }

    private async Task SaveMember()
    {
        try
        {
            if (isEditing)
            {
                await AcademicAchievementService.UpdateImprovementTeamMemberAsync(currentMember);
            }
            else
            {
                await AcademicAchievementService.AddImprovementTeamMemberAsync(currentMember);
            }

            await LoadTeamMembers();
            CloseModal();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في حفظ عضو الفريق");
        }
    }

    private async Task DeleteMember(int id)
    {
        try
        {
            if (await JSRuntime.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذا العضو؟"))
            {
                await AcademicAchievementService.DeleteImprovementTeamMemberAsync(id);
                await LoadTeamMembers();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في حذف عضو الفريق");
        }
    }

    private async Task PrintTeam()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("printElement", "improvement-team-table");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في طباعة فريق التطوير الذاتي");
        }
    }


    private async Task ExportToPDF()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToPDF", "improvement-teams-table", "فريق_التحسين_والتطوير");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تصدير PDF");
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToExcel", "improvement-teams-table", "فريق_التحسين_والتطوير");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تصدير Excel");
        }
    }

    private void CloseModal()
    {
        showModal = false;
        currentMember = new AcademicAchievementImprovementTeam();
        isEditing = false;
    }
}
