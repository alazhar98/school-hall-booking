@page "/professional-development/final-evaluation"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@inject IProfessionalDevelopmentService ProfessionalDevelopmentService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<link href="~/css/evaluation-form.css" rel="stylesheet" />

<PageTitle>استمارة التقييم الختامي</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">استمارة تقييم ختامي لبرنامج تدريبي</h2>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-success" @onclick="PrintForm">
                <i class="bi bi-printer me-1"></i> طباعة النموذج
            </button>
            <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/professional-development"))">
                <i class="bi bi-arrow-right"></i> الرجوع
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <div id="evaluation-form" class="evaluation-form">
        <!-- Header Section -->
        <div class="form-header">
            <div class="header-logos">
                <div class="left-logo">
                    <div class="green-schools-logo">
                        <div class="leaf-icon">🌿</div>
                        <div class="logo-text">
                            <div class="arabic-text">المدارس الخضراء</div>
                            <div class="english-text">Green Schools</div>
                        </div>
                    </div>
                </div>
                <div class="center-content">
                    <div class="ministry-text">وزارة التربية والتعليم</div>
                    <div class="directorate-text">المديرية العامة للتربية والتعليم لمحافظة جنوب الباطنة.</div>
                    <div class="school-text">مدرسة الفضل بن العباس للتعليم الأساسي ( 8 - 10)</div>
                    <div class="form-title-text">استمارة تقييم ختامي لبرنامج تدريبي</div>
                </div>
                <div class="right-logo">
                    <div class="moe-logo">
                        <div class="emblem">🏛️</div>
                        <div class="logo-text">وزارة التربية والتعليم</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- General Information Section -->
        <div class="section">
            <h4 class="section-title">البيانات العامة</h4>
            <div class="general-info-grid">
                <div class="info-row">
                    <div class="info-item">
                        <label class="info-label">المسمى الوظيفي:</label>
                        <div class="job-title-section">
                            <div class="job-option">
                                <input type="radio" name="jobTitle" id="administrative" @onchange="() => OnJobTitleChange(administrativeRole)">
                                <label for="administrative">إداري :</label>
                                <input type="text" class="job-title-input" value="@administrative" @oninput="OnAdministrativeInputChange" placeholder="حدد الإداري" style="display: none;" id="administrativeInput">
                            </div>
                            <div class="job-option">
                                <input type="radio" name="jobTitle" id="teacher" @onchange="() => OnJobTitleChange(teacherRole)">
                                <label for="teacher">معلم :</label>
                                <input type="text" class="job-title-input" value="@teacher" @oninput="OnTeacherInputChange" placeholder="حدد المعلم" style="display: none;" id="teacherInput">
                            </div>
                            <div class="job-option">
                                <input type="radio" name="jobTitle" id="relatedFunctions" @onchange="() => OnJobTitleChange(relatedFunctionsRole)">
                                <label for="relatedFunctions">وظائف مرتبطة :</label>
                                <input type="text" class="job-title-input" value="@relatedFunctionsInput" @oninput="OnRelatedFunctionsInputChange" placeholder="حدد الوظائف المرتبطة" style="display: none;" id="relatedFunctionsInput">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-item">
                        <label class="info-label">المؤهل العلمي:</label>
                        <div class="qualification-options">
                            <input type="radio" name="qualification" id="diploma" @onchange="() => { evaluation.EducationalQualification = diploma; StateHasChanged(); }">
                            <label for="diploma">دبلوم</label>
                            
                            <input type="radio" name="qualification" id="bachelor" @onchange="() => { evaluation.EducationalQualification = bachelor; StateHasChanged(); }">
                            <label for="bachelor">بكالوريوس</label>
                            
                            <input type="radio" name="qualification" id="master" @onchange="() => { evaluation.EducationalQualification = master; StateHasChanged(); }">
                            <label for="master">ماجستير</label>
                            
                            <input type="radio" name="qualification" id="phd" @onchange="() => { evaluation.EducationalQualification = phd; StateHasChanged(); }">
                            <label for="phd">دكتوراه</label>
                        </div>
                    </div>
                    
                    <div class="info-item">
                        <label class="info-label">عنوان البرنامج:</label>
                        <input type="text" class="program-title-input" @bind="evaluation.ProgramTitle" placeholder="عنوان البرنامج">
                    </div>
                    
                    <div class="info-item">
                        <label class="info-label">المادة:</label>
                        <select class="subject-select" @bind="evaluation.Subject">
                            <option value="">اختر المادة</option>
                            <option value="التربية الاسلامية">التربية الاسلامية</option>
                            <option value="اللغة العربية">اللغة العربية</option>
                            <option value="اللغة الانجليزية">اللغة الانجليزية</option>
                            <option value="الرياضيات">الرياضيات</option>
                            <option value="العلوم">العلوم</option>
                            <option value="الدراسات الاجتماعية">الدراسات الاجتماعية</option>
                            <option value="تقنية المعلومات والمهارات الفردية">تقنية المعلومات والمهارات الفردية</option>
                            <option value="الادارة والوظائف المساندة">الادارة والوظائف المساندة</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Evaluation Section -->
        <div class="section">
            <h4 class="section-title">ضع علامة ( √ ) أمام الخيار الذي تراه مناسبا لكل بند من البنود التالية :</h4>
            <div class="table-responsive">
                <table class="table table-bordered evaluation-table">
                    <thead>
                        <tr>
                            <th rowspan="2" style="width: 5%;">م</th>
                            <th rowspan="2" style="width: 45%;">بنود التقييم</th>
                            <th colspan="5" style="width: 40%;">مستوى التقييم</th>
                            <th rowspan="2" style="width: 10%;">المجموع الكلي لكل محور</th>
                        </tr>
                        <tr>
                            <th style="width: 8%;">1<br />ضعيف</th>
                            <th style="width: 8%;">2<br />مقبول</th>
                            <th style="width: 8%;">3<br />جيد</th>
                            <th style="width: 8%;">4<br />جيد جدا</th>
                            <th style="width: 8%;">5<br />ممتاز</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- التنظيم الإداري -->
                        <tr class="category-row">
                            <td colspan="8" class="category-header">التنظيم الإداري</td>
                        </tr>
                        <tr>
                            <td>1</td>
                            <td class="text-end">ملاءمة تاريخ عقد البرنامج</td>
                            <td><input type="radio" name="dateSuitability" value="1" @onchange="() => { evaluation.ProgramDateSuitability = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="dateSuitability" value="2" @onchange="() => { evaluation.ProgramDateSuitability = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="dateSuitability" value="3" @onchange="() => { evaluation.ProgramDateSuitability = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="dateSuitability" value="4" @onchange="() => { evaluation.ProgramDateSuitability = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="dateSuitability" value="5" @onchange="() => { evaluation.ProgramDateSuitability = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td class="text-end">ملاءمة القاعة التدريبية</td>
                            <td><input type="radio" name="roomSuitability" value="1" @onchange="() => { evaluation.TrainingRoomSuitability = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="roomSuitability" value="2" @onchange="() => { evaluation.TrainingRoomSuitability = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="roomSuitability" value="3" @onchange="() => { evaluation.TrainingRoomSuitability = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="roomSuitability" value="4" @onchange="() => { evaluation.TrainingRoomSuitability = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="roomSuitability" value="5" @onchange="() => { evaluation.TrainingRoomSuitability = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td class="text-end">الدعم والمساندة من القائمين على البرنامج</td>
                            <td><input type="radio" name="support" value="1" @onchange="() => { evaluation.SupportFromProgramStaff = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="support" value="2" @onchange="() => { evaluation.SupportFromProgramStaff = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="support" value="3" @onchange="() => { evaluation.SupportFromProgramStaff = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="support" value="4" @onchange="() => { evaluation.SupportFromProgramStaff = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="support" value="5" @onchange="() => { evaluation.SupportFromProgramStaff = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <!-- صف المجموع للتنظيم الإداري -->
                        <tr class="total-row">
                            <td colspan="6" class="text-end"><strong>مجموع التنظيم الإداري:</strong></td>
                            <td colspan="2"><strong>@administrativeTotal</strong></td>
                        </tr>

                        <!-- المادة التدريبية -->
                        <tr class="category-row">
                            <td colspan="8" class="category-header">المادة التدريبية</td>
                        </tr>
                        <tr>
                            <td>4</td>
                            <td class="text-end">تسهم في تطوير مهامي الوظيفية الحالية.</td>
                            <td><input type="radio" name="contributesToJob" value="1" @onchange="() => { evaluation.ContributesToCurrentJob = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="contributesToJob" value="2" @onchange="() => { evaluation.ContributesToCurrentJob = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="contributesToJob" value="3" @onchange="() => { evaluation.ContributesToCurrentJob = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="contributesToJob" value="4" @onchange="() => { evaluation.ContributesToCurrentJob = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="contributesToJob" value="5" @onchange="() => { evaluation.ContributesToCurrentJob = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>5</td>
                            <td class="text-end">تحقق توقعاتي الشخصية</td>
                            <td><input type="radio" name="meetsExpectations" value="1" @onchange="() => { evaluation.MeetsPersonalExpectations = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="meetsExpectations" value="2" @onchange="() => { evaluation.MeetsPersonalExpectations = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="meetsExpectations" value="3" @onchange="() => { evaluation.MeetsPersonalExpectations = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="meetsExpectations" value="4" @onchange="() => { evaluation.MeetsPersonalExpectations = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="meetsExpectations" value="5" @onchange="() => { evaluation.MeetsPersonalExpectations = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>6</td>
                            <td class="text-end">مناسبة الموضوعات لمستويات المشاركين</td>
                            <td><input type="radio" name="topicsSuitable" value="1" @onchange="() => { evaluation.TopicsSuitableForParticipants = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="topicsSuitable" value="2" @onchange="() => { evaluation.TopicsSuitableForParticipants = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="topicsSuitable" value="3" @onchange="() => { evaluation.TopicsSuitableForParticipants = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="topicsSuitable" value="4" @onchange="() => { evaluation.TopicsSuitableForParticipants = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="topicsSuitable" value="5" @onchange="() => { evaluation.TopicsSuitableForParticipants = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>7</td>
                            <td class="text-end">كفاية المادة التدريبية و الانشطة المقدمة</td>
                            <td><input type="radio" name="materialAdequacy" value="1" @onchange="() => { evaluation.TrainingMaterialAdequacy = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="materialAdequacy" value="2" @onchange="() => { evaluation.TrainingMaterialAdequacy = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="materialAdequacy" value="3" @onchange="() => { evaluation.TrainingMaterialAdequacy = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="materialAdequacy" value="4" @onchange="() => { evaluation.TrainingMaterialAdequacy = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="materialAdequacy" value="5" @onchange="() => { evaluation.TrainingMaterialAdequacy = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>8</td>
                            <td class="text-end">توافق الانشطة التدريبية مع الموضوع</td>
                            <td><input type="radio" name="activitiesMatch" value="1" @onchange="() => { evaluation.ActivitiesMatchTopics = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="activitiesMatch" value="2" @onchange="() => { evaluation.ActivitiesMatchTopics = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="activitiesMatch" value="3" @onchange="() => { evaluation.ActivitiesMatchTopics = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="activitiesMatch" value="4" @onchange="() => { evaluation.ActivitiesMatchTopics = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="activitiesMatch" value="5" @onchange="() => { evaluation.ActivitiesMatchTopics = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <!-- صف المجموع للمادة التدريبية -->
                        <tr class="total-row">
                            <td colspan="6" class="text-end"><strong>مجموع المادة التدريبية:</strong></td>
                            <td colspan="2"><strong>@trainingMaterialTotal</strong></td>
                        </tr>

                        <!-- المدرب -->
                        <tr class="category-row">
                            <td colspan="8" class="category-header">المدرب</td>
                        </tr>
                        <tr>
                            <td>9</td>
                            <td class="text-end">التمكن من المادة التدريبية</td>
                            <td><input type="radio" name="trainerMastery" value="1" @onchange="() => { evaluation.TrainerMasteryOfMaterial = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerMastery" value="2" @onchange="() => { evaluation.TrainerMasteryOfMaterial = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerMastery" value="3" @onchange="() => { evaluation.TrainerMasteryOfMaterial = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerMastery" value="4" @onchange="() => { evaluation.TrainerMasteryOfMaterial = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerMastery" value="5" @onchange="() => { evaluation.TrainerMasteryOfMaterial = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>10</td>
                            <td class="text-end">التفاعل مع المشاركين</td>
                            <td><input type="radio" name="trainerInteraction" value="1" @onchange="() => { evaluation.TrainerInteractionWithParticipants = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerInteraction" value="2" @onchange="() => { evaluation.TrainerInteractionWithParticipants = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerInteraction" value="3" @onchange="() => { evaluation.TrainerInteractionWithParticipants = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerInteraction" value="4" @onchange="() => { evaluation.TrainerInteractionWithParticipants = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerInteraction" value="5" @onchange="() => { evaluation.TrainerInteractionWithParticipants = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>11</td>
                            <td class="text-end">القدرة على توصيل المعلومة</td>
                            <td><input type="radio" name="trainerConveying" value="1" @onchange="() => { evaluation.TrainerAbilityToConveyInformation = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerConveying" value="2" @onchange="() => { evaluation.TrainerAbilityToConveyInformation = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerConveying" value="3" @onchange="() => { evaluation.TrainerAbilityToConveyInformation = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerConveying" value="4" @onchange="() => { evaluation.TrainerAbilityToConveyInformation = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="trainerConveying" value="5" @onchange="() => { evaluation.TrainerAbilityToConveyInformation = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>12</td>
                            <td class="text-end">الجمع بين الجانب النظري و العملي</td>
                            <td><input type="radio" name="theoryPractice" value="1" @onchange="() => { evaluation.CombiningTheoryAndPractice = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="theoryPractice" value="2" @onchange="() => { evaluation.CombiningTheoryAndPractice = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="theoryPractice" value="3" @onchange="() => { evaluation.CombiningTheoryAndPractice = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="theoryPractice" value="4" @onchange="() => { evaluation.CombiningTheoryAndPractice = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="theoryPractice" value="5" @onchange="() => { evaluation.CombiningTheoryAndPractice = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>13</td>
                            <td class="text-end">الالتزام بموضوعات التدريب</td>
                            <td><input type="radio" name="commitment" value="1" @onchange="() => { evaluation.CommitmentToTrainingTopics = 1; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="commitment" value="2" @onchange="() => { evaluation.CommitmentToTrainingTopics = 2; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="commitment" value="3" @onchange="() => { evaluation.CommitmentToTrainingTopics = 3; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="commitment" value="4" @onchange="() => { evaluation.CommitmentToTrainingTopics = 4; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td><input type="radio" name="commitment" value="5" @onchange="() => { evaluation.CommitmentToTrainingTopics = 5; CalculateAllTotals(); StateHasChanged(); }"></td>
                            <td></td>
                        </tr>
                        <!-- صف المجموع للمدرب -->
                        <tr class="total-row">
                            <td colspan="6" class="text-end"><strong>مجموع المدرب:</strong></td>
                            <td colspan="2"><strong>@trainerTotal</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Learning Level Section -->
        <div class="section">
            <h4 class="section-title">مستوى التعلم .</h4>
            <p class="section-description">
                إن مشاركتك في البرنامج لا تعني عدم وجود أي معارف أو مهارات سابقة في موضوع البرنامج. لذلك أخي المتدرب نود أن نعرف هل أضاف لك البرنامج معارف ومهارات جديدة، ويرجى تحديد مستواك فيما يأتي قبل البرنامج وبعده .
            </p>
            <div class="table-responsive">
                <table class="table table-bordered learning-table">
                    <thead>
                        <tr>
                            <th style="width: 5%;">م</th>
                            <th style="width: 35%;">المعارف والمهارات المكتسبة</th>
                            <th colspan="3" style="width: 30%;">قبل البرنامج</th>
                            <th colspan="3" style="width: 30%;">بعد البرنامج</th>
                        </tr>
                        <tr>
                            <th></th>
                            <th></th>
                            <th>عالية</th>
                            <th>متوسطة</th>
                            <th>متدنية</th>
                            <th>عالية</th>
                            <th>متوسطة</th>
                            <th>متدنية</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td class="text-end">المعارف</td>
                            <td><input type="radio" name="knowledgeBefore" value="عالية" @onchange="() => evaluation.KnowledgeBeforeProgram = highLevel"></td>
                            <td><input type="radio" name="knowledgeBefore" value="متوسطة" @onchange="() => evaluation.KnowledgeBeforeProgram = mediumLevel"></td>
                            <td><input type="radio" name="knowledgeBefore" value="متدنية" @onchange="() => evaluation.KnowledgeBeforeProgram = lowLevel"></td>
                            <td><input type="radio" name="knowledgeAfter" value="عالية" @onchange="() => evaluation.KnowledgeAfterProgram = highLevel"></td>
