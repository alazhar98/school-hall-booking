@code {
    private FinalEvaluation evaluation = new();
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    
    // Job title variables
    private string administrative = string.Empty;
    private string teacher = string.Empty;
    private string relatedFunctionsInput = string.Empty;
    private string selectedJobType = string.Empty;
    
    // Calculation variables
    private int administrativeTotal = 0;
    private int trainingMaterialTotal = 0;
    private int trainerTotal = 0;
    
    // Constants for form values
    private readonly string diploma = "دبلوم";
    private readonly string bachelor = "بكالوريوس";
    private readonly string master = "ماجستير";
    private readonly string phd = "دكتوراه";
    private readonly string highLevel = "عالية";
    private readonly string mediumLevel = "متوسطة";
    private readonly string lowLevel = "متدنية";
    private readonly string administrativeRole = "إداري";
    private readonly string teacherRole = "معلم";
    private readonly string relatedFunctionsRole = "وظائف مرتبطة";

    protected override void OnInitialized()
    {
        evaluation.EvaluationDate = DateTime.Now;
        evaluation.SchoolName = "مدرسة الفضل بن العباس للتعليم الأساسي (8 - 10)";
    }

    private void CalculateAdministrativeTotal()
    {
        administrativeTotal = evaluation.ProgramDateSuitability + evaluation.TrainingRoomSuitability + evaluation.SupportFromProgramStaff;
    }

    private void CalculateTrainingMaterialTotal()
    {
        trainingMaterialTotal = evaluation.ContributesToCurrentJob + evaluation.MeetsPersonalExpectations + 
                               evaluation.TopicsSuitableForParticipants + evaluation.TrainingMaterialAdequacy + 
                               evaluation.ActivitiesMatchTopics;
    }

    private void CalculateTrainerTotal()
    {
        trainerTotal = evaluation.TrainerMasteryOfMaterial + evaluation.TrainerInteractionWithParticipants + 
                      evaluation.TrainerAbilityToConveyInformation + evaluation.CombiningTheoryAndPractice + 
                      evaluation.CommitmentToTrainingTopics;
    }

    private void CalculateAllTotals()
    {
        CalculateAdministrativeTotal();
        CalculateTrainingMaterialTotal();
        CalculateTrainerTotal();
    }

    private async Task OnJobTitleChange(string jobType)
    {
        selectedJobType = jobType;
        
        // إخفاء جميع حقول الإدخال أولاً
        await JSRuntime.InvokeVoidAsync("hideElement", "administrativeInput");
        await JSRuntime.InvokeVoidAsync("hideElement", "teacherInput");
        await JSRuntime.InvokeVoidAsync("hideElement", "relatedFunctionsInput");
        
        // إظهار الحقل المناسب
        if (jobType == administrativeRole)
        {
            await JSRuntime.InvokeVoidAsync("showElement", "administrativeInput");
        }
        else if (jobType == teacherRole)
        {
            await JSRuntime.InvokeVoidAsync("showElement", "teacherInput");
        }
        else if (jobType == relatedFunctionsRole)
        {
            await JSRuntime.InvokeVoidAsync("showElement", "relatedFunctionsInput");
        }
        
        StateHasChanged();
    }

    private void OnAdministrativeInputChange(ChangeEventArgs e)
    {
        administrative = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrEmpty(administrative))
        {
            evaluation.JobTitle = $"{administrativeRole}: {administrative}";
        }
        StateHasChanged();
    }

    private void OnTeacherInputChange(ChangeEventArgs e)
    {
        teacher = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrEmpty(teacher))
        {
            evaluation.JobTitle = $"{teacherRole}: {teacher}";
        }
        StateHasChanged();
    }

    private void OnRelatedFunctionsInputChange(ChangeEventArgs e)
    {
        relatedFunctionsInput = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrEmpty(relatedFunctionsInput))
        {
            evaluation.JobTitle = $"وظائف مرتبطة: {relatedFunctionsInput}";
        }
        StateHasChanged();
    }

    private async Task SaveEvaluation()
    {
        try
        {
            if (string.IsNullOrEmpty(evaluation.ProgramTitle))
            {
                errorMessage = "يرجى إدخال عنوان البرنامج";
                return;
            }

            if (string.IsNullOrEmpty(evaluation.Subject))
            {
                errorMessage = "يرجى اختيار المادة";
                return;
            }

            // تحديد المسمى الوظيفي بناءً على الاختيار
            if (selectedJobType == administrativeRole && !string.IsNullOrEmpty(administrative))
            {
                evaluation.JobTitle = $"{administrativeRole}: {administrative}";
            }
            else if (selectedJobType == teacherRole && !string.IsNullOrEmpty(teacher))
            {
                evaluation.JobTitle = $"{teacherRole}: {teacher}";
            }
            else if (selectedJobType == relatedFunctionsRole && !string.IsNullOrEmpty(relatedFunctionsInput))
            {
                evaluation.JobTitle = $"وظائف مرتبطة: {relatedFunctionsInput}";
            }
            else if (!string.IsNullOrEmpty(selectedJobType))
            {
                errorMessage = "يرجى تحديد نوع الوظيفة بالتفصيل";
                return;
            }

            // التحقق من أن JobTitle تم تعبئته
            if (string.IsNullOrEmpty(evaluation.JobTitle))
            {
                errorMessage = "يرجى تحديد المسمى الوظيفي";
                return;
            }

            // التحقق من المؤهل العلمي
            if (string.IsNullOrEmpty(evaluation.EducationalQualification))
            {
                errorMessage = "يرجى تحديد المؤهل العلمي";
                return;
            }

            // التأكد من تعيين التاريخ الحالي
            evaluation.EvaluationDate = DateTime.Now;
            evaluation.CreatedAt = DateTime.Now;
            evaluation.IsActive = true;

            // حفظ في قاعدة البيانات
            await ProfessionalDevelopmentService.AddEvaluationAsync(evaluation);
            successMessage = "تم حفظ التقييم بنجاح";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = "حدث خطأ أثناء حفظ التقييم: " + ex.Message;
            StateHasChanged();
        }
        
        return;
    }

    private void ClearForm()
    {
        evaluation = new FinalEvaluation();
        evaluation.EvaluationDate = DateTime.Now;
        evaluation.SchoolName = "مدرسة الفضل بن العباس للتعليم الأساسي (8 - 10)";
        administrative = string.Empty;
        teacher = string.Empty;
        relatedFunctionsInput = string.Empty;
        selectedJobType = string.Empty;
        administrativeTotal = 0;
        trainingMaterialTotal = 0;
        trainerTotal = 0;
        successMessage = string.Empty;
        errorMessage = string.Empty;
        StateHasChanged();
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/professional-development");
    }

    private async Task PrintForm()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("printHTML", GetFormHTML(), "استمارة_التقييم_الختامي");
            successMessage = "تم إرسال النموذج للطباعة";
        }
        catch (Exception ex)
        {
            errorMessage = "حدث خطأ أثناء الطباعة: " + ex.Message;
        }
    }

