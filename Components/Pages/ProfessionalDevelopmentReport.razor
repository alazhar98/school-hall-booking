@page "/professional-development/report"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@using Microsoft.AspNetCore.Components
@using System.Collections.Generic
@inject IProfessionalDevelopmentService ProfessionalDevelopmentService
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment WebHostEnvironment
@inject NavigationManager NavigationManager

<PageTitle>تقرير برنامج الانماء المهني</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/professional-development"))">
                <i class="bi bi-arrow-right"></i> الرجوع
            </button>
            <h2 class="text-primary mb-0">تقرير برنامج الانماء المهني <span class="badge bg-light text-dark ms-2">@DisplaySubject</span></h2>
        </div>
        <button class="btn btn-primary" @onclick="@(() => OpenAddModal())">
            <i class="bi bi-plus"></i> إضافة تقرير جديد
        </button>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
        </div>
    }

    <!-- Reports Table -->
    <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">تقارير برامج الانماء المهني</h5>
            <div>
                <button class="btn btn-light btn-sm me-2" @onclick="@(() => ExportToExcel())">
                    <i class="bi bi-file-excel"></i> Excel
                </button>
                <button class="btn btn-light btn-sm" @onclick="@(() => ExportTableToPDF())">
                    <i class="bi bi-file-pdf"></i> PDF (جدول)
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (reports == null)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جاري التحميل...</span>
                    </div>
                </div>
            }
            else if (!reports.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-file-text fs-1"></i>
                    <p class="mt-2">لا توجد تقارير لعرضها</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 5%;">م</th>
                                <th style="width: 15%;">نوع البرنامج</th>
                                <th style="width: 20%;">اسم البرنامج</th>
                                <th style="width: 12%;">المادة</th>
                                <th style="width: 10%;">التاريخ</th>
                                <th style="width: 12%;">المنفذ</th>
                                <th style="width: 15%;">مكان التنفيذ</th>
                                <th style="width: 8%;">عدد الحضور</th>
                                <th style="width: 8%;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowIndex = 1;
                            }
                            @foreach (var report in reports)
                            {
                                <tr>
                                    <td class="text-center fw-bold">@rowIndex</td>
                                    <td>@report.ProgramType</td>
                                    <td>@report.ProgramName</td>
                                    <td>@report.Subject</td>
                                    <td>@report.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@report.Executor</td>
                                    <td>@report.ExecutionLocation</td>
                                    <td class="text-center">@report.NumberOfAttendees</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <button class="btn btn-info btn-sm" @onclick="@(() => ExportSingleReportToPDF(report))" title="تصدير PDF">
                                                <i class="bi bi-file-pdf"></i>
                                            </button>
                                            <button class="btn btn-warning btn-sm" @onclick="@(() => OpenEditModal(report))" title="تعديل">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-danger btn-sm" @onclick="@(() => DeleteReport(report.Id))" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade @(showModal ? "show d-block" : "")" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">@(currentReport.Id == 0 ? "إضافة تقرير جديد" : "تعديل التقرير")</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="@(() => CloseModal())"></button>
            </div>
            <EditForm Model="@currentReport" OnValidSubmit="SaveReport" FormName="reportForm">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="programType" class="form-label">نوع البرنامج</label>
                            <InputText id="programType" class="form-control" @bind-Value="currentReport.ProgramType" />
                            <ValidationMessage For="@(() => currentReport.ProgramType)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="programName" class="form-label">اسم البرنامج</label>
                            <InputText id="programName" class="form-control" @bind-Value="currentReport.ProgramName" />
                            <ValidationMessage For="@(() => currentReport.ProgramName)" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="subject" class="form-label">المادة</label>
                            <InputText id="subject" class="form-control" @bind-Value="currentReport.Subject" />
                            <ValidationMessage For="@(() => currentReport.Subject)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="date" class="form-label">التاريخ</label>
                            <InputDate id="date" class="form-control" @bind-Value="currentReport.Date" TValue="DateTime" />
                            <ValidationMessage For="@(() => currentReport.Date)" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="executor" class="form-label">المنفذ</label>
                            <InputText id="executor" class="form-control" @bind-Value="currentReport.Executor" />
                            <ValidationMessage For="@(() => currentReport.Executor)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="executionLocation" class="form-label">مكان التنفيذ</label>
                            <InputText id="executionLocation" class="form-control" @bind-Value="currentReport.ExecutionLocation" />
                            <ValidationMessage For="@(() => currentReport.ExecutionLocation)" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="numberOfAttendees" class="form-label">عدد الحضور</label>
                            <InputNumber id="numberOfAttendees" class="form-control" @bind-Value="currentReport.NumberOfAttendees" TValue="int" />
                            <ValidationMessage For="@(() => currentReport.NumberOfAttendees)" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="programJustifications" class="form-label">مبررات البرنامج</label>
                        <InputTextArea id="programJustifications" class="form-control" rows="3" @bind-Value="currentReport.ProgramJustifications" placeholder="أدخل مبررات البرنامج..." />
                        <ValidationMessage For="@(() => currentReport.ProgramJustifications)" />
                    </div>
                    <div class="mb-3">
                        <label for="trainingProgramSummary" class="form-label">ملخص البرنامج التدريبي</label>
                        <InputTextArea id="trainingProgramSummary" class="form-control" rows="4" @bind-Value="currentReport.TrainingProgramSummary" placeholder="أدخل ملخص البرنامج التدريبي..." />
                        <ValidationMessage For="@(() => currentReport.TrainingProgramSummary)" />
                    </div>
                    <div class="mb-3">
                        <label for="imageUpload" class="form-label">صورة البرنامج</label>
                        <InputFile id="imageUpload" class="form-control" OnChange="@OnImageSelected" accept="image/*" />
                        <small class="form-text text-muted">الحد الأقصى للحجم: 5MB. الصيغ المدعومة: JPG, PNG, GIF</small>
                        @if (!string.IsNullOrEmpty(currentReport.ImagePath))
                        {
                            <div class="mt-2">
                                <img src="@currentReport.ImagePath" alt="صورة البرنامج" class="img-thumbnail" style="max-width: 200px; max-height: 200px;" />
                                <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="RemoveImage">
                                    <i class="bi bi-trash"></i> إزالة الصورة
                                </button>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="@(() => CloseModal())">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
}

<style>
    .modal.show {
        display: block !important;
    }
    
    .table th {
        border-top: none;
        font-weight: bold;
    }
    
    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "subject")]
    public string? SubjectFilter { get; set; }

    private List<ProfessionalDevelopmentProgram> reports = new();
    private ProfessionalDevelopmentProgram currentReport = new ProfessionalDevelopmentProgram();
    private bool showModal = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private IBrowserFile? selectedImage = null;

    private string DisplaySubject => string.IsNullOrWhiteSpace(SubjectFilter) ? "كل المواد" : SubjectFilter!;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        try
        {
            reports = await ProfessionalDevelopmentService.GetAllProgramsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تحميل التقارير: " + ex.Message;
        }
    }

    private void OpenAddModal()
    {
        currentReport = new ProfessionalDevelopmentProgram();
        showModal = true;
        StateHasChanged();
    }

    private void OpenEditModal(ProfessionalDevelopmentProgram report)
    {
        currentReport = new ProfessionalDevelopmentProgram
        {
            Id = report.Id,
            ProgramType = report.ProgramType,
            ProgramName = report.ProgramName,
            Subject = report.Subject,
            Date = report.Date,
            Executor = report.Executor,
            ExecutionLocation = report.ExecutionLocation,
            NumberOfAttendees = report.NumberOfAttendees,
            ProgramJustifications = report.ProgramJustifications,
            TrainingProgramSummary = report.TrainingProgramSummary,
            ImagePath = report.ImagePath
        };
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        currentReport = new ProfessionalDevelopmentProgram();
        selectedImage = null;
        StateHasChanged();
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
        
        if (selectedImage != null)
        {
            // Validate file size (5MB max)
            if (selectedImage.Size > 5 * 1024 * 1024)
            {
                errorMessage = "حجم الصورة يجب أن يكون أقل من 5MB";
                selectedImage = null;
                return;
            }
            
            // Validate file type
            var allowedTypes = new[] { "image/jpeg", "image/jpg", "image/png", "image/gif" };
            if (!allowedTypes.Contains(selectedImage.ContentType.ToLower()))
            {
                errorMessage = "نوع الملف غير مدعوم. الرجاء اختيار صورة JPG أو PNG أو GIF";
                selectedImage = null;
                return;
            }
        }
    }

    private void RemoveImage()
    {
        currentReport.ImagePath = null;
        selectedImage = null;
        StateHasChanged();
    }

    private async Task SaveReport()
    {
        try
        {
            // Save image if one was selected
            if (selectedImage != null)
            {
                var uploadsFolder = Path.Combine(WebHostEnvironment.WebRootPath, "uploads", "professional-development");
                Directory.CreateDirectory(uploadsFolder);
                
                var fileName = $"{Guid.NewGuid()}{Path.GetExtension(selectedImage.Name)}";
                var filePath = Path.Combine(uploadsFolder, fileName);
                
                using (var stream = File.Create(filePath))
                {
                    await selectedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(stream);
                }
                
                // Delete old image if exists
                if (!string.IsNullOrEmpty(currentReport.ImagePath))
                {
                    var oldImagePath = Path.Combine(WebHostEnvironment.WebRootPath, currentReport.ImagePath.TrimStart('/'));
                    if (File.Exists(oldImagePath))
                    {
                        File.Delete(oldImagePath);
                    }
                }
                
                currentReport.ImagePath = $"/uploads/professional-development/{fileName}";
            }
            
            if (currentReport.Id == 0)
            {
                await ProfessionalDevelopmentService.AddProgramAsync(currentReport);
                successMessage = "تم إضافة التقرير بنجاح";
            }
            else
            {
                await ProfessionalDevelopmentService.UpdateProgramAsync(currentReport);
                successMessage = "تم تحديث التقرير بنجاح";
            }

            await LoadReports();
            StateHasChanged();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في حفظ التقرير: " + ex.Message;
        }
    }

    private async Task DeleteReport(int id)
    {
        try
        {
            if (await JSRuntime.InvokeAsync<bool>("confirmDialog", "هل أنت متأكد من حذف هذا التقرير؟"))
            {
                await ProfessionalDevelopmentService.DeleteProgramAsync(id);
                successMessage = "تم حذف التقرير بنجاح";
                await LoadReports();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في حذف التقرير: " + ex.Message;
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            if (reports == null || !reports.Any())
            {
                errorMessage = "لا توجد بيانات للتصدير";
                return;
            }

            var data = reports.Select(r => new
            {
                نوع_البرنامج = r.ProgramType,
                اسم_البرنامج = r.ProgramName,
                المادة = r.Subject,
                التاريخ = r.Date.ToString("yyyy-MM-dd"),
                المنفذ = r.Executor,
                مكان_التنفيذ = r.ExecutionLocation,
                عدد_الحضور = r.NumberOfAttendees,
                مبررات_البرنامج = r.ProgramJustifications ?? ""
            }).ToList();

            await JSRuntime.InvokeVoidAsync("exportToExcel", data, "تقارير_برامج_الانماء_المهني");
            successMessage = "تم تصدير البيانات إلى Excel بنجاح";
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير Excel: " + ex.Message;
        }
    }

    private async Task ExportTableToPDF()
    {
        try
        {
            if (reports == null || !reports.Any())
            {
                errorMessage = "لا توجد بيانات للتصدير";
                return;
            }

            var tableRows = reports.Select((r, index) => $@"
                <tr>
                    <td>{index + 1}</td>
                    <td>{r.ProgramType}</td>
                    <td>{r.ProgramName}</td>
                    <td>{r.Subject}</td>
                    <td>{r.Date:yyyy-MM-dd}</td>
                    <td>{r.Executor}</td>
                    <td>{r.ExecutionLocation}</td>
                    <td>{r.NumberOfAttendees}</td>
                </tr>").ToList();

            var tableRowsHtml = string.Join("", tableRows);

            var html = $@"
                <html>
                <head>
                    <meta charset='utf-8'>
                    <title>تقارير برامج الانماء المهني</title>
                    <style>
                        body {{ font-family: Arial, sans-serif; direction: rtl; }}
                        table {{ width: 100%; border-collapse: collapse; margin-top: 20px; }}
                        th, td {{ border: 1px solid #ddd; padding: 8px; text-align: center; }}
                        th {{ background-color: #f2f2f2; font-weight: bold; }}
                        .header {{ text-align: center; margin-bottom: 20px; }}
                    </style>
                </head>
                <body>
                    <div class='header'>
                        <h1>تقارير برامج الانماء المهني</h1>
                        <p>تاريخ التقرير: {DateTime.Now:yyyy-MM-dd}</p>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>م</th>
                                <th>نوع البرنامج</th>
                                <th>اسم البرنامج</th>
                                <th>المادة</th>
                                <th>التاريخ</th>
                                <th>المنفذ</th>
                                <th>مكان التنفيذ</th>
                                <th>عدد الحضور</th>
                            </tr>
                        </thead>
                        <tbody>
                            {tableRowsHtml}
                        </tbody>
                    </table>
                </body>
                </html>";

            await JSRuntime.InvokeVoidAsync("exportToPDF", html, "تقارير_برامج_الانماء_المهني");
            successMessage = "تم تصدير البيانات إلى PDF بنجاح";
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير PDF: " + ex.Message;
        }
    }

    private async Task ExportSingleReportToPDF(ProfessionalDevelopmentProgram report)
    {
        try
        {
            var html = CreateSingleReportHtml(report);
            await JSRuntime.InvokeVoidAsync("exportToPDF", html, $"تقرير_برنامج_الإنماء_المهني");
            successMessage = "تم تصدير التقرير إلى PDF بنجاح";
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير PDF: " + ex.Message;
        }
    }

    private string CreateSingleReportHtml(ProfessionalDevelopmentProgram report)
    {
        var summaryText = System.Net.WebUtility.HtmlEncode(report.TrainingProgramSummary ?? "");
        var summaryHtml = !string.IsNullOrEmpty(report.TrainingProgramSummary) 
            ? $"<div style='margin: 20px 0; padding: 15px; background-color: #e3f2fd; border-radius: 5px; border-right: 4px solid #2196f3;'><strong style='color: #1976d2;'>ملخص البرنامج التدريبي:</strong><br/>{summaryText}</div>"
            : "";
        
        var imagePath = System.Net.WebUtility.HtmlEncode(report.ImagePath ?? "");
        var imageHtml = !string.IsNullOrEmpty(report.ImagePath) 
            ? $"<div style='text-align: center; margin: 20px 0;'><img src='{imagePath}' style='max-width: 100%; max-height: 400px; border-radius: 5px;' /></div>"
            : "";
        
        var justificationText = string.IsNullOrEmpty(report.ProgramJustifications) ? "غير محدد" : System.Net.WebUtility.HtmlEncode(report.ProgramJustifications);

        return $@"
            <html>
            <head>
                <meta charset='utf-8'>
                <title>تقرير برنامج الإنماء المهني</title>
                <style>
                    body {{ 
                        font-family: 'Arial', 'Tahoma', sans-serif; 
                        direction: rtl; 
                        margin: 0; 
                        padding: 20px; 
                        background-color: white;
                    }}
                    .container {{ 
                        max-width: 1000px; 
                        margin: 0 auto; 
                        background-color: white; 
                        padding: 30px; 
                        border-radius: 10px; 
                        box-shadow: 0 0 20px rgba(0,0,0,0.1); 
                    }}
                    .header {{ 
                        text-align: center; 
                        margin-bottom: 40px; 
                        border-bottom: 3px solid #007bff; 
                        padding-bottom: 20px; 
                    }}
                    .header h1 {{ 
                        color: #007bff; 
                        font-size: 28px; 
                        margin: 0 0 10px 0; 
                    }}
                    .header p {{ 
                        color: #666; 
                        font-size: 16px; 
                        margin: 0; 
                    }}
                    .details {{ 
                        display: grid; 
                        grid-template-columns: 1fr 1fr; 
                        gap: 15px; 
                        margin-bottom: 20px; 
                    }}
                    .detail-row {{ 
                        display: flex; 
                        align-items: center; 
                        padding: 8px 0; 
                        border-bottom: 1px solid #f0f0f0; 
                    }}
                    .detail-label {{ 
                        font-weight: bold; 
                        color: #333; 
                        min-width: 120px; 
                        margin-left: 10px; 
                    }}
                    .detail-value {{ 
                        color: #666; 
                        flex: 1; 
                    }}
                </style>
            </head>
            <body>
                <div class='container'>
                    <div class='header'>
                        <h1>تقرير برنامج الإنماء المهني</h1>
                        <p>تاريخ التقرير: {DateTime.Now:yyyy-MM-dd}</p>
                    </div>
                    <div class='details'>
                        <div class='detail-row'>
                            <span class='detail-label'>نوع البرنامج:</span>
                            <span class='detail-value'>{report.ProgramType}</span>
                        </div>
                        <div class='detail-row'>
                            <span class='detail-label'>اسم البرنامج:</span>
                            <span class='detail-value'>{report.ProgramName}</span>
                        </div>
                        <div class='detail-row'>
                            <span class='detail-label'>المادة:</span>
                            <span class='detail-value'>{report.Subject}</span>
                        </div>
                        <div class='detail-row'>
                            <span class='detail-label'>التاريخ:</span>
                            <span class='detail-value'>{report.Date:yyyy-MM-dd}</span>
                        </div>
                        <div class='detail-row'>
                            <span class='detail-label'>المنفذ:</span>
                            <span class='detail-value'>{report.Executor}</span>
                        </div>
                        <div class='detail-row'>
                            <span class='detail-label'>مكان التنفيذ:</span>
                            <span class='detail-value'>{report.ExecutionLocation}</span>
                        </div>
                        <div class='detail-row'>
                            <span class='detail-label'>عدد الحضور:</span>
                            <span class='detail-value'>{report.NumberOfAttendees}</span>
                        </div>
                        <div class='detail-row'>
                            <span class='detail-label'>مبررات البرنامج:</span>
                            <span class='detail-value'>{justificationText}</span>
                        </div>
                    </div>
                    
                    {summaryHtml}
                    
                    {imageHtml}
                </div>
            </body>
            </html>";
    }
}
