    private async void OpenSlide(int slide) 
    { 
        activeSlide = slide;
        if (slide == 2)
        {
            await LoadClean();
            await LoadWorkers();
        }
        else if (slide == 3)
        {
            await LoadTransport();
        }
        else if (slide == 4)
        {
            await LoadMaintenancePhones();
            await LoadMaintenanceForm();
        }
        else if (slide == 7)
        {
            await LoadCanteenVisits();
        }
    }

