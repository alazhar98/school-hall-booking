        string td = "style='border:1px solid #000;padding:6px;text-align:center'";
        for (int i = 0; i < canteenVisits.Count; i++)
        {
            var cv = canteenVisits[i];
            sb.Append("<tr>");
            sb.Append($"<td {td}>{i + 1}</td>");
            sb.Append($"<td {td}>{System.Net.WebUtility.HtmlEncode(cv.VisitNo)}</td>");
            sb.Append($"<td {td}>{System.Net.WebUtility.HtmlEncode(cv.Day)}</td>");
            sb.Append($"<td {td}>{System.Net.WebUtility.HtmlEncode(cv.Date)}</td>");
            sb.Append($"<td {td}>{System.Net.WebUtility.HtmlEncode(cv.Observations)}</td>");
            sb.Append($"<td {td}>{System.Net.WebUtility.HtmlEncode(cv.ActionTaken)}</td>");
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table></div>");
        return sb.ToString();
    }
}
