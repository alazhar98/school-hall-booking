@page "/followuprecords"
@page "/followup-records"
@using SchoolHallBooking.Services
@using SchoolHallBooking.Models
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
    </div>
}
else if (!isAuthenticated)
{
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>غير مصرح لك بالوصول</strong>
                    <br>
                    <small>يجب تسجيل الدخول أولاً للوصول إلى هذه الصفحة</small>
                    <br>
                    <a href="/school/login" class="btn btn-primary btn-sm mt-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        تسجيل الدخول
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        @if (activeSlide == 1)
        {
            <div class="text-center mb-4">
                <h3 class="mb-1">سجلات المتابعة</h3>
                <small class="text-muted">اختر نوع السجل</small>
            </div>
            <div class="row g-3 justify-content-center">
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <button class="btn btn-primary w-100 py-3" @onclick="() => OpenSlide(2)">النظافة</button>
                </div>
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <button class="btn btn-primary w-100 py-3" @onclick="() => OpenSlide(3)">وسائل النقل</button>
                </div>
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <button class="btn btn-primary w-100 py-3" @onclick="() => OpenSlide(4)">الصيانة</button>
                </div>
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <button class="btn btn-primary w-100 py-3" @onclick="() => OpenSlide(7)">الجمعية التعاونية</button>
                </div>
            </div>
        }
        else if (activeSlide == 2)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">متابعة نظافة المبنى المدرسي</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveClean">حفظ البيانات</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintClean">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">م</th>
                                    <th>رقم المتابعة</th>
                                    <th>المنفذ</th>
                                    <th>اليوم</th>
                                    <th>التاريخ</th>
                                    <th>المكان</th>
                                    <th>الملاحظات</th>
                                    <th>الإجراء المتخذ</th>
                                    <th>متابعة الإجراءات</th>
                                    <th style="width:120px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < cleanRows.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td>@(idx + 1)</td>
                                        <td><input class="form-control form-control-sm" value="@cleanRows[idx].FollowNo" @oninput="(e => cleanRows[idx].FollowNo = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@cleanRows[idx].Executor" @oninput="(e => cleanRows[idx].Executor = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@cleanRows[idx].Day" @oninput="(e => cleanRows[idx].Day = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input type="date" class="form-control form-control-sm" value="@cleanRows[idx].Date" @oninput="(e => cleanRows[idx].Date = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@cleanRows[idx].Place" @oninput="(e => cleanRows[idx].Place = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@cleanRows[idx].Notes" @oninput="(e => cleanRows[idx].Notes = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@cleanRows[idx].ActionTaken" @oninput="(e => cleanRows[idx].ActionTaken = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@cleanRows[idx].ActionFollowup" @oninput="(e => cleanRows[idx].ActionFollowup = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveCleanRow(idx))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddCleanRow">+ إضافة صف</button>
                </div>
            </div>

            <!-- جدول أرقام هواتف عمال النظافة -->
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">أرقام هواتف عمال النظافة</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveWorkers">حفظ البيانات</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintWorkers">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">م</th>
                                    <th>الاسم</th>
                                    <th>رقم الهاتف</th>
                                    <th style="width:120px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < workers.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td>@(idx + 1)</td>
                                        <td><input class="form-control form-control-sm" value="@workers[idx].Name" @oninput="(e => workers[idx].Name = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@workers[idx].PhoneNumber" @oninput="(e => workers[idx].PhoneNumber = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveWorker(idx))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddWorker">+ إضافة عامل</button>
                </div>
            </div>
        }
        else if (activeSlide == 3)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">كشف بالملاحظات في وسائل النقل المدرسية</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveTransport">حفظ البيانات</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintTransport">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">م</th>
                                    <th>رقم الحافلة</th>
                                    <th>المنطقة السكنية</th>
                                    <th>اسم صاحب الحافلة</th>
                                    <th>اسم السائق</th>
                                    <th>الشكوى</th>
                                    <th>الإجراء المتخذ</th>
                                    <th>المتابعة</th>
                                    <th>توقيع السائق</th>
                                    <th style="width:120px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < transportRows.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td>@(idx + 1)</td>
                                        <td><input class="form-control form-control-sm" value="@transportRows[idx].BusNumber" @oninput="(e => transportRows[idx].BusNumber = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@transportRows[idx].ResidentialArea" @oninput="(e => transportRows[idx].ResidentialArea = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@transportRows[idx].BusOwnerName" @oninput="(e => transportRows[idx].BusOwnerName = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@transportRows[idx].DriverName" @oninput="(e => transportRows[idx].DriverName = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@transportRows[idx].Complaint" @oninput="(e => transportRows[idx].Complaint = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@transportRows[idx].ActionTaken" @oninput="(e => transportRows[idx].ActionTaken = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@transportRows[idx].FollowUp" @oninput="(e => transportRows[idx].FollowUp = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@transportRows[idx].DriverSignature" @oninput="(e => transportRows[idx].DriverSignature = e.Value?.ToString() ?? string.Empty)" disabled /></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveTransportRow(idx))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddTransportRow">+ إضافة صف</button>
                </div>
            </div>
        }
        else if (activeSlide == 4)
        {
            <!-- استمارة صيانة مدرسية -->
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">استمارة صيانة مدرسية</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveMaintenanceForm">حفظ البيانات</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintMaintenanceForm">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">م</th>
                                    <th>صيانة رقم</th>
                                    <th>نوع الصيانة المطلوبة</th>
                                    <th>نوع الطلب</th>
                                    <th>وقت إجراء الصيانة</th>
                                    <th>الإجراء المتخذ</th>
                                    <th>ما تم تنفيذه</th>
                                    <th style="width:120px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < maintenanceForms.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td>@(idx + 1)</td>
                                        <td><input class="form-control form-control-sm" value="@maintenanceForms[idx].MaintenanceNo" @oninput="(e => maintenanceForms[idx].MaintenanceNo = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" checked="@maintenanceForms[idx].Electricity" @onchange="@((e) => maintenanceForms[idx].Electricity = (bool)e.Value)" />
                                                    <label class="form-check-label">كهرباء</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" checked="@maintenanceForms[idx].Plumbing" @onchange="@((e) => maintenanceForms[idx].Plumbing = (bool)e.Value)" />
                                                    <label class="form-check-label">سباكة</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" checked="@maintenanceForms[idx].AC" @onchange="@((e) => maintenanceForms[idx].AC = (bool)e.Value)" />
                                                    <label class="form-check-label">تكييف</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" checked="@maintenanceForms[idx].Furniture" @onchange="@((e) => maintenanceForms[idx].Furniture = (bool)e.Value)" />
                                                    <label class="form-check-label">كراسي-طاولات</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" checked="@maintenanceForms[idx].Other" @onchange="@((e) => maintenanceForms[idx].Other = (bool)e.Value)" />
                                                    <label class="form-check-label">أخرى</label>
                                                </div>
                                                <input class="form-control form-control-sm mt-1" placeholder="حدد الأخرى" value="@maintenanceForms[idx].OtherSpecify" @oninput="(e => maintenanceForms[idx].OtherSpecify = e.Value?.ToString() ?? string.Empty)" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="requestType_@idx" checked="@(maintenanceForms[idx].RequestType == "عاجل")" @onchange="@((e) => { maintenanceForms[idx].RequestType = "عاجل"; })" />
                                                    <label class="form-check-label">عاجل</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="requestType_@idx" checked="@(maintenanceForms[idx].RequestType == "عاجل جدا")" @onchange="@((e) => { maintenanceForms[idx].RequestType = "عاجل جدا"; })" />
                                                    <label class="form-check-label">عاجل جدا</label>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="maintenanceTime_@idx" checked="@(maintenanceForms[idx].MaintenanceTime == "صباحا")" @onchange="@((e) => { maintenanceForms[idx].MaintenanceTime = "صباحا"; })" />
                                                    <label class="form-check-label">صباحا</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="maintenanceTime_@idx" checked="@(maintenanceForms[idx].MaintenanceTime == "مساءا")" @onchange="@((e) => { maintenanceForms[idx].MaintenanceTime = "مساءا"; })" />
                                                    <label class="form-check-label">مساءا</label>
                                                </div>
                                            </div>
                                        </td>
                                        <td><input class="form-control form-control-sm" value="@maintenanceForms[idx].ActionTaken" @oninput="(e => maintenanceForms[idx].ActionTaken = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@maintenanceForms[idx].WhatWasImplemented" @oninput="(e => maintenanceForms[idx].WhatWasImplemented = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveMaintenanceForm(idx))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddMaintenanceForm">+ إضافة صف</button>
                </div>
            </div>

            <!-- جدول أرقام هواتف الصيانة -->
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">أرقام هواتف الصيانة</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveMaintenancePhones">حفظ البيانات</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintMaintenancePhones">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">م</th>
                                    <th>الفئة</th>
                                    <th>الاسم</th>
                                    <th>رقم الهاتف</th>
                                    <th style="width:120px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < maintenancePhones.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td>@(idx + 1)</td>
                                        <td><input class="form-control form-control-sm" value="@maintenancePhones[idx].Category" @oninput="(e => maintenancePhones[idx].Category = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@maintenancePhones[idx].Name" @oninput="(e => maintenancePhones[idx].Name = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@maintenancePhones[idx].PhoneNumber" @oninput="(e => maintenancePhones[idx].PhoneNumber = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveMaintenancePhone(idx))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddMaintenancePhone">+ إضافة رقم</button>
                </div>
            </div>
        }
        else if (activeSlide == 7)
        {
            <!-- الشريحة 7: زيارة للمقصف المدرسي -->
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold">زيارة للمقصف المدرسي</div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveCanteenVisits">حفظ البيانات</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenSlide(1)">رجوع</button>
                        <button class="btn btn-sm btn-success" @onclick="PrintCanteenVisits">طباعة PDF</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">م</th>
                                    <th>زيارة رقم</th>
                                    <th>اليوم</th>
                                    <th>التاريخ</th>
                                    <th>الملاحظات</th>
                                    <th>الإجراء المتخذ</th>
                                    <th style="width:120px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < canteenVisits.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td>@(idx + 1)</td>
                                        <td><input class="form-control form-control-sm" value="@canteenVisits[idx].VisitNo" @oninput="(e => canteenVisits[idx].VisitNo = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" value="@canteenVisits[idx].Day" @oninput="(e => canteenVisits[idx].Day = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><input class="form-control form-control-sm" type="date" value="@canteenVisits[idx].Date" @oninput="(e => canteenVisits[idx].Date = e.Value?.ToString() ?? string.Empty)" /></td>
                                        <td><textarea class="form-control form-control-sm" rows="3" value="@canteenVisits[idx].Observations" @oninput="(e => canteenVisits[idx].Observations = e.Value?.ToString() ?? string.Empty)"></textarea></td>
                                        <td><textarea class="form-control form-control-sm" rows="3" value="@canteenVisits[idx].ActionTaken" @oninput="(e => canteenVisits[idx].ActionTaken = e.Value?.ToString() ?? string.Empty)"></textarea></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => RemoveCanteenVisit(idx))">حذف</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddCanteenVisit">+ إضافة زيارة</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private int activeSlide = 1;

    private class CleanRow
    {
        public string FollowNo { get; set; } = string.Empty;
        public string Executor { get; set; } = string.Empty;
        public string Day { get; set; } = string.Empty;
        public string Date { get; set; } = string.Empty; // yyyy-MM-dd
        public string Place { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public string ActionTaken { get; set; } = string.Empty;
        public string ActionFollowup { get; set; } = string.Empty;
    }

    private class Worker
    {
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
    }

    private class TransportRow
    {
        public string BusNumber { get; set; } = string.Empty;
        public string ResidentialArea { get; set; } = string.Empty;
        public string BusOwnerName { get; set; } = string.Empty;
        public string DriverName { get; set; } = string.Empty;
        public string Complaint { get; set; } = string.Empty;
        public string ActionTaken { get; set; } = string.Empty;
        public string FollowUp { get; set; } = string.Empty;
        public string DriverSignature { get; set; } = string.Empty;
    }

    private class MaintenancePhone
    {
        public string Category { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
    }

    private class MaintenanceForm
    {
        public string MaintenanceNo { get; set; } = string.Empty;
        public bool Electricity { get; set; } = false;
        public bool Plumbing { get; set; } = false;
        public bool AC { get; set; } = false;
        public bool Furniture { get; set; } = false;
        public bool Other { get; set; } = false;
        public string OtherSpecify { get; set; } = string.Empty;
        public string RequestType { get; set; } = string.Empty;
        public string MaintenanceTime { get; set; } = string.Empty;
        public string ActionTaken { get; set; } = string.Empty;
        public string WhatWasImplemented { get; set; } = string.Empty;
    }

