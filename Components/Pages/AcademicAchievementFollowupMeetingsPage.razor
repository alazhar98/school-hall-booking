@page "/academic-achievement/follow-up-meetings"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@inject IAcademicAchievementService AcademicAchievementService
@inject IJSRuntime JSRuntime
@inject ILogger<AcademicAchievementFollowupMeetingsPage> Logger
@rendermode InteractiveServer

<PageTitle>كشاف اجتماعات فريق متابعة التحصيل الدراسي</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">كشاف اجتماعات فريق متابعة التحصيل الدراسي</h2>
        <div>
            <button class="btn btn-success me-2" @onclick="ExportToPDF">
                <i class="bi bi-file-pdf"></i> PDF
            </button>
            <button class="btn btn-warning me-2" @onclick="ExportToExcel">
                <i class="bi bi-file-excel"></i> Excel
            </button>
            <button class="btn btn-primary" @onclick="@(() => OpenAddModal())">
                <i class="bi bi-plus"></i> إضافة اجتماع جديد
            </button>
        </div>
    </div>

    <!-- Meetings Table -->
    <div class="card">
        <div class="card-body">
            @if (meetings.Any())
            {
                <div class="table-responsive">
                    <table id="followup-meetings-table" class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>رقم الاجتماع</th>
                                <th>التاريخ</th>
                                <th>اليوم</th>
                                <th>جدول الأعمال</th>
                                <th>الملاحظات</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meeting in meetings)
                            {
                                <tr>
                                    <td>@meeting.MeetingNumber</td>
                                    <td>@meeting.Date?.ToString("yyyy-MM-dd")</td>
                                    <td>@meeting.Day</td>
                                    <td>@(meeting.Agenda?.Length > 50 ? meeting.Agenda.Substring(0, 50) + "..." : meeting.Agenda)</td>
                                    <td>@(meeting.Notes?.Length > 50 ? meeting.Notes.Substring(0, 50) + "..." : meeting.Notes)</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="@(() => EditMeeting(meeting))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteMeeting(meeting.Id))">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                    <h5 class="text-muted mt-3">لا توجد اجتماعات مسجلة</h5>
                    <p class="text-muted">اضغط على "إضافة اجتماع جديد" لبدء إضافة اجتماعات فريق المتابعة</p>
                </div>
            }
        </div>
    </div>

    <!-- Add/Edit Modal -->
    @if (showModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEditing ? "تعديل الاجتماع" : "إضافة اجتماع جديد")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="currentMeeting" OnValidSubmit="SaveMeeting">
                            <DataAnnotationsValidator />
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="meetingNumber" class="form-label">رقم الاجتماع *</label>
                                    <InputText id="meetingNumber" class="form-control" @bind-Value="currentMeeting.MeetingNumber" placeholder="أدخل رقم الاجتماع" />
                                    <ValidationMessage For="@(() => currentMeeting.MeetingNumber)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="date" class="form-label">التاريخ *</label>
                                    <InputDate id="date" class="form-control" @bind-Value="currentMeeting.Date" TValue="DateTime?" />
                                    <ValidationMessage For="@(() => currentMeeting.Date)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="day" class="form-label">اليوم *</label>
                                    <InputSelect id="day" class="form-control" @bind-Value="currentMeeting.Day">
                                        <option value="">اختر اليوم</option>
                                        <option value="السبت">السبت</option>
                                        <option value="الأحد">الأحد</option>
                                        <option value="الاثنين">الاثنين</option>
                                        <option value="الثلاثاء">الثلاثاء</option>
                                        <option value="الأربعاء">الأربعاء</option>
                                        <option value="الخميس">الخميس</option>
                                        <option value="الجمعة">الجمعة</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => currentMeeting.Day)" />
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="agenda" class="form-label">جدول الأعمال *</label>
                                    <InputTextArea id="agenda" class="form-control" @bind-Value="currentMeeting.Agenda" placeholder="أدخل جدول الأعمال" rows="3" />
                                    <ValidationMessage For="@(() => currentMeeting.Agenda)" />
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="notes" class="form-label">الملاحظات</label>
                                    <InputTextArea id="notes" class="form-control" @bind-Value="currentMeeting.Notes" placeholder="أدخل أي ملاحظات إضافية" rows="3" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">إلغاء</button>
                                <button type="submit" class="btn btn-primary">@(isEditing ? "تحديث" : "حفظ")</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<AcademicAchievementFollowupMeeting> meetings = new();
    private bool showModal = false;
    private bool isEditing = false;
    private AcademicAchievementFollowupMeeting currentMeeting = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMeetings();
    }

    private async Task LoadMeetings()
    {
        try
        {
            meetings = await AcademicAchievementService.GetFollowupMeetingsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تحميل اجتماعات فريق المتابعة");
        }
    }

    private void OpenAddModal()
    {
        currentMeeting = new AcademicAchievementFollowupMeeting();
        isEditing = false;
        showModal = true;
    }

    private void EditMeeting(AcademicAchievementFollowupMeeting meeting)
    {
        currentMeeting = new AcademicAchievementFollowupMeeting
        {
            Id = meeting.Id,
            MeetingNumber = meeting.MeetingNumber,
            Date = meeting.Date,
            Day = meeting.Day,
            Agenda = meeting.Agenda,
            Notes = meeting.Notes
        };
        isEditing = true;
        showModal = true;
    }

    private async Task SaveMeeting()
    {
        try
        {
            if (isEditing)
            {
                await AcademicAchievementService.UpdateFollowupMeetingAsync(currentMeeting);
            }
            else
            {
                await AcademicAchievementService.AddFollowupMeetingAsync(currentMeeting);
            }

            await LoadMeetings();
            CloseModal();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في حفظ الاجتماع");
        }
    }

    private async Task DeleteMeeting(int id)
    {
        try
        {
            if (await JSRuntime.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذا الاجتماع؟"))
            {
                await AcademicAchievementService.DeleteFollowupMeetingAsync(id);
                await LoadMeetings();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في حذف الاجتماع");
        }
    }

    private async Task PrintMeeting(AcademicAchievementFollowupMeeting meeting)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("printElement", $"meeting-{meeting.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في طباعة الاجتماع");
        }
    }


    private async Task ExportToPDF()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToPDF", "followup-meetings-table", "اجتماعات_فريق_المتابعة");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تصدير PDF");
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToExcel", "followup-meetings-table", "اجتماعات_فريق_المتابعة");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تصدير Excel");
        }
    }

    private void CloseModal()
    {
        showModal = false;
        currentMeeting = new AcademicAchievementFollowupMeeting();
        isEditing = false;
    }
}
