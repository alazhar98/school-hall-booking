@page "/professional-development/improvement-team"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@inject IProfessionalDevelopmentService ProfessionalDevelopmentService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>فريق التحسين والتطوير</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">فريق التحسين والتطوير</h2>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="@(() => OpenAddModal())">
                <i class="bi bi-plus"></i> إضافة عضو جديد
            </button>
            <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/professional-development"))">
                <i class="bi bi-arrow-right"></i> الرجوع
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
        </div>
    }

    <!-- Team Members Table -->
    <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">أعضاء فريق التحسين والتطوير</h5>
            <div>
                <button class="btn btn-light btn-sm me-2" @onclick="@(() => ExportToExcel())">
                    <i class="bi bi-file-excel"></i> Excel
                </button>
                <button class="btn btn-light btn-sm" @onclick="@(() => ExportToPDF())">
                    <i class="bi bi-file-pdf"></i> PDF
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (teamMembers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>الاسم</th>
                                <th>الوظيفة</th>
                                <th>المهمة/الدور</th>
                                <th>الملاحظات</th>
                                <th>تاريخ الإنشاء</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in teamMembers)
                            {
                                <tr>
                                    <td>@member.Name</td>
                                    <td>@member.JobTitle</td>
                                    <td>@member.TaskOrRole</td>
                                    <td>@member.Notes</td>
                                    <td>@member.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <button class="btn btn-warning btn-sm" @onclick="@(() => OpenEditModal(member))" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm" @onclick="@(() => DeleteMember(member.Id))" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted">لا توجد أعضاء مسجلين في الفريق</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade @(showModal ? "show d-block" : "")" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">@(currentMember.Id == 0 ? "إضافة عضو جديد" : "تعديل العضو")</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="@(() => CloseModal())"></button>
            </div>
            <EditForm Model="@currentMember" OnValidSubmit="SaveMember" FormName="memberForm">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">الاسم *</label>
                            <InputText id="name" class="form-control" @bind-Value="currentMember.Name" />
                            <ValidationMessage For="@(() => currentMember.Name)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="jobTitle" class="form-label">الوظيفة *</label>
                            <InputText id="jobTitle" class="form-control" @bind-Value="currentMember.JobTitle" />
                            <ValidationMessage For="@(() => currentMember.JobTitle)" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="taskRole" class="form-label">المهمة/الدور *</label>
                            <InputText id="taskRole" class="form-control" @bind-Value="currentMember.TaskOrRole" />
                            <ValidationMessage For="@(() => currentMember.TaskOrRole)" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label for="notes" class="form-label">الملاحظات</label>
                            <InputTextArea id="notes" class="form-control" rows="3" @bind-Value="currentMember.Notes" />
                            <ValidationMessage For="@(() => currentMember.Notes)" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="@(() => CloseModal())">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private List<ImprovementTeam> teamMembers = new();
    private ImprovementTeam currentMember = new();
    private bool showModal = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamMembers();
    }

    private async Task LoadTeamMembers()
    {
        try
        {
            teamMembers = await ProfessionalDevelopmentService.GetAllTeamMembersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تحميل أعضاء الفريق: {ex.Message}";
        }
    }

    private void OpenAddModal()
    {
        currentMember = new ImprovementTeam();
        showModal = true;
        StateHasChanged();
    }

    private void OpenEditModal(ImprovementTeam member)
    {
        currentMember = new ImprovementTeam
        {
            Id = member.Id,
            Name = member.Name,
            JobTitle = member.JobTitle,
            TaskOrRole = member.TaskOrRole,
            Notes = member.Notes
        };
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        currentMember = new ImprovementTeam();
        StateHasChanged();
    }

    private async Task SaveMember()
    {
        try
        {
            if (currentMember.Id == 0)
            {
                await ProfessionalDevelopmentService.AddTeamMemberAsync(currentMember);
                successMessage = "تم إضافة العضو بنجاح";
            }
            else
            {
                await ProfessionalDevelopmentService.UpdateTeamMemberAsync(currentMember);
                successMessage = "تم تحديث العضو بنجاح";
            }

            await LoadTeamMembers();
            StateHasChanged();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في حفظ العضو: {ex.Message}";
        }
    }

    private async Task DeleteMember(int id)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذا العضو؟");
            if (confirmed)
            {
                await ProfessionalDevelopmentService.DeleteTeamMemberAsync(id);
                successMessage = "تم حذف العضو بنجاح";
                await LoadTeamMembers();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في حذف العضو: {ex.Message}";
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            var csvContent = GenerateCSV();
            var fileName = $"فريق_التحسين_والتطوير_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, csvContent, "text/csv;charset=utf-8;");
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تصدير Excel: {ex.Message}";
        }
    }

    private async Task ExportToPDF()
    {
        try
        {
            var htmlContent = GeneratePDFContent();
            await JSRuntime.InvokeVoidAsync("printToPDF", htmlContent, "فريق التحسين والتطوير");
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تصدير PDF: {ex.Message}";
        }
    }

    private string GenerateCSV()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("\uFEFF"); // BOM for UTF-8
        csv.AppendLine("الاسم,الوظيفة,المهمة/الدور,الملاحظات,تاريخ الإنشاء");
        
        foreach (var member in teamMembers)
        {
            csv.AppendLine($"{member.Name},{member.JobTitle},{member.TaskOrRole},{member.Notes},{member.CreatedAt:yyyy/MM/dd}");
        }
        
        return csv.ToString();
    }

    private string GeneratePDFContent()
    {
        var html = $@"
        <!DOCTYPE html>
        <html dir='rtl' lang='ar'>
        <head>
            <meta charset='utf-8'>
            <title>فريق التحسين والتطوير</title>
            <style>
                body {{ font-family: Arial, sans-serif; margin: 20px; direction: rtl; }}
                .header {{ text-align: center; margin-bottom: 30px; }}
                .header h1 {{ color: #007bff; margin-bottom: 10px; }}
                .header p {{ color: #666; }}
                table {{ width: 100%; border-collapse: collapse; margin-top: 20px; }}
                th, td {{ border: 1px solid #ddd; padding: 8px; text-align: right; }}
                th {{ background-color: #f8f9fa; font-weight: bold; }}
                .text-center {{ text-align: center; }}
                .mt-3 {{ margin-top: 15px; }}
            </style>
        </head>
        <body>
            <div class='header'>
                <h1>فريق التحسين والتطوير</h1>
                <p>تاريخ التقرير: {DateTime.Now:yyyy/MM/dd}</p>
            </div>
            
            <table>
                <thead>
                    <tr>
                        <th>الاسم</th>
                        <th>الوظيفة</th>
                        <th>المهمة/الدور</th>
                        <th>الملاحظات</th>
                        <th>تاريخ الإنشاء</th>
                    </tr>
                </thead>
                <tbody>";

        foreach (var member in teamMembers)
        {
            html += $@"
                    <tr>
                        <td>{member.Name}</td>
                        <td>{member.JobTitle}</td>
                        <td>{member.TaskOrRole}</td>
                        <td>{member.Notes}</td>
                        <td>{member.CreatedAt:yyyy/MM/dd}</td>
                    </tr>";
        }

        html += @"
                </tbody>
            </table>
        </body>
        </html>";

        return html;
    }
}
