        sb.Append("</tr>");
        sb.Append("</thead>");
        sb.Append("<tbody>");
        
        if (notification.Violations.Count > 0)
        {
            foreach (var violation in notification.Violations)
            {
                sb.Append("<tr>");
                sb.Append("<td style='border:1px solid #000;padding:8px;height:80px;vertical-align:top'>");
                sb.Append($"<div style='height:80px;border-bottom:1px dotted #ccc'>{System.Net.WebUtility.HtmlEncode(violation.ViolationDescription).Replace("\n", "<br/>")}</div>");
                sb.Append("</td>");
                sb.Append("<td style='border:1px solid #000;padding:8px;height:80px;vertical-align:top'>");
                sb.Append($"<div style='height:80px;border-bottom:1px dotted #ccc'>{System.Net.WebUtility.HtmlEncode(violation.OtherNotes).Replace("\n", "<br/>")}</div>");
                sb.Append("</td>");
                sb.Append("</tr>");
            }
        }
        else
        {
            sb.Append("<tr>");
            sb.Append("<td style='border:1px solid #000;padding:8px;height:80px;vertical-align:top'>");
            sb.Append("<div style='height:80px;border-bottom:1px dotted #ccc'></div>");
            sb.Append("</td>");
            sb.Append("<td style='border:1px solid #000;padding:8px;height:80px;vertical-align:top'>");
            sb.Append("<div style='height:80px;border-bottom:1px dotted #ccc'></div>");
            sb.Append("</td>");
            sb.Append("</tr>");
        }
        
        sb.Append("</tbody>");
        sb.Append("</table>");

        // Follow-up action text
        sb.Append("<div style='margin:20px 0'>");
        sb.Append("<div style='margin-bottom:10px'>وقد قامت إدارة المدرسة بتوجيه الطالب شفويا وإرشاده إلى عدم تكرار المخالفة.</div>");
        sb.Append("<div style='margin-bottom:10px'>هذا للعلم، واتخاذ ما يلزم بما يحقق مصلحة الطالب من خلال الالتزام بقواعد الانتظام الطلابي والانضباط السلوكي.</div>");
