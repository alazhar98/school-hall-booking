    // Guardian Notification Methods
    private void AddGuardianViolation()
    {
        if (!string.IsNullOrEmpty(currentGuardianViolation.ViolationDescription))
        {
            currentNotification.Violations.Add(new GuardianBehaviorViolation
            {
                ViolationDescription = currentGuardianViolation.ViolationDescription,
                OtherNotes = currentGuardianViolation.OtherNotes
            });
            
            // Clear violation form
            currentGuardianViolation = new GuardianBehaviorViolation();
            StateHasChanged();
        }
    }

    private void RemoveViolation(int index)
    {
        if (index >= 0 && index < currentNotification.Violations.Count)
        {
            currentNotification.Violations.RemoveAt(index);
            StateHasChanged();
        }
    }

    private void AddGuardianNotification()
    {
        if (!string.IsNullOrEmpty(currentNotification.StudentName) && !string.IsNullOrEmpty(currentNotification.StudentClass))
        {
            guardianNotifications.Add(new GuardianNotification
            {
                StudentName = currentNotification.StudentName,
                StudentClass = currentNotification.StudentClass,
                Date = currentNotification.Date,
                Reasons = currentNotification.Reasons,
                Violations = new List<GuardianBehaviorViolation>(currentNotification.Violations),
                OtherNotes = currentNotification.OtherNotes
            });
            
            // Clear form
            currentNotification = new GuardianNotification();
            currentGuardianViolation = new GuardianBehaviorViolation();
            StateHasChanged();
        }
    }

    private void RemoveGuardianNotification(int index)
    {
        if (index >= 0 && index < guardianNotifications.Count)
        {
            guardianNotifications.RemoveAt(index);
            StateHasChanged();
        }
    }

    private async Task SaveGuardianNotification()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(guardianNotifications);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "guardian-notifications", json);
    }

    private async Task LoadGuardianNotification()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "guardian-notifications");
            if (!string.IsNullOrEmpty(json))
            {
                guardianNotifications = System.Text.Json.JsonSerializer.Deserialize<List<GuardianNotification>>(json) ?? new List<GuardianNotification>();
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task PrintGuardianNotification(int notificationIndex)
    {
        var html = CreateGuardianNotificationHTML(notificationIndex);
        await JSRuntime.InvokeVoidAsync("printHTML", html, "إخطار ولي الأمر");
    }

    private string CreateGuardianNotificationHTML(int notificationIndex)
    {
        var notification = guardianNotifications[notificationIndex];
        var sb = new System.Text.StringBuilder();

        sb.Append("<div style='font-family:Arial,sans-serif;direction:rtl;text-align:right;padding:20px;max-width:800px;margin:0 auto'>");
        
