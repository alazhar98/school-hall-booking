        sb.Append("</div>");

        // Introduction
        sb.Append("<div style='margin:20px 0'>");
        sb.Append("<div style='margin-bottom:10px'>السلام عليكم ورحمة الله وبركاته... وبعد...</div>");
        sb.Append("<div style='margin-bottom:10px'>نفيدكم علما بأن إدارة المدرسة قد قامت بتقديم النصح للطالب وذلك بسبب:</div>");
        sb.Append("</div>");

        // Violation details table
        sb.Append("<table style='width:100%;border-collapse:collapse;margin:20px 0'>");
        sb.Append("<thead>");
        sb.Append("<tr style='background:#f8f9fa'>");
        sb.Append("<th style='border:1px solid #000;padding:8px;text-align:center;width:50%'>المخالفة السلوكية</th>");
