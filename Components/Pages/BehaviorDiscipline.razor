    // Student Warning Methods
    private void AddWarning()
    {
        if (!string.IsNullOrEmpty(currentWarning.StudentName) && !string.IsNullOrEmpty(currentWarning.StudentClass))
        {
            studentWarnings.Add(new StudentWarning
            {
                StudentName = currentWarning.StudentName,
                StudentClass = currentWarning.StudentClass,
                Day = currentWarning.Day,
                Date = currentWarning.Date,
                MessageNumber = currentWarning.MessageNumber,
                Reasons = currentWarning.Reasons,
                TeacherName = currentWarning.TeacherName,
                TeacherSignature = currentWarning.TeacherSignature,
                CommitteeReferralDate = currentWarning.CommitteeReferralDate,
                CommitteeActions = currentWarning.CommitteeActions,
                StudentPledge = currentWarning.StudentPledge,
                StudentSignature = currentWarning.StudentSignature,
                OtherNotes = currentWarning.OtherNotes,
                Guidance = currentWarning.Guidance,
                GradeDeduction = currentWarning.GradeDeduction,
                TemporarySuspension = currentWarning.TemporarySuspension,
                Other = currentWarning.Other,
                OtherSpecify = currentWarning.OtherSpecify,
                Violations = new List<WarningViolation>()
            });
            
            // Clear form
            currentWarning = new StudentWarning();
            StateHasChanged();
        }
    }

    private void RemoveWarning(int index)
    {
        if (index >= 0 && index < studentWarnings.Count)
        {
            studentWarnings.RemoveAt(index);
            if (selectedWarningIndex == index)
            {
                selectedWarningIndex = -1;
            }
            else if (selectedWarningIndex > index)
            {
                selectedWarningIndex--;
            }
            StateHasChanged();
        }
    }

    private void SelectWarning(int index)
    {
        selectedWarningIndex = index;
        currentWarningViolation = new WarningViolation();
        StateHasChanged();
    }

    private void AddViolationToWarning(int warningIndex)
    {
        if (warningIndex >= 0 && warningIndex < studentWarnings.Count && 
            !string.IsNullOrEmpty(currentWarningViolation.ViolationDescription))
        {
            studentWarnings[warningIndex].Violations.Add(new WarningViolation
            {
                Day = currentWarningViolation.Day,
                Date = currentWarningViolation.Date,
                Period = currentWarningViolation.Period,
                ViolationDescription = currentWarningViolation.ViolationDescription,
                Guidance = currentWarningViolation.Guidance,
                GradeDeduction = currentWarningViolation.GradeDeduction,
                TemporarySuspension = currentWarningViolation.TemporarySuspension,
                Other = currentWarningViolation.Other,
                OtherSpecify = currentWarningViolation.OtherSpecify
            });

            // Clear violation form
            currentWarningViolation = new WarningViolation();
            StateHasChanged();
        }
    }

    private async Task SaveWarning()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(studentWarnings);
