@page "/academic-achievement/{subject}/initiatives"
@using SchoolHallBooking.Models
@using SchoolHallBooking.Services
@inject IAcademicAchievementService AcademicAchievementService
@inject IJSRuntime JSRuntime
@inject ILogger<AcademicAchievementInitiativesPage> Logger
@rendermode InteractiveServer

<PageTitle>كشف حصر المبادرات والمشاريع - @SubjectName</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">كشف حصر المبادرات والمشاريع الداعمة للتحصيل الدراسي - @SubjectName</h2>
        <div>
            <button class="btn btn-success me-2" @onclick="ExportToPDF">
                <i class="bi bi-file-pdf"></i> PDF
            </button>
            <button class="btn btn-warning me-2" @onclick="ExportToExcel">
                <i class="bi bi-file-excel"></i> Excel
            </button>
            <button class="btn btn-primary" @onclick="@(() => OpenAddModal())">
                <i class="bi bi-plus"></i> إضافة مبادرة/مشروع جديد
            </button>
        </div>
    </div>

    <!-- Initiatives Table -->
    <div class="card">
        <div class="card-body">
            @if (initiatives.Any())
            {
                <div class="table-responsive">
                    <table id="initiatives-table" class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>اسم المشروع/المبادرة</th>
                                <th>المادة</th>
                                <th>الفئة المستهدفة</th>
                                <th>فكرة المشروع</th>
                                <th>أهداف المشروع</th>
                                <th>الخطة الزمنية</th>
                                <th>آلية التنفيذ</th>
                                <th>الرأي الفني</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var initiative in initiatives)
                            {
                                <tr>
                                    <td>@initiative.ProjectName</td>
                                    <td>@initiative.Subject</td>
                                    <td>@initiative.TargetGroup</td>
                                    <td>@(initiative.ProjectIdea?.Length > 50 ? initiative.ProjectIdea.Substring(0, 50) + "..." : initiative.ProjectIdea)</td>
                                    <td>@(initiative.ProjectObjectives?.Length > 50 ? initiative.ProjectObjectives.Substring(0, 50) + "..." : initiative.ProjectObjectives)</td>
                                    <td>@initiative.Timeline</td>
                                    <td>@(initiative.ImplementationMechanism?.Length > 50 ? initiative.ImplementationMechanism.Substring(0, 50) + "..." : initiative.ImplementationMechanism)</td>
                                    <td>@(initiative.TechnicalOpinion?.Length > 50 ? initiative.TechnicalOpinion.Substring(0, 50) + "..." : initiative.TechnicalOpinion)</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="@(() => EditInitiative(initiative))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteInitiative(initiative.Id))">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-lightbulb text-muted" style="font-size: 3rem;"></i>
                    <h5 class="text-muted mt-3">لا توجد مبادرات أو مشاريع مسجلة</h5>
                    <p class="text-muted">اضغط على "إضافة مبادرة/مشروع جديد" لبدء إضافة المبادرات والمشاريع</p>
                </div>
            }
        </div>
    </div>

    <!-- Add/Edit Modal -->
    @if (showModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEditing ? "تعديل المبادرة/المشروع" : "إضافة مبادرة/مشروع جديد")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="currentInitiative" OnValidSubmit="SaveInitiative">
                            <DataAnnotationsValidator />
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="projectName" class="form-label">اسم المشروع/المبادرة *</label>
                                    <InputText id="projectName" class="form-control" @bind-Value="currentInitiative.ProjectName" placeholder="أدخل اسم المشروع أو المبادرة" />
                                    <ValidationMessage For="@(() => currentInitiative.ProjectName)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="subject" class="form-label">المادة *</label>
                                    <InputText id="subject" class="form-control" @bind-Value="currentInitiative.Subject" placeholder="أدخل المادة" />
                                    <ValidationMessage For="@(() => currentInitiative.Subject)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="targetGroup" class="form-label">الفئة المستهدفة *</label>
                                    <InputText id="targetGroup" class="form-control" @bind-Value="currentInitiative.TargetGroup" placeholder="أدخل الفئة المستهدفة" />
                                    <ValidationMessage For="@(() => currentInitiative.TargetGroup)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="timeline" class="form-label">الخطة الزمنية *</label>
                                    <InputText id="timeline" class="form-control" @bind-Value="currentInitiative.Timeline" placeholder="أدخل الخطة الزمنية" />
                                    <ValidationMessage For="@(() => currentInitiative.Timeline)" />
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="projectIdea" class="form-label">فكرة المشروع *</label>
                                    <InputTextArea id="projectIdea" class="form-control" @bind-Value="currentInitiative.ProjectIdea" placeholder="أدخل فكرة المشروع" rows="3" />
                                    <ValidationMessage For="@(() => currentInitiative.ProjectIdea)" />
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="projectObjectives" class="form-label">أهداف المشروع *</label>
                                    <InputTextArea id="projectObjectives" class="form-control" @bind-Value="currentInitiative.ProjectObjectives" placeholder="أدخل أهداف المشروع" rows="3" />
                                    <ValidationMessage For="@(() => currentInitiative.ProjectObjectives)" />
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="implementationMechanism" class="form-label">آلية التنفيذ *</label>
                                    <InputTextArea id="implementationMechanism" class="form-control" @bind-Value="currentInitiative.ImplementationMechanism" placeholder="أدخل آلية التنفيذ" rows="3" />
                                    <ValidationMessage For="@(() => currentInitiative.ImplementationMechanism)" />
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="technicalOpinion" class="form-label">الرأي الفني</label>
                                    <InputTextArea id="technicalOpinion" class="form-control" @bind-Value="currentInitiative.TechnicalOpinion" placeholder="أدخل الرأي الفني" rows="3" />
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="notes" class="form-label">الملاحظات</label>
                                    <InputTextArea id="notes" class="form-control" @bind-Value="currentInitiative.Notes" placeholder="أدخل أي ملاحظات إضافية" rows="3" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">إلغاء</button>
                                <button type="submit" class="btn btn-primary">@(isEditing ? "تحديث" : "حفظ")</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Subject { get; set; } = string.Empty;

    private string SubjectName => Subject switch
    {
        "islamic-education" => "التربية الإسلامية",
        "arabic-language" => "اللغة العربية",
        "english-language" => "اللغة الإنجليزية",
        "mathematics" => "الرياضيات",
        "sciences" => "العلوم",
        "social-studies" => "الدراسات الاجتماعية",
        "management" => "الإدارة",
        _ => "غير محدد"
    };

    private List<AcademicAchievementInitiative> initiatives = new();
    private bool showModal = false;
    private bool isEditing = false;
    private AcademicAchievementInitiative currentInitiative = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadInitiatives();
    }

    private async Task LoadInitiatives()
    {
        try
        {
            initiatives = await AcademicAchievementService.GetInitiativesBySubjectAsync(SubjectName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تحميل المبادرات والمشاريع");
        }
    }

    private void OpenAddModal()
    {
        currentInitiative = new AcademicAchievementInitiative { Subject = string.Empty };
        isEditing = false;
        showModal = true;
    }

    private void EditInitiative(AcademicAchievementInitiative initiative)
    {
        currentInitiative = new AcademicAchievementInitiative
        {
            Id = initiative.Id,
            ProjectName = initiative.ProjectName,
            Subject = initiative.Subject,
            TargetGroup = initiative.TargetGroup,
            ProjectIdea = initiative.ProjectIdea,
            ProjectObjectives = initiative.ProjectObjectives,
            Timeline = initiative.Timeline,
            ImplementationMechanism = initiative.ImplementationMechanism,
            TechnicalOpinion = initiative.TechnicalOpinion,
            Notes = initiative.Notes
        };
        isEditing = true;
        showModal = true;
    }

    private async Task SaveInitiative()
    {
        try
        {
            currentInitiative.Subject = SubjectName; // Set the subject before saving
            
            if (isEditing)
            {
                await AcademicAchievementService.UpdateInitiativeAsync(currentInitiative);
            }
            else
            {
                await AcademicAchievementService.AddInitiativeAsync(currentInitiative);
            }

            await LoadInitiatives();
            CloseModal();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في حفظ المبادرة/المشروع");
        }
    }

    private async Task DeleteInitiative(int id)
    {
        try
        {
            if (await JSRuntime.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذه المبادرة/المشروع؟"))
            {
                await AcademicAchievementService.DeleteInitiativeAsync(id);
                await LoadInitiatives();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في حذف المبادرة/المشروع");
        }
    }

    private async Task PrintInitiative(AcademicAchievementInitiative initiative)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("printElement", $"initiative-{initiative.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في طباعة المبادرة/المشروع");
        }
    }


    private async Task ExportToPDF()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToPDF", "initiatives-table", $"المبادرات_والمشاريع_{SubjectName}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تصدير PDF");
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("exportToExcel", "initiatives-table", $"المبادرات_والمشاريع_{SubjectName}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ في تصدير Excel");
        }
    }

    private void CloseModal()
    {
        showModal = false;
        currentInitiative = new AcademicAchievementInitiative();
        isEditing = false;
    }
}
