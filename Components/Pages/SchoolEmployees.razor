@page "/school/employees"
@using SchoolHallBooking.Services
@using SchoolHallBooking.Models
@using SchoolHallBooking.Data
@using Microsoft.EntityFrameworkCore
@inject IAuthService AuthService
@inject BookingDbContext Context
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>إدارة الموظفين - إدارة المدرسة</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
    </div>
}
else if (currentUser == null)
{
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>غير مصرح لك بالوصول</strong>
                    <br>
                    <small>يجب تسجيل الدخول أولاً للوصول إلى هذه الصفحة</small>
                    <br>
                    <a href="/school/login" class="btn btn-primary btn-sm mt-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        تسجيل الدخول
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-1">
                            <i class="bi bi-people-fill me-2"></i>
                            إدارة الموظفين
                        </h2>
                        <p class="text-muted mb-0">إدارة بيانات الموظفين والصلاحيات</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="AddEmployee">
                            <i class="bi bi-person-plus me-1"></i>
                            إضافة موظف
                        </button>
                        <a href="/school" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-right me-1"></i>
                            العودة
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employees Table -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>
                    قائمة الموظفين (@employees.Count)
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>رقم الموظف</th>
                                <th>الاسم</th>
                                <th>الحالة</th>
                                <th>تاريخ الإنشاء</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in employees)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary">@employee.EmployeeId</span>
                                    </td>
                                    <td class="fw-medium">@employee.Name</td>
                                    <td>
                                        @if (employee.IsActive)
                                        {
                                            <span class="badge bg-success">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">غير نشط</span>
                                        }
                                    </td>
                                    <td class="text-muted">@employee.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button class="btn btn-outline-primary" @onclick="() => EditEmployee(employee)" title="تعديل">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => DeleteEmployee(employee)" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (employees.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-people text-muted" style="font-size: 4rem;"></i>
                <h4 class="text-muted mt-3">لا يوجد موظفين</h4>
                <p class="text-muted">ابدأ بإضافة موظف جديد</p>
                <button class="btn btn-primary" @onclick="AddEmployee">
                    <i class="bi bi-person-plus me-1"></i>
                    إضافة موظف
                </button>
            </div>
        }
    </div>
}

@code {
    private Employee? currentUser;
    private List<Employee> employees = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser != null)
            {
                await LoadEmployees();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadEmployees()
    {
        try
        {
            employees = await Context.Employees
                .OrderBy(e => e.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employees: {ex.Message}");
        }
    }

    private async Task AddEmployee()
    {
        // TODO: Implement add employee functionality
        await JSRuntime.InvokeVoidAsync("alert", "سيتم إضافة هذه الميزة قريباً");
    }

    private async Task EditEmployee(Employee employee)
    {
        // TODO: Implement edit employee functionality
        await JSRuntime.InvokeVoidAsync("alert", $"تعديل الموظف: {employee.Name}");
    }

    private async Task DeleteEmployee(Employee employee)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"هل أنت متأكد من حذف الموظف {employee.Name}؟");
        if (confirmed)
        {
            // TODO: Implement delete employee functionality
            await JSRuntime.InvokeVoidAsync("alert", "سيتم إضافة هذه الميزة قريباً");
        }
    }
}
