    private async Task ExportToPDF()
    {
        try
        {
            switch (currentView)
            {
                case "objectives":
                    await ExportObjectivesToPDF();
                    break;
                case "area-subobjectives":
                    await ExportAreaSubObjectivesToPDF();
                    break;
                case "objective-subobjectives":
                    await ExportObjectiveSubObjectivesToPDF();
                    break;
                case "subobjective-actions":
                    await ExportSubObjectiveToPDF();
                    break;
                default:
                    errorMessage = "لا يمكن تحديد الجدول المطلوب تصديره";
                    break;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير PDF: " + ex.Message;
        }
    }

