    private PlanObjective? selectedObjective;
    private PlanSubObjective? selectedSubObjective;
    private PlanObjective currentObjective = new PlanObjective();
    private PlanSubObjective currentSubObjective = new PlanSubObjective();
    private PlanAction currentAction = new PlanAction();
    private string currentSubObjectiveObjectiveText = string.Empty;
    
    // Enhanced modal variables
