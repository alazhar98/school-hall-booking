                                            <th style='border: none; padding: 15px; text-align: center; font-weight: bold; width: 15%; font-size: 14px;'>المنفذ</th>
                                            <th style='border: none; padding: 15px; text-align: center; font-weight: bold; width: 12%; font-size: 14px;'>الحالة</th>
                                            <th style='border: none; padding: 15px; text-align: center; font-weight: bold; width: 15%; font-size: 14px;'>الملاحظات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                            ";

