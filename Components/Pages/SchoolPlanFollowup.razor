    private string GenerateObjectivesPDFHTML()
    {
        var html = $@"
            <div style='text-align: center; margin-bottom: 40px; padding: 20px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);'>
                <h1 style='color: #2c3e50; font-size: 28px; margin-bottom: 15px; font-weight: bold; text-shadow: 1px 1px 2px rgba(0,0,0,0.1);'>الأهداف الاستراتيجية والإجرائية</h1>
                <div style='border-top: 3px solid #198754; width: 100px; margin: 0 auto 15px;'></div>
                <p style='font-size: 16px; color: #495057; font-weight: 500;'>تاريخ التقرير: {DateTime.Now:yyyy-MM-dd}</p>
                <p style='font-size: 14px; color: #6c757d; margin-top: 5px;'>مدرسة الفضل بن العباس للتعليم الأساسي</p>
            </div>
        ";

        if (!allObjectives.Any())
        {
            html += @"
                <div style='text-align: center; padding: 40px; color: #6c757d; font-style: italic; border: 1px solid #dee2e6; border-radius: 4px;'>
                    لا توجد أهداف مسجلة في النظام
                </div>
            ";
            return html;
        }

        // إنشاء جدول واحد منظم مثل الصفحة
        html += @"
            <table style='width: 100%; border-collapse: collapse; margin: 20px 0; border: 2px solid #198754; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 8px rgba(0,0,0,0.1);'>
                <thead>
                    <tr style='background: linear-gradient(135deg, #198754 0%, #20c997 100%); color: white;'>
                        <th style='border: 1px solid #198754; padding: 15px; text-align: center; font-weight: bold; width: 5%; font-size: 16px;'>م</th>
                        <th style='border: 1px solid #198754; padding: 15px; text-align: center; font-weight: bold; width: 30%; font-size: 16px;'>الهدف الاستراتيجي</th>
                        <th style='border: 1px solid #198754; padding: 15px; text-align: center; font-weight: bold; width: 30%; font-size: 16px;'>المجال</th>
                        <th style='border: 1px solid #198754; padding: 15px; text-align: center; font-weight: bold; width: 35%; font-size: 16px;'>الأهداف الإجرائية</th>
                    </tr>
                </thead>
                <tbody>
        ";

        int rowIndex = 1;
        foreach (var objective in allObjectives.OrderBy(o => o.Objective))
        {
            var activeSubObjectives = objective.SubObjectives.Where(so => so.IsActive).ToList();
            
            if (activeSubObjectives.Any())
            {
                var groupedByArea = activeSubObjectives.GroupBy(so => so.Area).ToList();
                
                foreach (var areaGroup in groupedByArea.OrderBy(g => g.Key))
                {
                    var subObjectivesInArea = areaGroup.OrderBy(so => so.SubObjective).ToList();
                    
                    for (int i = 0; i < subObjectivesInArea.Count; i++)
                    {
                        var subObjective = subObjectivesInArea[i];
                        var rowStyle = i % 2 == 0 ? "background-color: #f8f9fa;" : "background-color: #ffffff;";
                        
                        html += $@"
                            <tr style='{rowStyle}'>
                        ";
                        
                        if (i == 0)
                        {
                            html += $@"
                                <td style='border: 1px solid #dee2e6; padding: 12px; text-align: center; font-weight: bold; color: #495057; vertical-align: top;' rowspan='{subObjectivesInArea.Count}'>{rowIndex}</td>
                                <td style='border: 1px solid #dee2e6; padding: 12px; text-align: right; color: #2c3e50; font-size: 14px; line-height: 1.5; vertical-align: top;' rowspan='{subObjectivesInArea.Count}'>{objective.Objective}</td>
                                <td style='border: 1px solid #dee2e6; padding: 12px; text-align: center; color: #495057; font-weight: 500; vertical-align: top;' rowspan='{subObjectivesInArea.Count}'>{areaGroup.Key}</td>
                            ";
                        }
                        
                        html += $@"
                                <td style='border: 1px solid #dee2e6; padding: 12px; text-align: right; color: #2c3e50; font-size: 14px; line-height: 1.5;'>{subObjective.SubObjective}</td>
                            </tr>
                        ";
                    }
                    rowIndex++;
                }
            }
            else
            {
                html += $@"
                    <tr style='background-color: #fff3cd;'>
                        <td style='border: 1px solid #dee2e6; padding: 12px; text-align: center; font-weight: bold; color: #495057;'>{rowIndex}</td>
                        <td style='border: 1px solid #dee2e6; padding: 12px; text-align: right; color: #2c3e50; font-size: 14px; line-height: 1.5;'>{objective.Objective}</td>
                        <td style='border: 1px solid #dee2e6; padding: 12px; text-align: center; color: #6c757d; font-style: italic;' colspan='2'>لا توجد أهداف إجرائية</td>
                    </tr>
                ";
                rowIndex++;
            }
        }

        html += @"
                </tbody>
            </table>
        ";

        return html;
    }

