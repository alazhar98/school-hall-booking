@page "/school/activity-supervisors"
@using SchoolHallBooking.Services
@using SchoolHallBooking.Models
@using ClosedXML.Excel
@using System.IO
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IActivitySupervisorService ActivitySupervisorService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>مشرفو الأنشطة - نظام حجز القاعات</PageTitle>

@if (isAuthenticated)
{
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3><i class="bi bi-people-fill me-2"></i>مشرفو الأنشطة</h3>
                        <div class="d-flex gap-2">
                            <button class="btn btn-success" @onclick="ExportToExcel">
                                <i class="bi bi-file-excel me-1"></i>تصدير إلى Excel
                            </button>
                            <button class="btn btn-danger" @onclick="ExportToPDF">
                                <i class="bi bi-file-pdf me-1"></i>تصدير إلى PDF
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (isLoading)
                        {
                            <div class="text-center">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">جاري التحميل...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th style="width: 40%;">النشاط</th>
                                            <th style="width: 50%;">المعلمون المشرفون</th>
                                            <th style="width: 10%;" class="text-center">الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var activity in activities)
                                        {
                                            <tr>
                                                <td class="fw-medium">@activity.Name</td>
                                                <td>
                                                    @if (activity.Supervisors.Any())
                                                    {
                                                        <div class="d-flex flex-wrap gap-1">
                                                            @foreach (var supervisor in activity.Supervisors.Where(s => s.IsActive))
                                                            {
                                                                <span class="badge bg-primary">@supervisor.TeacherName</span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">لا يوجد مشرفون</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-primary" @onclick="() => OpenAddSupervisorModal(activity)">
                                                        <i class="bi bi-person-plus"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Supervisor Modal -->
    @if (showAddSupervisorModal)
    {
        <div class="modal show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">إضافة مشرف جديد - @selectedActivity?.Name</h5>
                        <button type="button" class="btn-close" @onclick="CloseAddSupervisorModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="@newSupervisor" OnValidSubmit="AddSupervisor">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger mb-3" />

                            <div class="mb-3">
                                <label for="teacherName" class="form-label">اسم المعلم</label>
                                <InputText id="teacherName" class="form-control" @bind-Value="newSupervisor.TeacherName" placeholder="أدخل اسم المعلم" />
                                <ValidationMessage For="@(() => newSupervisor.TeacherName)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="teacherId" class="form-label">رقم المعلم (اختياري)</label>
                                <InputText id="teacherId" class="form-control" @bind-Value="newSupervisor.TeacherId" placeholder="أدخل رقم المعلم" />
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary" @onclick="CloseAddSupervisorModal">إلغاء</button>
                                <button type="submit" class="btn btn-success" disabled="@isAddingSupervisor">
                                    @if (isAddingSupervisor)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    إضافة المشرف
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }

    <!-- Edit Supervisor Modal -->
    @if (showEditSupervisorModal)
    {
        <div class="modal show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">تعديل بيانات المشرف</h5>
                        <button type="button" class="btn-close" @onclick="CloseEditSupervisorModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="@editSupervisor" OnValidSubmit="UpdateSupervisor">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger mb-3" />

                            <div class="mb-3">
                                <label for="editTeacherName" class="form-label">اسم المعلم</label>
                                <InputText id="editTeacherName" class="form-control" @bind-Value="editSupervisor.TeacherName" placeholder="أدخل اسم المعلم" />
                                <ValidationMessage For="@(() => editSupervisor.TeacherName)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="editTeacherId" class="form-label">رقم المعلم (اختياري)</label>
                                <InputText id="editTeacherId" class="form-control" @bind-Value="editSupervisor.TeacherId" placeholder="أدخل رقم المعلم" />
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary" @onclick="CloseEditSupervisorModal">إلغاء</button>
                                <button type="submit" class="btn btn-primary" disabled="@isEditingSupervisor">
                                    @if (isEditingSupervisor)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    حفظ التغييرات
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }

    <!-- Supervisors List Modal -->
    @if (showSupervisorsListModal)
    {
        <div class="modal show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">مشرفو @selectedActivity?.Name</h5>
                        <button type="button" class="btn-close" @onclick="CloseSupervisorsListModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6>قائمة المشرفين</h6>
                            <button class="btn btn-sm btn-success" @onclick="() => OpenAddSupervisorModal(selectedActivity!)">
                                <i class="bi bi-person-plus me-1"></i>إضافة مشرف
                            </button>
                        </div>
                        
                        @if (activitySupervisors.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>اسم المعلم</th>
                                            <th>رقم المعلم</th>
                                            <th class="text-center">الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var supervisor in activitySupervisors)
                                        {
                                            <tr>
                                                <td>@supervisor.TeacherName</td>
                                                <td>@(supervisor.TeacherId ?? "-")</td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-warning me-1" @onclick="() => EditSupervisor(supervisor)">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteSupervisor(supervisor)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                لا يوجد مشرفون لهذا النشاط.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }
}
else
{
    <div class="container-fluid py-4">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    يجب تسجيل الدخول أولاً للوصول إلى هذه الصفحة.
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isAuthenticated = false;
    private bool isLoading = true;
    private List<Activity> activities = new();
    private List<ActivitySupervisor> activitySupervisors = new();

    // Modal states
    private bool showAddSupervisorModal = false;
    private bool showEditSupervisorModal = false;
    private bool showSupervisorsListModal = false;
    private bool isAddingSupervisor = false;
    private bool isEditingSupervisor = false;

    // Models
    private Activity? selectedActivity;
    private ActivitySupervisor newSupervisor = new();
    private ActivitySupervisor editSupervisor = new();

    // Messages
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/school/login");
            return;
        }

        await LoadActivities();
    }

    private async Task LoadActivities()
    {
        try
        {
            isLoading = true;
            activities = await ActivitySupervisorService.GetAllActivitiesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تحميل البيانات: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddSupervisorModal(Activity activity)
    {
        selectedActivity = activity;
        newSupervisor = new ActivitySupervisor
        {
            ActivityId = activity.Id,
            IsActive = true
        };
        showAddSupervisorModal = true;
    }

    private void CloseAddSupervisorModal()
    {
        showAddSupervisorModal = false;
        newSupervisor = new ActivitySupervisor();
        selectedActivity = null;
    }

    private async Task AddSupervisor()
    {
        try
        {
            isAddingSupervisor = true;
            var result = await ActivitySupervisorService.AddSupervisorAsync(newSupervisor);
            if (result != null)
            {
                successMessage = "تم إضافة المشرف بنجاح.";
                await LoadActivities();
                StateHasChanged();
                CloseAddSupervisorModal();
            }
            else
            {
                errorMessage = "خطأ في إضافة المشرف.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في إضافة المشرف: " + ex.Message;
        }
        finally
        {
            isAddingSupervisor = false;
        }
    }

    private void EditSupervisor(ActivitySupervisor supervisor)
    {
        editSupervisor = new ActivitySupervisor
        {
            Id = supervisor.Id,
            ActivityId = supervisor.ActivityId,
            TeacherName = supervisor.TeacherName,
            TeacherId = supervisor.TeacherId,
            IsActive = supervisor.IsActive
        };
        showEditSupervisorModal = true;
    }

    private void CloseEditSupervisorModal()
    {
        showEditSupervisorModal = false;
        editSupervisor = new ActivitySupervisor();
    }

    private void CloseSupervisorsListModal()
    {
        showSupervisorsListModal = false;
        activitySupervisors.Clear();
        selectedActivity = null;
    }

    private async Task UpdateSupervisor()
    {
        try
        {
            isEditingSupervisor = true;
            var result = await ActivitySupervisorService.UpdateSupervisorAsync(editSupervisor);
            if (result != null)
            {
                successMessage = "تم تحديث بيانات المشرف بنجاح.";
                await LoadActivities();
                StateHasChanged();
                CloseEditSupervisorModal();
            }
            else
            {
                errorMessage = "خطأ في تحديث بيانات المشرف.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تحديث بيانات المشرف: " + ex.Message;
        }
        finally
        {
            isEditingSupervisor = false;
        }
    }

    private async Task DeleteSupervisor(ActivitySupervisor supervisor)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"هل أنت متأكد من حذف المشرف {supervisor.TeacherName}؟");
        if (confirmed)
        {
            try
            {
                var result = await ActivitySupervisorService.DeleteSupervisorAsync(supervisor.Id);
                if (result)
                {
                    successMessage = "تم حذف المشرف بنجاح.";
                    await LoadActivities();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "خطأ في حذف المشرف.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = "خطأ في حذف المشرف: " + ex.Message;
            }
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("مشرفو الأنشطة");
            worksheet.RightToLeft = true;

            // Headers
            worksheet.Cell(1, 1).Value = "النشاط";
            worksheet.Cell(1, 2).Value = "المعلمون المشرفون";
            worksheet.Cell(1, 3).Value = "عدد المشرفين";

            // Style headers
            var headerRange = worksheet.Range(1, 1, 1, 3);
            headerRange.Style.Font.Bold = true;
            headerRange.Style.Fill.BackgroundColor = XLColor.LightBlue;
            headerRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            int row = 2;
            foreach (var activity in activities)
            {
                worksheet.Cell(row, 1).Value = activity.Name;
                
                var supervisors = activity.Supervisors.Where(s => s.IsActive).ToList();
                if (supervisors.Any())
                {
                    var supervisorNames = string.Join(", ", supervisors.Select(s => s.TeacherName));
                    worksheet.Cell(row, 2).Value = supervisorNames;
                    worksheet.Cell(row, 3).Value = supervisors.Count;
                }
                else
                {
                    worksheet.Cell(row, 2).Value = "لا يوجد مشرفون";
                    worksheet.Cell(row, 3).Value = 0;
                }
                
                row++;
            }

            // Auto-fit columns
            worksheet.Columns().AdjustToContents();

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            var content = stream.ToArray();
            var base64 = Convert.ToBase64String(content);
            
            await JSRuntime.InvokeVoidAsync("downloadFile", "مشرفو_الأنشطة.xlsx", base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير Excel: " + ex.Message;
        }
    }

    private async Task ExportToPDF()
    {
        try
        {
            var html = GenerateHTMLReport();
            await JSRuntime.InvokeVoidAsync("downloadHTMLFile", "مشرفو_الأنشطة.html", html);
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير PDF: " + ex.Message;
        }
    }

    private string GenerateHTMLReport()
    {
        var html = $@"
<!DOCTYPE html>
<html lang='ar' dir='rtl'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>مشرفو الأنشطة</title>
    <style>
        body {{
            font-family: 'Arial', sans-serif;
            margin: 20px;
            direction: rtl;
        }}
        .header {{
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #333;
            padding-bottom: 10px;
        }}
        .header h1 {{
            color: #333;
            margin: 0;
        }}
        .header p {{
            color: #666;
            margin: 5px 0 0 0;
        }}
        table {{
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }}
        th, td {{
            border: 1px solid #ddd;
            padding: 12px;
            text-align: right;
        }}
        th {{
            background-color: #f8f9fa;
            font-weight: bold;
            color: #333;
        }}
        tr:nth-child(even) {{
            background-color: #f9f9f9;
        }}
        .supervisor-badge {{
            background-color: #007bff;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            margin: 2px;
            display: inline-block;
            font-size: 12px;
        }}
        .no-supervisors {{
            color: #6c757d;
            font-style: italic;
        }}
        .footer {{
            margin-top: 30px;
            text-align: center;
            color: #666;
            font-size: 12px;
        }}
    </style>
</head>
<body>
    <div class='header'>
        <h1>جدول مشرفو الأنشطة</h1>
        <p>تاريخ التقرير: {DateTime.Now:yyyy/MM/dd}</p>
    </div>
    
    <table>
        <thead>
            <tr>
                <th>النشاط</th>
                <th>المعلمون المشرفون</th>
                <th>عدد المشرفين</th>
            </tr>
        </thead>
        <tbody>";

        foreach (var activity in activities)
        {
            var supervisors = activity.Supervisors.Where(s => s.IsActive).ToList();
            var supervisorNames = supervisors.Any() 
                ? string.Join(", ", supervisors.Select(s => s.TeacherName))
                : "لا يوجد مشرفون";
            
            html += $@"
            <tr>
                <td>{activity.Name}</td>
                <td>{supervisorNames}</td>
                <td>{supervisors.Count}</td>
            </tr>";
        }

        html += @"
        </tbody>
    </table>
    
    <div class='footer'>
        <p>تم إنشاء هذا التقرير تلقائياً من نظام إدارة المدرسة</p>
    </div>
</body>
</html>";

        return html;
    }
}