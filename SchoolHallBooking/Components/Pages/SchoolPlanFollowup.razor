    private async Task ExportObjectiveSubObjectivesToExcel()
    {
        try
        {
            if (selectedObjective == null) return;

            var data = selectedObjective.SubObjectives.Where(so => so.IsActive).Select(so => new
            {
                المجال = so.Area,
                الهدف_الإجرائي = so.SubObjective,
                عدد_الإجراءات = so.Actions.Count(a => a.IsActive),
                تاريخ_الإنشاء = so.CreatedAt.ToString("yyyy-MM-dd")
            }).ToList();

            await JSRuntime.InvokeVoidAsync("exportToExcel", data, $"أهداف_{selectedObjective.Objective}");
            successMessage = "تم تصدير البيانات إلى Excel بنجاح";
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير Excel: " + ex.Message;
        }
    }

    private async Task ExportObjectiveSubObjectivesToPDF()
    {
        try
        {
            if (selectedObjective == null) return;

            var tableRows = string.Join("", selectedObjective.SubObjectives.Where(so => so.IsActive).Select((so, index) => 
                $"<tr><td>{index + 1}</td><td>{so.Area}</td><td>{so.SubObjective}</td><td>{so.Actions.Count(a => a.IsActive)}</td></tr>"));

            var html = $@"
                <html>
                <head>
                    <meta charset='utf-8'>
                    <title>الأهداف الإجرائية</title>
                    <style>
                        body {{ font-family: Arial, sans-serif; direction: rtl; }}
                        table {{ width: 100%; border-collapse: collapse; margin-top: 20px; }}
                        th, td {{ border: 1px solid #ddd; padding: 8px; text-align: center; }}
                        th {{ background-color: #f2f2f2; font-weight: bold; }}
                        .header {{ text-align: center; margin-bottom: 20px; }}
                    </style>
                </head>
                <body>
                    <div class='header'>
                        <h1>الأهداف الإجرائية للهدف: {selectedObjective.Objective}</h1>
                        <p>تاريخ التقرير: {DateTime.Now:yyyy-MM-dd}</p>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>م</th>
                                <th>المجال</th>
                                <th>الأهداف الإجرائية</th>
                                <th>عدد الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            {tableRows}
                        </tbody>
                    </table>
                </body>
                </html>";

            await JSRuntime.InvokeVoidAsync("exportToPDF", html, $"أهداف_{selectedObjective.Objective}");
            successMessage = "تم تصدير البيانات إلى PDF بنجاح";
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير PDF: " + ex.Message;
        }
    }

    private async Task ExportToPDF()
    {
        try
        {
            string tableId = GetCurrentTableId();
            if (string.IsNullOrEmpty(tableId))
            {
                errorMessage = "لا يمكن تحديد الجدول المطلوب تصديره";
                return;
            }

            await JSRuntime.InvokeVoidAsync("exportToPDF", tableId, "متابعة_الخطة_المدرسية");
            successMessage = "تم تصدير البيانات إلى PDF بنجاح";
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير PDF: " + ex.Message;
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            string tableId = GetCurrentTableId();
