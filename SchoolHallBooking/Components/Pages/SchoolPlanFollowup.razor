    private async Task ExportSubObjectiveToExcel()
    {
        try
        {
            if (selectedSubObjective == null) return;

            var data = selectedSubObjective.Actions.Where(a => a.IsActive).Select(a => new
            {
                الإجراء = a.Action,
                المسؤول = a.Executor,
                الفترة_الزمنية = a.TimePeriod,
                الحالة = a.IsExecuted ? "منفذ" : "غير منفذ",
                الملاحظات = a.Notes,
                تاريخ_الإنشاء = a.CreatedAt.ToString("yyyy-MM-dd")
            }).ToList();

            await JSRuntime.InvokeVoidAsync("exportToExcel", data, $"إجراءات_{selectedSubObjective.SubObjective}");
            successMessage = "تم تصدير البيانات إلى Excel بنجاح";
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير Excel: " + ex.Message;
        }
    }

    private async Task ExportSubObjectiveToPDF()
    {
        try
        {
            if (selectedSubObjective == null) return;

            var tableRows = string.Join("", selectedSubObjective.Actions.Where(a => a.IsActive).Select((a, index) => 
                $"<tr><td>{index + 1}</td><td>{a.Action}</td><td>{a.TimePeriod}</td><td>{a.Executor}</td><td>{(a.IsExecuted ? "منفذ" : "غير منفذ")}</td><td>{a.Notes}</td></tr>"));

            var html = $@"
                <html>
                <head>
