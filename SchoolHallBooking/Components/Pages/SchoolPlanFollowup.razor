    {
        try
        {
            var tableRows = string.Join("", areaSubObjectives.Select((so, index) => 
                $"<tr><td>{index + 1}</td><td>{so.SubObjective}</td><td>{so.Actions.Count(a => a.IsActive)}</td></tr>"));

            var html = $@"
                <html>
                <head>
                    <meta charset='utf-8'>
                    <title>أهداف المجال</title>
