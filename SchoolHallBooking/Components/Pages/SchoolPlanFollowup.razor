            successMessage = "تم تصدير البيانات إلى Excel بنجاح";
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في تصدير Excel: " + ex.Message;
        }
    }

    private string GetCurrentTableId()
    {
        return currentView switch
        {
            "objectives" => "objectives-table",
            "area-subobjectives" => "area-subobjectives-table",
            "objective-subobjectives" => "objective-subobjectives-table",
            "subobjective-actions" => "subobjective-actions-table",
            _ => string.Empty
        };
    }
