@page "/school"
@using SchoolHallBooking.Services
@using SchoolHallBooking.Models
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>لوحة التحكم - إدارة المدرسة</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
    </div>
}
else if (!isAuthenticated)
{
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>غير مصرح لك بالوصول</strong>
                    <br>
                    <small>يجب تسجيل الدخول أولاً للوصول إلى هذه الصفحة</small>
                    <br>
                    <a href="/school/login" class="btn btn-primary btn-sm mt-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        تسجيل الدخول
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-1">
                            <i class="bi bi-house-door me-2"></i>
                            لوحة التحكم - إدارة المدرسة
                        </h2>
                        <p class="text-muted mb-0">مرحباً، @currentUser.Name</p>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-primary fs-6">موظف</span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            تسجيل الخروج
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- Management Cards -->
        <div class="row">
            <!-- الإحصائية العامة -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-graph-up text-primary fs-1 mb-3"></i>
                        <h5 class="card-title">الإحصائية العامة</h5>
                        <p class="card-text text-muted">عرض التقارير والإحصائيات</p>
                        <a href="/stats" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- جدول المناوبة -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-calendar-week text-success fs-1 mb-3"></i>
                        <h5 class="card-title">جدول المناوبة</h5>
                        <p class="card-text text-muted">إدارة جدول المناوبة اليومية</p>
                        <a href="/duty-schedule" class="btn btn-outline-success">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- مشرفو الأنشطة -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-people-fill text-info fs-1 mb-3"></i>
                        <h5 class="card-title">مشرفو الأنشطة</h5>
                        <p class="card-text text-muted">إدارة مشرفي الأنشطة المدرسية</p>
                        <a href="/activity-supervisors" class="btn btn-outline-info">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- رواد الفصول -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-person-badge text-warning fs-1 mb-3"></i>
                        <h5 class="card-title">رواد الفصول</h5>
                        <p class="card-text text-muted">إدارة رواد الفصول المدرسية</p>
                        <a href="/class-leaders" class="btn btn-outline-warning">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- الخطة اليومية -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-calendar-day text-danger fs-1 mb-3"></i>
                        <h5 class="card-title">الخطة اليومية</h5>
                        <p class="card-text text-muted">إدارة الخطة اليومية للمدرسة</p>
                        <a href="/daily-plan" class="btn btn-outline-danger">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- متابعة الخطة المدرسية -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-clipboard-check text-secondary fs-1 mb-3"></i>
                        <h5 class="card-title">متابعة الخطة المدرسية</h5>
                        <p class="card-text text-muted">متابعة تنفيذ الخطة المدرسية</p>
                        <a href="/school-plan-followup" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- الزيارات الإشرافية -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-eye text-dark fs-1 mb-3"></i>
                        <h5 class="card-title">الزيارات الإشرافية</h5>
                        <p class="card-text text-muted">إدارة الزيارات الإشرافية</p>
                        <a href="/supervisory-visits" class="btn btn-outline-dark">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- برامج الإنماء المهني -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-mortarboard text-primary fs-1 mb-3"></i>
                        <h5 class="card-title">برامج الإنماء المهني</h5>
                        <p class="card-text text-muted">إدارة برامج الإنماء المهني</p>
                        <a href="/professional-development" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- برامج التحصيل الدراسي -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-trophy text-success fs-1 mb-3"></i>
                        <h5 class="card-title">برامج التحصيل الدراسي</h5>
                        <p class="card-text text-muted">إدارة برامج التحصيل الدراسي</p>
                        <a href="/academic-achievement" class="btn btn-outline-success">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- نظام تطوير الأداء المدرسي -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-graph-up-arrow text-info fs-1 mb-3"></i>
                        <h5 class="card-title">نظام تطوير الأداء المدرسي</h5>
                        <p class="card-text text-muted">إدارة نظام تطوير الأداء المدرسي</p>
                        <a href="/school-performance-development" class="btn btn-outline-info">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- الانضباط السلوكي -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-shield-check text-warning fs-1 mb-3"></i>
                        <h5 class="card-title">الانضباط السلوكي</h5>
                        <p class="card-text text-muted">إدارة الانضباط السلوكي للطلاب</p>
                        <a href="/behavior-discipline" class="btn btn-outline-warning">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- الامتحانات النهائية -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-journal-text text-danger fs-1 mb-3"></i>
                        <h5 class="card-title">الامتحانات النهائية</h5>
                        <p class="card-text text-muted">إدارة الامتحانات النهائية</p>
                        <a href="/final-exams" class="btn btn-outline-danger">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- حضور وانصراف الهيئة التعليمية -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-clock-history text-secondary fs-1 mb-3"></i>
                        <h5 class="card-title">حضور وانصراف الهيئة التعليمية</h5>
                        <p class="card-text text-muted">إدارة حضور وانصراف المعلمين</p>
                        <a href="/teachers-attendance" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>

            <!-- سجلات المتابعة -->
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-journal-bookmark text-dark fs-1 mb-3"></i>
                        <h5 class="card-title">سجلات المتابعة</h5>
                        <p class="card-text text-muted">إدارة سجلات المتابعة المدرسية</p>
                        <a href="/followup-records" class="btn btn-outline-dark">
                            <i class="bi bi-arrow-left me-1"></i>
                            الدخول
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Employee? currentUser;
    private bool isLoading = true;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            await AuthService.LogoutAsync();
            await JSRuntime.InvokeVoidAsync("alert", "تم تسجيل الخروج بنجاح");
            Navigation.NavigateTo("/school/login");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout error: {ex.Message}");
        }
    }
}
