@page "/school/login"
@using SchoolHallBooking.Services
@using SchoolHallBooking.Models
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>تسجيل الدخول - إدارة المدرسة</PageTitle>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0">
                        <i class="bi bi-shield-lock me-2"></i>
                        تسجيل الدخول
                    </h3>
                    <p class="mb-0 mt-2 text-light">إدارة المدرسة</p>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                        <DataAnnotationsValidator />
                        
                        <div class="mb-3">
                            <label for="employeeId" class="form-label fw-bold">
                                <i class="bi bi-person-badge me-1"></i>
                                رقم الموظف
                            </label>
                            <InputText id="employeeId" 
                                      class="@GetInputClass()" 
                                      @bind-Value="loginModel.EmployeeId" 
                                      placeholder="أدخل رقم الموظف" />
                            <ValidationMessage For="@(() => loginModel.EmployeeId)" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label fw-bold">
                                <i class="bi bi-lock me-1"></i>
                                كلمة المرور
                            </label>
                            <InputText id="password" 
                                      type="password"
                                      class="@GetInputClass()" 
                                      @bind-Value="loginModel.Password" 
                                      placeholder="أدخل كلمة المرور" />
                            <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" 
                                    class="btn btn-primary btn-lg" 
                                    disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>جاري تسجيل الدخول...</span>
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-in-right me-2"></i>
                                    <span>تسجيل الدخول</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isValidating = false;

    public class LoginModel
    {
        [Required(ErrorMessage = "رقم الموظف مطلوب")]
        [StringLength(20, ErrorMessage = "رقم الموظف يجب أن يكون أقل من 20 حرف")]
        public string EmployeeId { get; set; } = string.Empty;

        [Required(ErrorMessage = "كلمة المرور مطلوبة")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "كلمة المرور يجب أن تكون بين 3 و 100 حرف")]
        public string Password { get; set; } = string.Empty;
    }

    private string GetInputClass()
    {
        return $"form-control form-control-lg {(isValidating ? "is-valid" : "")}";
    }

    private async Task HandleLogin()
    {
        if (isLoading) return;

        isLoading = true;
        errorMessage = string.Empty;
        isValidating = true;

        try
        {
            var employee = await AuthService.LoginAsync(loginModel.EmployeeId, loginModel.Password);
            
            if (employee != null)
            {
                // Show success message
                await JSRuntime.InvokeVoidAsync("alert", $"مرحباً {employee.Name}! تم تسجيل الدخول بنجاح.");
                
                // Redirect to school dashboard
                Navigation.NavigateTo("/school");
            }
            else
            {
                errorMessage = "رقم الموظف أو كلمة المرور غير صحيحة. يرجى المحاولة مرة أخرى.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "حدث خطأ أثناء تسجيل الدخول. يرجى المحاولة مرة أخرى.";
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            isValidating = false;
        }
    }
}
