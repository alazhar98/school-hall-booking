    private async Task DeleteStudentOpinion(int id)
    { await Service.DeleteStudentOpinionAsync(id); studentOpinions = await Service.GetStudentOpinionsAsync(); await InvokeAsync(StateHasChanged); }

    private async Task SaveStaffOpinion()
    { if (currentStaff.Id == 0) await Service.AddStaffOpinionAsync(currentStaff); else await Service.UpdateStaffOpinionAsync(currentStaff); staffOpinions = await Service.GetStaffOpinionsAsync(); currentStaff = new(); await InvokeAsync(StateHasChanged); }
    private async Task DeleteStaffOpinion(int id)
    { await Service.DeleteStaffOpinionAsync(id); staffOpinions = await Service.GetStaffOpinionsAsync(); await InvokeAsync(StateHasChanged); }

    private async Task SaveParentsOpinion()
    { if (currentParent.Id == 0) await Service.AddParentsOpinionAsync(currentParent); else await Service.UpdateParentsOpinionAsync(currentParent); parentsOpinions = await Service.GetParentsOpinionsAsync(); currentParent = new(); await InvokeAsync(StateHasChanged); }
    private async Task DeleteParentsOpinion(int id)
    { await Service.DeleteParentsOpinionAsync(id); parentsOpinions = await Service.GetParentsOpinionsAsync(); await InvokeAsync(StateHasChanged); }
