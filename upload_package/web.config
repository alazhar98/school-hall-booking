<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Enable static file handling -->
      <staticContent>
        <remove fileExtension=".css" />
        <mimeMap fileExtension=".css" mimeType="text/css" />
        <remove fileExtension=".js" />
        <mimeMap fileExtension=".js" mimeType="application/javascript" />
        <remove fileExtension=".json" />
        <mimeMap fileExtension=".json" mimeType="application/json" />
        <remove fileExtension=".woff" />
        <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
        <remove fileExtension=".woff2" />
        <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
        <remove fileExtension=".png" />
        <mimeMap fileExtension=".png" mimeType="image/png" />
        <remove fileExtension=".jpg" />
        <mimeMap fileExtension=".jpg" mimeType="image/jpeg" />
        <remove fileExtension=".jpeg" />
        <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />
      </staticContent>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SchoolHallBooking.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- Default document -->
      <defaultDocument>
        <files>
          <clear />
          <add value="index.html" />
        </files>
      </defaultDocument>
      <!-- URL Rewrite rules for static files -->
      <rewrite>
        <rules>
          <rule name="StaticFiles" stopProcessing="true">
            <match url="^(css|js|lib|images|uploads)/(.*)$" />
            <action type="Rewrite" url="wwwroot/{R:0}" />
          </rule>
          <rule name="BlazorStaticFiles" stopProcessing="true">
            <match url="^_framework/(.*)$" />
            <action type="Rewrite" url="_framework/{R:1}" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>
</configuration>